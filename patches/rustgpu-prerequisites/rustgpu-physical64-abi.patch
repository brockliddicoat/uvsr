diff --git a/tests/compiletests/ui/physical_storage/layout_baseline.rs b/tests/compiletests/ui/physical_storage/layout_baseline.rs
new file mode 100644
index 0000000..7c93093
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/layout_baseline.rs
@@ -0,0 +1,54 @@
+// build-pass
+// only-vulkan1.3
+// compile-flags: -C target-feature=+Int64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use core::mem::{align_of, offset_of, size_of};
+use spirv_std::spirv;
+
+#[repr(C)]
+pub struct Root {
+    tag: u32,
+    address: u64,
+    value: u32,
+}
+
+#[repr(C)]
+struct Nested {
+    tag: u32,
+    roots: [Root; 2],
+}
+
+const _: () = {
+    assert!(size_of::<u32>() == 4);
+    assert!(size_of::<u64>() == 8);
+    assert!(size_of::<usize>() == 4);
+    assert!(size_of::<*mut u32>() == 4);
+    assert!(align_of::<Root>() == 8);
+    assert!(offset_of!(Root, address) == 8);
+    assert!(offset_of!(Root, value) == 16);
+    assert!(size_of::<Root>() == 24);
+    assert!(offset_of!(Nested, roots) == 8);
+    assert!(size_of::<Nested>() == 56);
+};
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] root: &Root,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u32; 8],
+) {
+    let (sum, carry) = root.value.overflowing_add(1);
+    output[0] = sum;
+    output[1] = carry as u32;
+    output[2] = root.address as u32;
+    output[3] = (root.address >> 32) as u32;
+    output[4] = (root.address as usize) as u32;
+    output[5] = (u64::from(root.value) < root.address) as u32;
+    output[6] = root.value.wrapping_add(1);
+    output[7] = (u64::from(root.value) >> 32) as u32;
+}
