index 7b5f6c5..193528f 100644
--- a/docs/src/inline-asm.md
+++ b/docs/src/inline-asm.md
@@ -71,0 +72,32 @@ pub unsafe fn vector_extract_dynamic<T: Scalar, V: Vector<T>>(vector: V, index:
+
+### Native descriptor-heap declarations
+
+Assembly can declare `OpTypeUntypedPointerKHR` with an explicit storage class.
+Unlike `OpTypePointer`, it has no pointee from which to infer a Rust type.
+Typed and untyped variables follow the same placement rule: Function variables
+go at the beginning of the entry block, and other variables are module globals.
+Constant instructions are emitted at their declaration point in the global
+type/value section. In particular, a constant used by `OpDecorateId` must appear
+before the array or struct it decorates. Write its declaration before that type.
+
+Native resource and sampler heaps use untyped UniformConstant variables with
+the ResourceHeapEXT and SamplerHeapEXT built-ins. Descriptor arrays can use
+`OpConstantSizeOfEXT` and `ArrayStrideIdEXT` rather than assuming a descriptor's
+byte size. Enable `DescriptorHeapEXT`, `UntypedPointersKHR`,
+`ext:SPV_EXT_descriptor_heap` and `ext:SPV_KHR_untyped_pointers` in target features.
+The capability and extension are both required. Inline assembly enum arguments
+use their Rust spellings, for example `Dim2D` for an image dimension.
+
+The `descriptor_heap` source fixtures test a uniform image/sampler lookup,
+explicit-LOD sampling, ordinary Rust vector arithmetic and a physical output,
+including optimized and qptr variants. Missing heap capability or extension is
+diagnosed by validation. These are compile-only fixtures with explicit unsafe
+entry contracts. They are never dispatched with invented resource handles.
+
+No safe heap-access API, bounds checking, resource lifetime or synchronization
+is implied by instruction support. A runtime caller must provide compatible,
+initialized native descriptors and live visible resources, the correct native
+strides, valid output ranges and completion before reuse or retirement. Multiple
+declarations, non-uniform indices, additional stages/resource types and actual
+execution require separate coverage. Malformed assembly syntax can still reach
+existing parser error-recovery limitations.
diff --git a/tests/compiletests/ui/descriptor_heap/auxiliary/sample_body.rs b/tests/compiletests/ui/descriptor_heap/auxiliary/sample_body.rs
new file mode 100644
index 0000000..71da82e
--- /dev/null
+++ b/tests/compiletests/ui/descriptor_heap/auxiliary/sample_body.rs
@@ -0,0 +1,63 @@
+use core::arch::asm;
+use spirv_std::glam::{Vec2, Vec4};
+use spirv_std::{PhysicalPtr, spirv};
+
+/// Compile-only native-heap sample followed by ordinary Rust vector arithmetic.
+///
+/// # Safety
+/// U-004: never dispatch this fixture without establishing all these conditions.
+/// Bind live native resource/sampler heaps. Resource slot 1 contains a valid,
+/// initialized, visible sampled 2D f32 image descriptor, sampler slot 2 contains
+/// a compatible valid sampler. Slot offsets use the native sizes for those
+/// descriptor types. The image is in a sampleable layout with visible contents.
+/// Keep heaps, descriptors, image and sampler live through completion with no
+/// conflicting updates. Output is a nonzero 16-byte-aligned device allocation,
+/// at least 16 bytes, disjoint from all other resources and exclusively writable.
+/// Dispatch one invocation. Establish output visibility and completion before
+/// reading, reusing or retiring it. No synthetic address may be dereferenced.
+#[allow(unsafe_code)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn main(#[spirv(push_constant)] output: &PhysicalPtr<Vec4>) {
+    let coordinates = Vec2::splat(0.5);
+    let mut color = Vec4::ZERO;
+    // SAFETY: U-004. This compile-only entry's contract supplies valid uniform
+    // heap slots and live visible resources. The local output is initialized,
+    // aligned, writable and live throughout the assembly, which falls through
+    // after writing one Vec4. It creates no Rust reference to a descriptor.
+    unsafe {
+        asm!(
+            "%u32 = OpTypeInt 32 0",
+            "%f32 = OpTypeFloat 32",
+            "%one = OpConstant %u32 1",
+            "%two = OpConstant %u32 2",
+            "%lod = OpConstant %f32 0",
+            "%image = OpTypeImage %f32 Dim2D 0 0 0 1 Unknown",
+            "%sampler = OpTypeSampler",
+            "%sampled_image = OpTypeSampledImage %image",
+            "%image_size = OpConstantSizeOfEXT %u32 %image",
+            "%sampler_size = OpConstantSizeOfEXT %u32 %sampler",
+            "%image_array = OpTypeRuntimeArray %image",
+            "%sampler_array = OpTypeRuntimeArray %sampler",
+            "OpDecorateId %image_array ArrayStrideIdEXT %image_size",
+            "OpDecorateId %sampler_array ArrayStrideIdEXT %sampler_size",
+            "%heap_pointer = OpTypeUntypedPointerKHR UniformConstant",
+            "%resources = OpUntypedVariableKHR %heap_pointer UniformConstant",
+            "%samplers = OpUntypedVariableKHR %heap_pointer UniformConstant",
+            "OpDecorate %resources BuiltIn ResourceHeapEXT",
+            "OpDecorate %samplers BuiltIn SamplerHeapEXT",
+            "%image_slot = OpUntypedAccessChainKHR %heap_pointer %image_array %resources %one",
+            "%sampler_slot = OpUntypedAccessChainKHR %heap_pointer %sampler_array %samplers %two",
+            "%texture = OpLoad %image %image_slot",
+            "%filter = OpLoad %sampler %sampler_slot",
+            "%sampled = OpSampledImage %sampled_image %texture %filter",
+            "%coords = OpLoad _ {coordinates}",
+            "%color = OpImageSampleExplicitLod typeof*{color} %sampled %coords Lod %lod",
+            "OpStore {color} %color",
+            coordinates = in(reg) &coordinates,
+            color = in(reg) &mut color,
+        );
+    }
+    // SAFETY: U-004/U-003. The entry contract establishes the complete aligned,
+    // live, exclusive output range and its completion/visibility obligations.
+    unsafe { output.write(color * 2.0) };
+}
