diff --git a/spirv-tools/tests/descriptor_heap.rs b/spirv-tools/tests/descriptor_heap.rs
new file mode 100644
index 0000000..d2d4dc0
--- /dev/null
+++ b/spirv-tools/tests/descriptor_heap.rs
@@ -0,0 +1,87 @@
+//! Non-dispatched native descriptor-heap compatibility regressions.
+#![forbid(unsafe_code)]
+
+use spirv_tools::{TargetEnv, assembler::Assembler, opt::Optimizer, val::Validator};
+
+const SOURCE: &str = include_str!("descriptor_heap.spvasm");
+const REQUIRED: &[&str] = &[
+    "OpCapability DescriptorHeapEXT",
+    "ResourceHeapEXT",
+    "SamplerHeapEXT",
+    "OpUntypedVariableKHR",
+    "OpUntypedAccessChainKHR",
+    "OpConstantSizeOfEXT",
+    "ArrayStrideIdEXT",
+    "OpImageSampleExplicitLod",
+    "Aligned 16",
+];
+
+fn roundtrip<A: Assembler, V: Validator, O: Optimizer>() {
+    let assembler = A::with_env(TargetEnv::Vulkan_1_4);
+    let validator = V::with_env(TargetEnv::Vulkan_1_4);
+    let mut optimizer = O::with_env(TargetEnv::Vulkan_1_4);
+    optimizer.register_performance_passes();
+    let input = assembler.assemble(SOURCE, Default::default()).unwrap();
+    validator.validate(&input, None).unwrap();
+    let optimized = optimizer
+        .optimize(&input, &mut |message| eprintln!("{message:?}"), None)
+        .unwrap();
+    for binary in [&input, &optimized] {
+        validator.validate(binary, None).unwrap();
+        let text = assembler
+            .disassemble(binary, Default::default())
+            .unwrap()
+            .unwrap();
+        for needle in REQUIRED {
+            assert!(text.contains(needle), "missing {needle}:\n{text}");
+        }
+        let reassembled = assembler.assemble(&text, Default::default()).unwrap();
+        validator.validate(&reassembled, None).unwrap();
+    }
+}
+
+fn rejects_missing_capability<A: Assembler, V: Validator>() {
+    let assembler = A::with_env(TargetEnv::Vulkan_1_4);
+    let validator = V::with_env(TargetEnv::Vulkan_1_4);
+    let source = SOURCE.replace("OpCapability DescriptorHeapEXT", "");
+    let binary = assembler.assemble(&source, Default::default()).unwrap();
+    assert!(validator.validate(&binary, None).is_err());
+}
+
+#[cfg(feature = "use-compiled-tools")]
+#[test]
+fn compiled_heap_roundtrip() {
+    roundtrip::<
+        spirv_tools::assembler::compiled::CompiledAssembler,
+        spirv_tools::val::compiled::CompiledValidator,
+        spirv_tools::opt::compiled::CompiledOptimizer,
+    >();
+}
+
+#[cfg(feature = "use-installed-tools")]
+#[test]
+fn installed_heap_roundtrip() {
+    roundtrip::<
+        spirv_tools::assembler::tool::ToolAssembler,
+        spirv_tools::val::tool::ToolValidator,
+        spirv_tools::opt::tool::ToolOptimizer,
+    >();
+}
+
+#[cfg(feature = "use-compiled-tools")]
+#[test]
+fn compiled_heap_requires_capability() {
+    rejects_missing_capability::<
+        spirv_tools::assembler::compiled::CompiledAssembler,
+        spirv_tools::val::compiled::CompiledValidator,
+    >();
+}
+
+#[cfg(feature = "use-installed-tools")]
+#[test]
+fn installed_heap_requires_capability() {
+    rejects_missing_capability::<
+        spirv_tools::assembler::tool::ToolAssembler,
+        spirv_tools::val::tool::ToolValidator,
+    >();
+}
diff --git a/spirv-tools/tests/descriptor_heap.spvasm b/spirv-tools/tests/descriptor_heap.spvasm
