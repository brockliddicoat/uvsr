diff --git a/tests/memory_operands.rs b/tests/memory_operands.rs
new file mode 100644
index 0000000..c10ac38
--- /dev/null
+++ b/tests/memory_operands.rs
@@ -0,0 +1,149 @@
+//! Memory operands must survive actual QPtr lowering, not just raw SPIR-V transport.
+#![forbid(unsafe_code)]
+
+use spirt::{Context, Module, spv};
+use std::rc::Rc;
+
+fn emit(words: &mut Vec<u32>, name: &str, operands: &[u32]) {
+    let opcode = spv::spec::Spec::get().instructions.lookup(name).unwrap();
+    words.push((((operands.len() + 1) as u32) << 16) | u32::from(opcode.as_u16()));
+    words.extend_from_slice(operands);
+}
+
+fn bytes(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|word| word.to_le_bytes()).collect()
+}
+
+fn fixture(load_memory: &[u32], store_memory: &[u32]) -> Vec<u32> {
+    let mut words = vec![0x07230203, 0x00010600, 0, 32, 0];
+    for cap in [1, 11, 5345, 5347] {
+        // Shader, Int64, VulkanMemoryModel, PhysicalStorageBufferAddresses.
+        emit(&mut words, "OpCapability", &[cap]);
+    }
+    emit(&mut words, "OpMemoryModel", &[5348, 3]);
+    emit(&mut words, "OpEntryPoint", &[5, 11, 0x6e69616d, 0, 10]);
+    emit(&mut words, "OpExecutionMode", &[11, 17, 1, 1, 1]);
+    emit(&mut words, "OpTypeVoid", &[1]);
+    emit(&mut words, "OpTypeInt", &[2, 32, 0]);
+    emit(&mut words, "OpTypeInt", &[3, 64, 0]);
+    emit(&mut words, "OpTypeFunction", &[4, 1]);
+    emit(&mut words, "OpTypePointer", &[5, 4, 2]); // Workgroup u32.
+    emit(&mut words, "OpTypePointer", &[6, 5349, 2]); // PhysicalStorageBuffer u32.
+    emit(&mut words, "OpConstant", &[3, 7, 4096, 0]);
+    emit(&mut words, "OpConstant", &[2, 8, 42]);
+    emit(&mut words, "OpConstant", &[2, 9, 2]); // Workgroup scope.
+    emit(&mut words, "OpVariable", &[5, 10, 4]);
+    emit(&mut words, "OpFunction", &[1, 11, 0, 4]);
+    emit(&mut words, "OpLabel", &[12]);
+    emit(&mut words, "OpConvertUToPtr", &[6, 13, 7]);
+    let mut store = vec![10, 8];
+    store.extend_from_slice(store_memory);
+    emit(&mut words, "OpStore", &store);
+    let mut load = vec![2, 14, 10];
+    load.extend_from_slice(load_memory);
+    emit(&mut words, "OpLoad", &load);
+    emit(&mut words, "OpStore", &[13, 14, 2, 4]); // Aligned 4.
+    emit(&mut words, "OpLoad", &[2, 15, 13, 2, 4]);
+    emit(&mut words, "OpReturn", &[]);
+    emit(&mut words, "OpFunctionEnd", &[]);
+    words
+}
+
+fn roundtrip(load_memory: &[u32], store_memory: &[u32], scoped: bool) {
+    let input = fixture(load_memory, store_memory);
+    let mut module = Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&input)).unwrap();
+    let layout = &spirt::qptr::LayoutConfig {
+        abstract_bool_size_align: (1, 1),
+        logical_ptr_size_align: (4, 4),
+        ..spirt::qptr::LayoutConfig::VULKAN_SCALAR_LAYOUT
+    };
+    spirt::passes::qptr::lower_from_spv_ptrs(&mut module, layout);
+    let lowered = spirt::print::Plan::for_module(&module).pretty_print().to_string();
+    assert_eq!(lowered.matches("qptr.load(").count(), 1, "{lowered}");
+    assert_eq!(lowered.matches("qptr.store(").count(), 1, "{lowered}");
+    if scoped {
+        for flag in [
+            "Aligned",
+            "Nontemporal",
+            "MakePointerAvailable",
+            "MakePointerVisible",
+            "NonPrivatePointer",
+        ] {
+            assert!(lowered.contains(flag), "missing {flag}:\n{lowered}");
+        }
+    }
+    spirt::passes::qptr::analyze_uses(&mut module, layout);
+    spirt::passes::qptr::lift_to_spv_ptrs(&mut module, layout);
+    let output = module.lift_to_spv_module_emitter().unwrap().words;
+    let instructions: Vec<_> = spv::read::ModuleParser::read_from_spv_bytes(bytes(&output))
+        .unwrap()
+        .collect::<std::io::Result<_>>()
+        .unwrap();
+    let def = |id| instructions.iter().find(|inst| inst.result_id == Some(id)).unwrap();
+    for (op, expected, data_ids) in [("OpLoad", load_memory, 1), ("OpStore", store_memory, 2)] {
+        let mut logical = 0;
+        let mut physical = 0;
+        for inst in instructions.iter().filter(|inst| inst.without_ids.opcode.name() == op) {
+            let pointer = def(inst.ids[0]);
+            let ty = def(pointer.result_type_id.unwrap());
+            let storage = match ty.without_ids.imms[..] {
+                [spv::Imm::Short(_, sc)] => sc,
+                _ => panic!("expected a pointer storage class"),
+            };
+            let imms: Vec<_> = inst
+                .without_ids
+                .imms
+                .iter()
+                .map(|imm| match *imm {
+                    spv::Imm::Short(_, word) => word,
+                    _ => panic!("unexpected long memory operand"),
+                })
+                .collect();
+            if storage == 5349 {
+                physical += 1;
+                assert_eq!(imms, [2, 4]);
+                assert_eq!(inst.ids.len(), data_ids);
+            } else {
+                logical += 1;
+                assert_eq!(storage, 4);
+                let literal_count = expected.len() - usize::from(scoped);
+                assert_eq!(imms, expected[..literal_count]);
+                assert_eq!(inst.ids.len(), data_ids + usize::from(scoped));
+                if scoped {
+                    let scope = def(*inst.ids.last().unwrap());
+                    assert_eq!(scope.without_ids.opcode.name(), "OpConstant");
+                    assert!(matches!(scope.without_ids.imms[..], [spv::Imm::Short(_, 2)]));
+                }
+            }
+        }
+        assert_eq!((logical, physical), (1, 1));
+    }
+    let again = Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&output)).unwrap();
+    assert_eq!(again.lift_to_spv_module_emitter().unwrap().words, output);
+}
+
+#[test]
+fn absent() {
+    roundtrip(&[], &[], false);
+}
+
+#[test]
+fn explicit_none() {
+    roundtrip(&[0], &[0], false);
+}
+
+#[test]
+fn aligned() {
+    roundtrip(&[2, 4], &[2, 4], false);
+}
+
+#[test]
+fn volatile_and_nontemporal() {
+    roundtrip(&[7, 4], &[7, 4], false);
+}
+
+#[test]
+fn availability_and_visibility_scopes() {
+    // Aligned|Nontemporal|MakePointerVisible/Available|NonPrivatePointer, alignment, scope ID.
+    roundtrip(&[54, 4, 9], &[46, 4, 9], true);
+}
