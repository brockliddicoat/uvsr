+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C target-feature=+UntypedPointersKHR,+DescriptorHeapEXT,+MeshShadingEXT,+ext:SPV_EXT_mesh_shader,+ext:SPV_KHR_untyped_pointers,+ext:SPV_EXT_descriptor_heap
+// compile-flags: -C debuginfo=0 -C llvm-args=--disassemble-entry=meshMain
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// compile-flags: -C opt-level=3 -C lto=off
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+include!("auxiliary/mesh_body.rs");
