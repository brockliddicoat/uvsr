diff --git a/crates/spirv-std/README.md b/crates/spirv-std/README.md
index a775d29..f71d582 100644
--- a/crates/spirv-std/README.md
+++ b/crates/spirv-std/README.md
@@ -74,0 +75,10 @@ support for untested formats, access modes or stages.
+The shared `descriptor_heap/auxiliary/mesh_body.rs` fixture passes an address and
+row-major transform through task payload storage, reads physical vertices in a
+mesh shader and samples native heaps in the fragment stage. Six mesh groups each
+emit one quad with fixed output slots and full-width physical vertex offsets.
+All four default/qptr
+opt0/opt3 variants compile and validate. Focused entry snapshots cover the three
+stages without repeating entire modules. The host must enable task and mesh
+features and satisfy the fixture's unsafe contract. Compiletests alone do not
+establish device execution or general stage/resource support.
+
diff --git a/tests/compiletests/ui/descriptor_heap/auxiliary/mesh_body.rs b/tests/compiletests/ui/descriptor_heap/auxiliary/mesh_body.rs
new file mode 100644
index 0000000..720b75f
--- /dev/null
+++ b/tests/compiletests/ui/descriptor_heap/auxiliary/mesh_body.rs
@@ -0,0 +1,129 @@
+// The row-major vertex/root ABI follows NoGraphicsAPI's cube example at
+// d60b10bdfe15c0f350d6d291d8e06afef3fe7d38, Copyright (c) 2026 Sebastian Aaltonen,
+// MIT licensed. This generic fixture emits six quads from caller-owned vertices.
+use spirv_std::arch::{emit_mesh_tasks_ext_payload, set_mesh_outputs_ext};
+use spirv_std::glam::{UVec3, Vec2, Vec4};
+use spirv_std::{PhysicalPtr, Sampler, image::Image2d, spirv};
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct Vertex {
+    pub position: [f32; 4],
+    pub uv: [f32; 2],
+}
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct Root {
+    pub vertices: PhysicalPtr<Vertex>,
+    pub transform: [[f32; 4]; 4],
+    pub resource: u32,
+    pub sampler: u32,
+}
+
+const _: () = {
+    assert!(core::mem::size_of::<Vertex>() == 24);
+    assert!(core::mem::align_of::<Vertex>() == 4);
+    assert!(core::mem::offset_of!(Vertex, uv) == 16);
+    assert!(core::mem::size_of::<Root>() == 80);
+    assert!(core::mem::align_of::<Root>() == 8);
+    assert!(core::mem::offset_of!(Root, transform) == 8);
+    assert!(core::mem::offset_of!(Root, resource) == 72);
+    assert!(core::mem::offset_of!(Root, sampler) == 76);
+};
+
+/// Copy the root, including its physical address, through task payload storage.
+///
+/// # Safety
+/// Invoke exactly one task group with one invocation and the matching mesh entry.
+/// The root and payload use the asserted ABI. The physical vertex range must
+/// satisfy meshMain's contract until all emitted mesh work has completed.
+#[allow(unsafe_code, non_snake_case)]
+#[spirv(task_ext(threads(1)))]
+pub unsafe fn taskMain(
+    #[spirv(push_constant)] root: &Root,
+    #[spirv(task_payload_workgroup_ext)] payload: &mut Root,
+) {
+    *payload = *root;
+    // SAFETY: U-014. One invocation initializes the entire task payload, then
+    // uniformly emits six child workgroups. This terminates the entry.
+    unsafe { emit_mesh_tasks_ext_payload(6, 1, 1, payload) }
+}
+
+/// Read four physical vertices and emit one quad per mesh workgroup.
+///
+/// # Safety
+/// The matching task entry initializes this payload and emits six groups along X,
+/// each with one invocation. vertices addresses 24 initialized Vertex values in one
+/// live 576-byte allocation, stride 24 and alignment four, with no address wrap.
+/// The finite vertex/transform data are immutable, visible and retained until
+/// completion, disjoint from all writable attachments and pipeline interfaces.
+/// Output arrays have the declared lengths. No Rust reference to GPU memory is
+/// created. The host enables the task/mesh, physical-address and heap features.
+#[allow(unsafe_code, non_snake_case)]
+#[spirv(mesh_ext(
+    threads(1),
+    output_vertices = 4,
+    output_primitives_ext = 2,
+    output_triangles_ext
+))]
+pub unsafe fn meshMain(
+    #[spirv(workgroup_id)] group: UVec3,
+    #[spirv(task_payload_workgroup_ext)] payload: &Root,
+    #[spirv(position)] positions: &mut [Vec4; 4],
+    #[spirv(location = 0)] uvs: &mut [Vec2; 4],
+    #[spirv(primitive_triangle_indices_ext)] indices: &mut [UVec3; 2],
+) {
+    // SAFETY: U-014. All invocations (one) execute this once, before any output
+    // write. Both counts equal the declared output-array bounds.
+    unsafe { set_mesh_outputs_ext(4, 2) };
+    let base = u64::from(group.x) * 4;
+    // Fixed output slots keep this small fixture independent of dynamic mesh
+    // output indexing. Physical vertex selection still uses 64-bit arithmetic.
+    macro_rules! write_vertex {
+        ($slot:literal) => {
+            // SAFETY: U-014/U-003. group.x is 0..6 and each literal is 0..4,
+            // selecting a complete aligned Vertex in the live immutable range.
+            let vertex = unsafe { payload.vertices.wrapping_add(base + $slot).read() };
+            let p = Vec4::from_array(vertex.position);
+            positions[$slot] = Vec4::new(
+                Vec4::from_array(payload.transform[0]).dot(p),
+                Vec4::from_array(payload.transform[1]).dot(p),
+                Vec4::from_array(payload.transform[2]).dot(p),
+                Vec4::from_array(payload.transform[3]).dot(p),
+            );
+            uvs[$slot] = Vec2::from_array(vertex.uv) * 1.5 + Vec2::splat(0.125);
+        };
+    }
+    write_vertex!(0);
+    write_vertex!(1);
+    write_vertex!(2);
+    write_vertex!(3);
+    indices[0] = UVec3::new(0, 1, 2);
+    indices[1] = UVec3::new(2, 3, 0);
+}
+
+/// Sample the native resource/sampler heaps after mesh rasterization.
+///
+/// # Safety
+/// Each selected descriptor is in bounds at its native-size index. The resource
+/// is an initialized sampled float 2D image and the sampler is compatible and
+/// non-comparison. Both are immutable and live until completion. The image is
+/// visible in a sampling-compatible layout and disjoint from the attachments.
+#[allow(unsafe_code, non_snake_case)]
+#[spirv(fragment)]
+pub unsafe fn fragmentMain(
+    #[spirv(push_constant)] root: &Root,
+    #[spirv(location = 0)] uv: Vec2,
+    #[spirv(location = 0)] color: &mut Vec4,
+) {
+    // SAFETY: U-014/U-006. The host establishes the complete native descriptor,
+    // image/sampler compatibility, visibility and retirement contract above.
+    let (image, sampler) = unsafe {
+        (
+            Image2d::from_resource_heap(root.resource),
+            Sampler::from_sampler_heap(root.sampler),
+        )
+    };
+    *color = image.sample(sampler, uv);
+}
