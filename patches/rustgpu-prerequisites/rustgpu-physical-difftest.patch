diff --git a/tests/difftests/tests/physical_storage/operations/cpu/src/main.rs b/tests/difftests/tests/physical_storage/operations/cpu/src/main.rs
new file mode 100644
index 0000000..6d7bd34
--- /dev/null
+++ b/tests/difftests/tests/physical_storage/operations/cpu/src/main.rs
@@ -0,0 +1,41 @@
+#![forbid(unsafe_code)]
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let config = difftest::config::Config::from_path(std::env::args().nth(1).unwrap())?;
+    config.write_metadata(&difftest::config::TestMetadata::raw())?;
+    let mut output = Vec::new();
+    for _variant in 0..4 {
+        for seed in [0_u32, u32::MAX, 0x8000_0001] {
+            let source = [seed, seed ^ 0x55aa_55aa, seed.wrapping_add(19)];
+            let changed = [
+                source[0].wrapping_add(1),
+                source[1].wrapping_add(2),
+                source[2].wrapping_add(3),
+            ];
+            let sum = changed.into_iter().fold(0_u32, u32::wrapping_add);
+            let tag = seed ^ 0xcede_f00d;
+            // The Vulkan variant verifies actual address words before replacing
+            // those nondeterministic fields with zero for this comparison.
+            output.extend_from_slice(&[
+                changed[0],
+                changed[1],
+                changed[2],
+                sum,
+                0,
+                0,
+                tag,
+                0xa5c3_7e19,
+                0,
+                0,
+                source[0],
+                source[1],
+                source[2],
+                tag,
+                0xa5c3_7e19,
+                0xa5c3_7e19,
+            ]);
+        }
+    }
+    config.write_result(&output)?;
+    Ok(())
+}
