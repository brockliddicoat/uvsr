diff --git a/test/opt/eliminate_dead_const_test.cpp b/test/opt/eliminate_dead_const_test.cpp
index ec4c284..e035eb1 100644
--- a/test/opt/eliminate_dead_const_test.cpp
+++ b/test/opt/eliminate_dead_const_test.cpp
@@ -29,0 +30,38 @@ using EliminateDeadConstantBasicTest = PassTest<::testing::Test>;
+TEST_F(EliminateDeadConstantBasicTest, IdDecorationDependencies) {
+  SetTargetEnv(SPV_ENV_VULKAN_1_3);
+  const std::string text = R"(
+; CHECK-NOT: OpName
+; CHECK-NOT: RelaxedPrecision
+; CHECK: OpDecorateId {{%\w+}} ArrayStrideIdEXT %[[STRIDE:\w+]]
+; CHECK: OpMemberDecorateIdEXT {{%\w+}} 0 OffsetIdEXT %[[OFFSET:\w+]]
+; CHECK: %[[STRIDE]] = OpConstantSizeOfEXT
+; CHECK: %[[OFFSET]] = OpSpecConstant
+; CHECK-NOT: OpConstant {{%\w+}} 99
+OpCapability Shader
+OpCapability DescriptorHeapEXT
+OpExtension "SPV_EXT_descriptor_heap"
+OpMemoryModel Logical GLSL450
+OpEntryPoint GLCompute %main "main"
+OpExecutionMode %main LocalSize 1 1 1
+OpName %unused "unused"
+OpDecorate %unused RelaxedPrecision
+OpDecorateId %array ArrayStrideIdEXT %stride
+OpMemberDecorateIdEXT %record 0 OffsetIdEXT %offset
+%void = OpTypeVoid
+%fn = OpTypeFunction %void
+%u32 = OpTypeInt 32 0
+%f32 = OpTypeFloat 32
+%image = OpTypeImage %f32 2D 0 0 0 1 Unknown
+%stride = OpConstantSizeOfEXT %u32 %image
+%offset = OpSpecConstant %u32 0
+%array = OpTypeRuntimeArray %image
+%record = OpTypeStruct %image
+%unused = OpConstant %u32 99
+%main = OpFunction %void None %fn
+%entry = OpLabel
+OpReturn
+OpFunctionEnd
+)";
+  SinglePassRunAndMatch<EliminateDeadConstantPass>(text, true);
+}
