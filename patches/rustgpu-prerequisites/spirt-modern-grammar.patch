@@ -544,0 +547,46 @@ fn get_spec_and_all_ext_inst_sets() {
+#[test]
+fn grammar_aliases_resolve_to_the_same_values() {
+    let spec = Spec::get();
+    for (name, alias) in
+        [("OpSDot", "OpSDotKHR"), ("OpDemoteToHelperInvocation", "OpDemoteToHelperInvocationEXT")]
+    {
+        let opcode = spec.instructions.lookup(name).unwrap();
+        assert!(spec.instructions.lookup(alias) == Some(opcode), "{alias}");
+    }
+    let storage_class = spec.operand_kinds.lookup("StorageClass").unwrap();
+    let OperandKindDef::ValueEnum { variants } = &spec.operand_kinds[storage_class] else {
+        panic!("StorageClass must be a value enum");
+    };
+    assert_eq!(
+        variants.lookup("PhysicalStorageBufferEXT"),
+        Some(variants.lookup("PhysicalStorageBuffer").unwrap()),
+    );
+    let memory_access = spec.operand_kinds.lookup("MemoryAccess").unwrap();
+    let OperandKindDef::BitEnum { bits, .. } = &spec.operand_kinds[memory_access] else {
+        panic!("MemoryAccess must be a bit enum");
+    };
+    assert!(
+        bits.lookup("MakePointerAvailableKHR")
+            == Some(bits.lookup("MakePointerAvailable").unwrap()),
+        "MakePointerAvailableKHR",
+    );
+}
+
+#[test]
+fn grammar_numeric_ranges_and_operand_names() {
+    let spec = Spec::get();
+    let component_type = spec.operand_kinds.lookup("ComponentType").unwrap();
+    let OperandKindDef::ValueEnum { variants } = &spec.operand_kinds[component_type] else {
+        panic!("ComponentType must be a value enum");
+    };
+    assert_eq!(variants.lookup("FloatE5M2NV"), Some(1_000_491_003));
+    assert_eq!(variants.get_named(1_000_491_003).unwrap().0, "FloatE5M2NV");
+    assert!(variants.get(u32::MAX).is_none());
+
+    let prefetch = spec.instructions.lookup("OpUntypedPrefetchKHR").unwrap();
+    assert_eq!(spec.instructions[prefetch].opt_operands.len(), 3);
+    let import = spec.instructions.lookup("OpExtInstImport").unwrap();
+    assert_eq!(spec.instructions[import].req_operands[0].name_and_kind().0, "Name");
+    assert_eq!(sanitize_operand_name(&Some(raw::CowStr::Borrowed("'Name'"))), "Name");
+}
