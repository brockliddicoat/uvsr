diff --git a/crates/spirv-std/src/native_heap.rs b/crates/spirv-std/src/native_heap.rs
new file mode 100644
index 0000000..c8eb265
--- /dev/null
+++ b/crates/spirv-std/src/native_heap.rs
@@ -0,0 +1,123 @@
+//! Native descriptor heap access through the existing opaque resource types.
+//!
+//! These constructors require `DescriptorHeapEXT`, `UntypedPointersKHR`,
+//! `SPV_EXT_descriptor_heap` and `SPV_KHR_untyped_pointers`. Indices count native
+//! descriptors of the requested type, not bytes or application-defined slots.
+//! Access may be divergent. No uniformity decoration or ownership is asserted.
+//! CPU versions panic without accessing memory.
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use crate::Sampler;
+use crate::image::{Image, SampleType};
+#[cfg(target_arch = "spirv")]
+use core::{arch::asm, mem::MaybeUninit};
+
+impl<
+    SampledType: SampleType<FORMAT, COMPONENTS>,
+    const DIM: u32,
+    const DEPTH: u32,
+    const ARRAYED: u32,
+    const MULTISAMPLED: u32,
+    const SAMPLED: u32,
+    const FORMAT: u32,
+    const COMPONENTS: u32,
+> Image<SampledType, DIM, DEPTH, ARRAYED, MULTISAMPLED, SAMPLED, FORMAT, COMPONENTS>
+{
+    /// Load an image descriptor from the bound native resource heap.
+    ///
+    /// Requires `DescriptorHeapEXT`, `UntypedPointersKHR` and their SPIR-V
+    /// extensions. Divergent uses also require the resource's applicable
+    /// non-uniform indexing capability and enabled device feature. This method
+    /// emits no `Uniform` or `UniformId` promise.
+    ///
+    /// The byte offset is `index * OpConstantSizeOfEXT(Self)`. This is not Rust's
+    /// `size_of::<Self>()`. For mixed heaps the caller must supply an index whose
+    /// resulting byte offset identifies the requested descriptor exactly.
+    ///
+    /// # Safety
+    /// The complete descriptor range must be in the bound, live resource heap,
+    /// with the native descriptor alignment, initialized and visible to this
+    /// invocation. It must describe a valid image matching every parameter of
+    /// Self, with supported usage, format and layout for all subsequent accesses.
+    /// The heap, descriptor and image must remain valid through their last use
+    /// and queue completion, without conflicting writes or descriptor updates.
+    /// Subsequent sampling must use a compatible sampler. The caller establishes
+    /// synchronization, aliasing and device/extension requirements. No bounds,
+    /// descriptor type, resource lifetime or uniformity check is performed.
+    #[allow(unsafe_code)]
+    #[crate::macros::gpu_only]
+    #[inline]
+    pub unsafe fn from_resource_heap(index: u32) -> Self {
+        let mut result = MaybeUninit::<Self>::uninit();
+        // SAFETY: U-006. The caller provides a complete valid descriptor at the
+        // native-size offset and keeps the image valid for later use. Assembly
+        // writes one opaque Self to this aligned local slot before assume_init.
+        // Only a pointer to local storage is passed, not a Rust heap reference.
+        unsafe {
+            asm!(
+                "%u32 = OpTypeInt 32 0",
+                "%size = OpConstantSizeOfEXT %u32 typeof*{result}",
+                "%array = OpTypeRuntimeArray typeof*{result}",
+                "OpDecorateId %array ArrayStrideIdEXT %size",
+                "%pointer = OpTypeUntypedPointerKHR UniformConstant",
+                "%heap = OpUntypedVariableKHR %pointer UniformConstant",
+                "OpDecorate %heap BuiltIn ResourceHeapEXT",
+                "%slot = OpUntypedAccessChainKHR %pointer %array %heap {index}",
+                "%value = OpLoad typeof*{result} %slot",
+                "OpStore {result} %value",
+                index = in(reg) index,
+                result = in(reg) result.as_mut_ptr(),
+            );
+            result.assume_init()
+        }
+    }
+}
+
+impl Sampler {
+    /// Load a sampler descriptor from the bound native sampler heap.
+    ///
+    /// Requires `DescriptorHeapEXT`, `UntypedPointersKHR` and their SPIR-V
+    /// extensions. Divergent sampling also requires the applicable non-uniform
+    /// indexing capability and enabled device feature. No uniformity decoration
+    /// is emitted.
+    ///
+    /// The byte offset is `index * OpConstantSizeOfEXT(Sampler)`, not Rust's
+    /// sampler size. Indices may differ between invocations.
+    ///
+    /// # Safety
+    /// The complete descriptor range must be in the bound, live sampler heap at
+    /// the native aligned offset, initialized with a valid sampler and visible
+    /// to this invocation. Keep the heap and descriptor live and unchanged
+    /// through their last use and queue completion. Every subsequent image use
+    /// must be compatible with this sampler's settings. The caller establishes
+    /// synchronization and device/extension requirements. No bounds or lifetime
+    /// check is performed and no ownership or uniformity promise is inferred.
+    #[allow(unsafe_code)]
+    #[crate::macros::gpu_only]
+    #[inline]
+    pub unsafe fn from_sampler_heap(index: u32) -> Self {
+        let mut result = MaybeUninit::<Self>::uninit();
+        // SAFETY: U-006. The caller supplies the complete initialized native
+        // sampler descriptor and its lifetime. Assembly writes exactly one
+        // opaque Sampler into valid local storage before assume_init reads it.
+        unsafe {
+            asm!(
+                "%u32 = OpTypeInt 32 0",
+                "%size = OpConstantSizeOfEXT %u32 typeof*{result}",
+                "%array = OpTypeRuntimeArray typeof*{result}",
+                "OpDecorateId %array ArrayStrideIdEXT %size",
+                "%pointer = OpTypeUntypedPointerKHR UniformConstant",
+                "%heap = OpUntypedVariableKHR %pointer UniformConstant",
+                "OpDecorate %heap BuiltIn SamplerHeapEXT",
+                "%slot = OpUntypedAccessChainKHR %pointer %array %heap {index}",
+                "%value = OpLoad typeof*{result} %slot",
+                "OpStore {result} %value",
+                index = in(reg) index,
+                result = in(reg) result.as_mut_ptr(),
+            );
+            result.assume_init()
+        }
+    }
+}
diff --git a/tests/compiletests/ui/descriptor_heap/auxiliary/library_body.rs b/tests/compiletests/ui/descriptor_heap/auxiliary/library_body.rs
new file mode 100644
index 0000000..0cead18
--- /dev/null
+++ b/tests/compiletests/ui/descriptor_heap/auxiliary/library_body.rs
@@ -0,0 +1,34 @@
+use spirv_std::glam::{UVec3, Vec2, Vec4};
+use spirv_std::{PhysicalPtr, Sampler, image::Image2d, spirv};
+
+/// Compile-only divergent native heap access. Never dispatch synthetic addresses.
+///
+/// # Safety
+/// U-006: dispatch one workgroup of four invocations. The output must be a live,
+/// nonzero 16-byte-aligned device allocation of at least 64 bytes, exclusively
+/// writable, disjoint from the heaps and sampled resources. Resource slots 1/3
+/// and sampler slots 2/3 satisfy the constructors' complete descriptor, image,
+/// sampler, layout and visibility contracts. Each lane owns its 16-byte range.
+/// Keep all resources live without conflicting updates until completion and
+/// establish output visibility before reading or reusing it.
+#[allow(unsafe_code)]
+#[spirv(compute(threads(4)))]
+pub unsafe fn main(
+    #[spirv(push_constant)] output: &PhysicalPtr<Vec4>,
+    #[spirv(local_invocation_id)] local: UVec3,
+) {
+    let lane = local.x;
+    // SAFETY: U-006. The entry contract supplies the two valid sampled-image
+    // slots and compatible samplers for every lane, with complete lifetimes.
+    let (image, sampler) = unsafe {
+        (
+            Image2d::from_resource_heap(1 + 2 * ((lane >> 1) & 1)),
+            Sampler::from_sampler_heap(2 + (lane & 1)),
+        )
+    };
+    let color: Vec4 = image.sample_by_lod(sampler, Vec2::new(1.25, 0.25), 0.0);
+    // SAFETY: U-006/U-003. Four lanes address disjoint aligned 16-byte ranges
+    // within the caller's complete allocation, with visibility/retirement owned
+    // by the caller. No reference to physical storage is manufactured.
+    unsafe { output.wrapping_add(u64::from(lane)).write(color * 2.0) };
+}
diff --git a/tests/compiletests/ui/descriptor_heap/auxiliary/library_mixed_body.rs b/tests/compiletests/ui/descriptor_heap/auxiliary/library_mixed_body.rs
new file mode 100644
index 0000000..35c1250
--- /dev/null
+++ b/tests/compiletests/ui/descriptor_heap/auxiliary/library_mixed_body.rs
@@ -0,0 +1,38 @@
+use spirv_std::glam::{UVec4, Vec2, Vec4};
+use spirv_std::{
+    Sampler,
+    image::{Image2d, Image2dU},
+    spirv,
+};
+
+/// Compile-only repeated and mixed-type native heap constructors.
+///
+/// # Safety
+/// U-006. Resource slots index/index+2 must describe valid visible sampled f32
+/// 2D images, and index+1 a sampled u32 2D image. All index sums must fit u32.
+/// Sampler slots 2/3 must be valid and compatible with every corresponding image
+/// use, including nearest integer sampling. Each constructor's complete lifetime,
+/// bounds, descriptor-type, layout, visibility and aliasing contract applies.
+/// Never dispatch this fixture without establishing those host obligations.
+#[allow(unsafe_code)]
+#[spirv(fragment)]
+pub unsafe fn main(
+    #[spirv(push_constant)] index: &u32,
+    #[spirv(location = 0)] float_color: &mut Vec4,
+    #[spirv(location = 1)] integer_color: &mut UVec4,
+) {
+    // SAFETY: U-006. Each valid native descriptor has the precise image type
+    // and compatible sampler required above, with no conflicting updates.
+    let (first, integers, last, repeat, clamp) = unsafe {
+        (
+            Image2d::from_resource_heap(*index),
+            Image2dU::from_resource_heap(*index + 1),
+            Image2d::from_resource_heap(*index + 2),
+            Sampler::from_sampler_heap(2),
+            Sampler::from_sampler_heap(3),
+        )
+    };
+    let uv = Vec2::new(0.25, 0.25);
+    *float_color = first.sample_by_lod(repeat, uv, 0.0) + last.sample_by_lod(clamp, uv, 0.0);
+    *integer_color = integers.sample_by_lod(repeat, uv, 0.0);
+}
