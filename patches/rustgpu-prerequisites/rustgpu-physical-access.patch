diff --git a/tests/compiletests/ui/physical_storage/access_physical64.rs b/tests/compiletests/ui/physical_storage/access_physical64.rs
new file mode 100644
index 0000000..59d2b36
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/access_physical64.rs
@@ -0,0 +1,37 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use spirv_std::spirv;
+
+/// Compile-only fixture. Do not dispatch synthetic addresses.
+///
+/// # Safety
+/// The caller must provide a live, initialized, four-byte-aligned device
+/// allocation covering one u32 at `address`. It must permit this invocation's
+/// exclusive read/write access, remain live through completion, and be disjoint
+/// from `output` and the push constants. Dispatch exactly one invocation after
+/// establishing device visibility. U-001 owns the boundary and runtime limits.
+#[allow(unsafe_code)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn main(
+    #[spirv(push_constant)] address: &u64,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u32; 2],
+) {
+    let pointer = *address as *mut u32;
+    // SAFETY: U-001. The caller's contract supplies a live, aligned, initialized
+    // u32 with exclusive access and completion-bound lifetime. All u32 bits are valid.
+    let before = unsafe { pointer.read() };
+    output[0] = before;
+    // SAFETY: U-001. The same four-byte allocation is exclusively writable and
+    // does not alias either logical interface. Wrapping arithmetic yields a valid u32.
+    unsafe { pointer.write(before.wrapping_add(7)) };
+    // SAFETY: U-001. This invocation has just initialized the same live allocation.
+    output[1] = unsafe { pointer.read() };
+}
