@@ -0,0 +1,23 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C target-feature=+ext:SPV_KHR_non_semantic_info
+// compile-flags: -C llvm-args=--abort-strategy=debug-printf
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "ui/physical_storage/" -> "$$DIR/"
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+// Aligned pre-link loads/stores must not hide formatting operands from the
+// panic decompiler. Keep both a dynamic argument and an ordinary bounds check.
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] index: &u32,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u32; 1],
+) {
+    assert!(*index < 4, "index {} exceeds four", *index);
+    output[0] = [7, 11, 13, 17][*index as usize];
+}
