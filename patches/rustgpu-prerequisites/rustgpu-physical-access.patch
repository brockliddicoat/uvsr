@@ -3 +3,3 @@ use rspirv::dr::{Block, Function, Instruction, Module, Operand};
-use rspirv::spirv::{AddressingModel, Decoration, ExecutionModel, Op, StorageClass, Word};
+use rspirv::spirv::{
+    AddressingModel, Decoration, ExecutionModel, MemoryAccess, Op, StorageClass, Word,
+};
@@ -12,0 +15,70 @@ mod physical_pointer_tests;
+/// Remove alignment from inferred logical accesses before pointer legalization,
+/// retaining all other memory flags and their operands in their original order.
+pub fn remove_logical_alignment(module: &mut Module) {
+    if !module.memory_model.as_ref().is_some_and(|inst| {
+        inst.operands[0].unwrap_addressing_model() == AddressingModel::PhysicalStorageBuffer64
+    }) {
+        return;
+    }
+    let pointer_types: FxHashMap<_, _> = module
+        .types_global_values
+        .iter()
+        .filter(|inst| {
+            matches!(
+                inst.class.opcode,
+                Op::TypePointer | Op::TypeUntypedPointerKHR
+            )
+        })
+        .map(|inst| {
+            (
+                inst.result_id.unwrap(),
+                inst.operands[0].unwrap_storage_class(),
+            )
+        })
+        .collect();
+    let pointer_values: FxHashMap<_, _> = module
+        .all_inst_iter()
+        .filter_map(|inst| Some((inst.result_id?, *pointer_types.get(&inst.result_type?)?)))
+        .collect();
+    for inst in module
+        .functions
+        .iter_mut()
+        .flat_map(|f| f.blocks.iter_mut().flat_map(|b| b.instructions.iter_mut()))
+    {
+        let mask_index = match inst.class.opcode {
+            Op::Load => 1,
+            Op::Store => 2,
+            _ => continue,
+        };
+        let Some(Operand::MemoryAccess(mask)) = inst.operands.get(mask_index) else {
+            continue;
+        };
+        let mask = *mask;
+        if !mask.contains(MemoryAccess::ALIGNED)
+            || !matches!(
+                inst.operands.get(mask_index + 1),
+                Some(Operand::LiteralBit32(_))
+            )
+            || !pointer_values
+                .get(&inst.operands[0].unwrap_id_ref())
+                .is_some_and(|sc| {
+                    !matches!(
+                        sc,
+                        StorageClass::PhysicalStorageBuffer | StorageClass::Generic
+                    )
+                })
+        {
+            continue;
+        }
+        // Aligned is the first bit carrying a payload, so its literal precedes
+        // any availability/visibility scope IDs or alias-scope IDs.
+        inst.operands.remove(mask_index + 1);
+        let remaining = mask & !MemoryAccess::ALIGNED;
+        if remaining.is_empty() {
+            inst.operands.remove(mask_index);
+        } else {
+            inst.operands[mask_index] = Operand::MemoryAccess(remaining);
+        }
+    }
+}
+
