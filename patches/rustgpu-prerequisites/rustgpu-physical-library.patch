@@ -0,0 +1,55 @@
+// build-pass
+// only-vulkan1.3
+// compile-flags: -C target-feature=+Int64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use core::mem::{align_of, offset_of, size_of};
+use spirv_std::{PhysicalPtr, spirv};
+
+#[repr(C)]
+pub struct Root {
+    pointer: PhysicalPtr<u32>,
+    count: u64,
+}
+
+#[repr(C)]
+struct Nested {
+    tag: u32,
+    pointers: [PhysicalPtr<u32>; 2],
+}
+
+const _: () = {
+    assert!(size_of::<PhysicalPtr<u32>>() == 8);
+    assert!(align_of::<PhysicalPtr<u32>>() == 8);
+    assert!(offset_of!(Root, count) == 8);
+    assert!(size_of::<Root>() == 16);
+    assert!(offset_of!(Nested, pointers) == 8);
+    assert!(size_of::<Nested>() == 24);
+    assert!(
+        PhysicalPtr::<u32>::from_address(u64::MAX - 3)
+            .wrapping_add(1)
+            .is_null()
+    );
+    assert!(
+        PhysicalPtr::<u32>::from_address(4)
+            .wrapping_offset(-1)
+            .is_null()
+    );
+};
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] root: &Root,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 5],
+) {
+    output[0] = root.pointer.wrapping_add(root.count).address();
+    output[1] = root.pointer.wrapping_sub(root.count).address();
+    output[2] = root.pointer.wrapping_offset(root.count as i64).address();
+    output[3] = root.pointer.cast::<u8>().address();
+    output[4] = root.pointer.is_null() as u64;
+}
