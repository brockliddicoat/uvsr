diff --git a/tests/compiletests/ui/physical_storage/library_aggregate_physical64.rs b/tests/compiletests/ui/physical_storage/library_aggregate_physical64.rs
new file mode 100644
index 0000000..296602c
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/library_aggregate_physical64.rs
@@ -0,0 +1,36 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use spirv_std::{PhysicalPtr, spirv};
+
+#[repr(C)]
+pub struct Root {
+    source: PhysicalPtr<[u32; 3]>,
+    destination: PhysicalPtr<[u32; 3]>,
+}
+
+/// Compile-only aggregate fixture. Never dispatch synthetic addresses.
+///
+/// # Safety
+/// Both nonzero addresses name disjoint live 12-byte allocations aligned to four.
+/// Source contains a visible initialized [u32; 3]. Destination is exclusively
+/// writable. No concurrent accesses or incompatible reference aliases exist.
+/// Dispatch one invocation and keep allocations live through completion. U-003
+/// owns this compile-only boundary. No runtime aggregate proof is claimed.
+#[allow(unsafe_code)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn main(#[spirv(push_constant)] root: &Root) {
+    // SAFETY: U-003. The complete initialized source array is live, aligned and
+    // visible. Every u32 representation is valid and the array is Copy.
+    let value = unsafe { root.source.read() };
+    // SAFETY: U-003. The disjoint destination covers all 12 bytes and is live,
+    // aligned and exclusively writable through this invocation's completion.
+    unsafe { root.destination.write(value) };
+}
