@@ -233,0 +234,81 @@ fn volatile_memory_operands_qptr() {
+
+fn check_aligned_copies(qptr: bool) {
+    let source = r#"
+OpCapability Shader
+OpCapability Int64
+OpCapability PhysicalStorageBufferAddresses
+OpCapability VulkanMemoryModel
+OpMemoryModel PhysicalStorageBuffer64 Vulkan
+OpEntryPoint GLCompute %main "main"
+OpExecutionMode %main LocalSize 1 1 1
+OpDecorate %array ArrayStride 4
+%void = OpTypeVoid
+%u32 = OpTypeInt 32 0
+%u64 = OpTypeInt 64 0
+%three = OpConstant %u32 3
+%array = OpTypeArray %u32 %three
+%source_address = OpConstant %u64 4096
+%destination_address = OpConstant %u64 8192
+%physical = OpTypePointer PhysicalStorageBuffer %array
+%local = OpTypePointer Function %array
+%main_type = OpTypeFunction %void
+%main = OpFunction %void None %main_type
+%entry = OpLabel
+%temporary = OpVariable %local Function
+%source = OpConvertUToPtr %physical %source_address
+%destination = OpConvertUToPtr %physical %destination_address
+OpCopyMemory %temporary %source Aligned 4
+OpCopyMemory %destination %temporary Aligned 4
+OpReturn
+OpFunctionEnd
+"#;
+    let binary = assemble_spirv(source);
+    let module = link_with_linker_opts(
+        &[&binary],
+        &crate::linker::Options {
+            infer_storage_classes: true,
+            structurize: true,
+            spirt_passes: if qptr { vec!["qptr".into()] } else { vec![] },
+            ..Default::default()
+        },
+    )
+    .expect("aligned aggregate copies must survive linking");
+    validate(&module.assemble());
+    for (op, mask_index) in [(Op::Load, 1), (Op::Store, 2)] {
+        let instructions: Vec<_> = module
+            .all_inst_iter()
+            .filter(|inst| inst.class.opcode == op)
+            .collect();
+        assert_eq!(instructions.len(), 1, "{}", module.disassemble());
+        assert_eq!(
+            &instructions[0].operands[mask_index..],
+            &[
+                Operand::MemoryAccess(MemoryAccess::ALIGNED),
+                Operand::LiteralBit32(4)
+            ],
+            "{}",
+            module.disassemble()
+        );
+    }
+    assert!(
+        module
+            .all_inst_iter()
+            .all(|inst| inst.class.opcode != Op::CopyMemory)
+    );
+    let mut optimizer = spirv_tools::opt::create(None);
+    optimizer.register_performance_passes();
+    let optimized = optimizer
+        .optimize(module.assemble(), &mut |_| {}, None)
+        .unwrap();
+    validate(optimized.as_words());
+}
+
+#[test]
+fn aligned_aggregate_copies() {
+    check_aligned_copies(false);
+}
+
+#[test]
+fn aligned_aggregate_copies_qptr() {
+    check_aligned_copies(true);
+}
