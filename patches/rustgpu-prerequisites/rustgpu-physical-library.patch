diff --git a/crates/spirv-std/src/physical_ptr.rs b/crates/spirv-std/src/physical_ptr.rs
new file mode 100644
index 0000000..344f5d9
--- /dev/null
+++ b/crates/spirv-std/src/physical_ptr.rs
@@ -0,0 +1,157 @@
+//! Explicit 64-bit device-address transport and physical-memory access.
+//!
+//! Address operations are safe and available on host and shader targets. Memory
+//! access is unsafe and requires a Vulkan `-physical64` shader target. No method
+//! establishes allocation validity, alias restrictions or synchronization.
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use core::{marker::PhantomData, mem::size_of};
+
+/// A typed device address with the representation and alignment of `u64`.
+///
+/// This value does not own or borrow an allocation. Copying or casting it only
+/// transports its bits. Zero and invalid addresses may be represented safely,
+/// but must not be used for memory access. The pointee must be sized.
+///
+/// Host-shader layouts must agree on `T` separately. In particular, types
+/// containing native pointers or `usize` do not have a portable pointee layout.
+/// This type provides no `Deref`, reference constructor, restriction marker,
+/// atomic access, volatile access or allocation-dependent pointer method.
+#[repr(transparent)]
+pub struct PhysicalPtr<T> {
+    address: u64,
+    // The marker records the pointee without owning T or imposing its auto
+    // traits on address-only transport. No T value is constructed here.
+    pointee: PhantomData<fn() -> T>,
+}
+
+impl<T> Copy for PhysicalPtr<T> {}
+
+impl<T> Clone for PhysicalPtr<T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<T> PartialEq for PhysicalPtr<T> {
+    fn eq(&self, other: &Self) -> bool {
+        self.address == other.address
+    }
+}
+
+impl<T> Eq for PhysicalPtr<T> {}
+
+impl<T> PhysicalPtr<T> {
+    /// Transport an address without validating or accessing an allocation.
+    #[inline]
+    pub const fn from_address(address: u64) -> Self {
+        Self {
+            address,
+            pointee: PhantomData,
+        }
+    }
+
+    /// Return the complete address bits, independently of the target's usize.
+    #[inline]
+    pub const fn address(self) -> u64 {
+        self.address
+    }
+
+    /// Test the zero address without converting it to a typed Rust pointer.
+    #[inline]
+    pub const fn is_null(self) -> bool {
+        self.address == 0
+    }
+
+    /// Change the pointee type without accessing memory or changing the address.
+    /// The caller of a later memory access must establish the new type's layout,
+    /// alignment and value-validity requirements.
+    #[inline]
+    pub const fn cast<U>(self) -> PhysicalPtr<U> {
+        PhysicalPtr::from_address(self.address)
+    }
+
+    /// Add an element count using arithmetic modulo 2^64.
+    /// This does not make the resulting address valid for memory access.
+    #[inline]
+    pub const fn wrapping_add(self, count: u64) -> Self {
+        Self::from_address(
+            self.address
+                .wrapping_add(count.wrapping_mul(size_of::<T>() as u64)),
+        )
+    }
+
+    /// Subtract an element count using arithmetic modulo 2^64.
+    /// This does not make the resulting address valid for memory access.
+    #[inline]
+    pub const fn wrapping_sub(self, count: u64) -> Self {
+        Self::from_address(
+            self.address
+                .wrapping_sub(count.wrapping_mul(size_of::<T>() as u64)),
+        )
+    }
+
+    /// Offset by a signed element count using arithmetic modulo 2^64.
+    /// Counts are explicit i64 values rather than a target-dependent isize.
+    #[inline]
+    pub const fn wrapping_offset(self, count: i64) -> Self {
+        self.wrapping_add(count as u64)
+    }
+}
+
+// On ordinary 32-bit SPIR-V targets the methods are absent, so a use gets a
+// source-level diagnostic instead of silently truncating an address. On host
+// targets gpu_only provides the standard panic stub, never a CPU dereference.
+#[cfg(any(not(target_arch = "spirv"), target_pointer_width = "64"))]
+impl<T: Copy> PhysicalPtr<T> {
+    /// Read a value from physical device memory.
+    ///
+    /// Requires a Vulkan `-physical64` shader target and its emitted capabilities.
+    /// On CPU platforms this method panics without accessing the address.
+    ///
+    /// # Safety
+    /// The address must be nonzero, including when T has zero size.
+    /// The complete `size_of::<T>()` range must belong to a live device allocation
+    /// with the shader's layout and `align_of::<T>()` alignment. It must contain
+    /// an initialized, valid T value whose initialization is visible to this
+    /// invocation. The allocation and any resources/lifetimes represented by T
+    /// must remain valid through their last use and queue completion. There must
+    /// be no conflicting concurrent write or incompatible Rust reference alias.
+    /// This operation creates no Rust reference and establishes no visibility.
+    #[allow(unsafe_code)]
+    #[spirv_std_macros::gpu_only]
+    #[inline]
+    pub unsafe fn read(self) -> T {
+        // SAFETY: U-003. The caller establishes the complete aligned, initialized,
+        // live range and non-conflicting access described above. T: Copy avoids
+        // duplicating ownership of a non-Copy value. No reference is fabricated.
+        unsafe { (self.address as *const T).read() }
+    }
+
+    /// Write a value to physical device memory without reading the old value.
+    ///
+    /// Requires a Vulkan `-physical64` shader target and its emitted capabilities.
+    /// On CPU platforms this method panics without accessing the address.
+    ///
+    /// # Safety
+    /// The address must be nonzero, including when T has zero size.
+    /// The complete `size_of::<T>()` range must belong to a live device allocation
+    /// with the shader's layout and `align_of::<T>()` alignment. This invocation
+    /// must have exclusive write access, with no concurrent reader/writer or
+    /// incompatible Rust reference alias. The allocation and any resources or
+    /// lifetimes represented by value must remain valid until their last use and
+    /// queue completion. Consumers need explicit synchronization and visibility
+    /// before reading, reusing or retiring the allocation. The old bytes need
+    /// not contain an initialized T. This operation creates no Rust reference.
+    #[allow(unsafe_code)]
+    #[spirv_std_macros::gpu_only]
+    #[inline]
+    pub unsafe fn write(self, value: T) {
+        // SAFETY: U-003. The caller supplies a complete aligned, exclusively writable
+        // live range with T's shader layout. The typed value is initialized and
+        // T: Copy has no destructor. Visibility and retirement remain external.
+        unsafe { (self.address as *mut T).write(value) };
+    }
+}
diff --git a/crates/spirv-std/tests/physical_ptr.rs b/crates/spirv-std/tests/physical_ptr.rs
new file mode 100644
index 0000000..6111d4f
--- /dev/null
+++ b/crates/spirv-std/tests/physical_ptr.rs
@@ -0,0 +1,71 @@
+#![forbid(unsafe_code)]
+
+use core::mem::{align_of, offset_of, size_of};
+use spirv_std::PhysicalPtr;
+
+#[repr(C)]
+struct Root {
+    tag: u32,
+    pointers: [PhysicalPtr<u32>; 2],
+    count: u32,
+}
+
+#[test]
+fn physical_ptr_layout_and_non_owning_copy() {
+    struct NotCopy;
+    let pointer = PhysicalPtr::<NotCopy>::from_address(0xfedc_ba98_7654_3210);
+    let copied = pointer;
+    assert_eq!(pointer.address(), copied.address());
+    assert_eq!(size_of::<PhysicalPtr<NotCopy>>(), 8);
+    assert_eq!(align_of::<PhysicalPtr<NotCopy>>(), align_of::<u64>());
+    assert_eq!(offset_of!(Root, pointers), 8);
+    assert_eq!(offset_of!(Root, count), 24);
+    assert_eq!(size_of::<Root>(), 32);
+    assert_eq!(size_of::<[PhysicalPtr<u32>; 2]>(), 16);
+}
+
+#[test]
+fn physical_ptr_address_cast_and_null() {
+    for address in [0, 1, 4096, 1 << 63, u64::MAX] {
+        let pointer = PhysicalPtr::<u32>::from_address(address);
+        assert_eq!(pointer.is_null(), address == 0);
+        assert_eq!(pointer.cast::<u8>().address(), address);
+        assert!(pointer == PhysicalPtr::from_address(address));
+        assert!(pointer != PhysicalPtr::from_address(address.wrapping_add(1)));
+    }
+}
+
+#[test]
+fn physical_ptr_wrapping_matches_wide_integer_reference() {
+    for address in [0, 1, 4096, 1 << 63, u64::MAX - 3, u64::MAX] {
+        let pointer = PhysicalPtr::<u32>::from_address(address);
+        for count in [0, 1, 2, u64::MAX] {
+            let byte_count = u128::from(count) * 4;
+            assert_eq!(
+                pointer.wrapping_add(count).address(),
+                (u128::from(address) + byte_count) as u64
+            );
+            assert_eq!(
+                pointer.wrapping_sub(count).address(),
+                u128::from(address).wrapping_sub(byte_count) as u64
+            );
+        }
+        for count in [i64::MIN, -1024, -1, 0, 1, i64::MAX] {
+            let expected = (i128::from(address) + i128::from(count) * 4) as u64;
+            assert_eq!(pointer.wrapping_offset(count).address(), expected);
+        }
+    }
+}
+
+#[test]
+fn physical_ptr_stride_follows_pointee_layout() {
+    let pointer = PhysicalPtr::<[u32; 3]>::from_address(0x1000);
+    assert_eq!(pointer.wrapping_add(2).address(), 0x1018);
+    assert_eq!(pointer.cast::<u8>().wrapping_add(2).address(), 0x1002);
+    assert_eq!(
+        PhysicalPtr::<()>::from_address(0x1000)
+            .wrapping_add(u64::MAX)
+            .address(),
+        0x1000
+    );
+}
diff --git a/docs/src/platform-support.md b/docs/src/platform-support.md
index 163f875..ffd01ae 100644
--- a/docs/src/platform-support.md
+++ b/docs/src/platform-support.md
@@ -98 +98,2 @@ The current operation evidence is deliberately narrower than `*mut` parity:
-| other pointer casts, aggregate accesses, volatile intrinsics, copies, atomics, references and allocation-dependent methods | require separate lowering, diagnostics and execution evidence |
+| whole typed aggregate copies with alignment only | the `[u32; 3]` fixture emits aligned physical load/store instructions, including through qptr and optimization |
+| other pointer casts, volatile intrinsics, effectful/scoped copies, atomics, references and allocation-dependent methods | require separate lowering, diagnostics and execution evidence |
@@ -102,2 +103 @@ GPU behavior or the allocation, aliasing and lifetime obligations of in-bounds
-methods. This experimental support does not yet provide a physical-memory
-access API. Formatted u32 panic arguments are tested
+methods. Formatted u32 panic arguments are tested
@@ -106,0 +107,32 @@ so 64-bit usize bounds diagnostics retain explicit unprintable placeholders.
+#### explicit device-address library
+
+`spirv_std::PhysicalPtr<T>` is a transparent `u64` address with a non-owning
+pointee marker. It neither owns nor borrows a device allocation. Construction,
+address extraction, equality, null tests, casts and wrapping element arithmetic
+are safe address transport. Counts use explicit `u64` or `i64`, independent of
+the shader's pointer width. Arithmetic wraps modulo 2^64 and does not establish
+allocation validity. The element stride follows the target's `T` layout.
+
+For example, `PhysicalPtr::<u32>::from_address(address).wrapping_add(2)`
+transports `address + 8` modulo 2^64. It performs no load or store. A root field
+has the size/alignment of `u64`, including when nested in structs and arrays.
+The host and shader must separately agree on pointee layout. Native pointers
+or `usize` inside `T` are not portable across target ABIs.
+
+`read` and `write` require `T: Copy` and are unsafe. They exist on Vulkan
+`-physical64` shaders and use the ordinary `gpu_only` panic stub on CPU targets.
+They are absent on ordinary 32-bit shader targets. Every access requires a
+nonzero address, even for zero-sized values, a live complete aligned range,
+valid initialized read values, compatible aliases and no conflicting access.
+The caller owns initialization visibility, synchronization, completion and
+retirement, including any resources or lifetimes represented by `T`.
+The method documentation states each obligation. No Rust reference is created.
+
+The library exposes no `Deref`, safe memory access, restriction marker, raw
+pointer escape, reference constructor, copy-range, volatile or atomic API.
+It does not imply all `Copy` types compile. Source fixtures cover u32 access,
+an aligned `[u32; 3]` copy and rejection on the ordinary shader target. Native
+tests cover transport, nested layout and wrapping against wide-integer
+references. Compiletests do not dispatch these fixtures or establish GPU
+soundness, aggregate runtime behavior or complete `*mut` parity.
+
diff --git a/tests/compiletests/ui/physical_storage/library_access_physical64.rs b/tests/compiletests/ui/physical_storage/library_access_physical64.rs
new file mode 100644
index 0000000..4a794b1
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/library_access_physical64.rs
@@ -0,0 +1,35 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![deny(unsafe_code)]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use spirv_std::{PhysicalPtr, spirv};
+
+/// Compile-only fixture. Never dispatch synthetic addresses.
+///
+/// # Safety
+/// The caller supplies a real nonzero address to one live, four-byte-aligned,
+/// initialized u32 with exclusive read/write access through queue completion.
+/// It is disjoint from both logical interfaces. Dispatch one invocation after
+/// initialization visibility. U-003 records the compile-only consumer boundary.
+#[allow(unsafe_code)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn main(
+    #[spirv(push_constant)] address: &u64,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u32; 2],
+) {
+    let pointer = PhysicalPtr::<u32>::from_address(*address);
+    // SAFETY: U-003. The entry contract supplies one live, aligned, initialized
+    // and visible u32 with exclusive access, separate from the logical output.
+    output[0] = unsafe { pointer.read() };
+    // SAFETY: U-003. The same complete range is exclusively writable. The new
+    // u32 value is valid and the allocation remains live through completion.
+    unsafe { pointer.write(output[0].wrapping_add(7)) };
+    // SAFETY: U-003. This invocation just initialized the same live allocation.
+    output[1] = unsafe { pointer.read() };
+}
