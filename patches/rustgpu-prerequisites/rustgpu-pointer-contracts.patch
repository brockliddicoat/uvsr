diff --git a/tests/compiletests/ui/physical_storage/pointer_const_methods_physical64.rs b/tests/compiletests/ui/physical_storage/pointer_const_methods_physical64.rs
new file mode 100644
index 0000000..e11cb70
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/pointer_const_methods_physical64.rs
@@ -0,0 +1,22 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] address: &u64,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 2],
+) {
+    // Constness changes do not alter the pointee type. These casts transport
+    // bits only, without creating a reference or accessing memory.
+    let pointer = *address as *mut u32;
+    output[0] = pointer.cast_const() as u64;
+    output[1] = pointer.cast_const().cast_mut() as u64;
+}
