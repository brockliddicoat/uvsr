diff --git a/tests/compiletests/ui/physical_storage/pointer_address_methods_physical64.rs b/tests/compiletests/ui/physical_storage/pointer_address_methods_physical64.rs
new file mode 100644
index 0000000..19d1952
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/pointer_address_methods_physical64.rs
@@ -0,0 +1,21 @@
+// build-fail
+// only-vulkan1.3_physical64
+// normalize-stderr-test "<\S*/library/core/src/" -> "<$$CORE_SRC/"
+// normalize-stderr-test "(\n)\n+$" -> "$1"
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] data: &[u64; 2],
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 3],
+) {
+    // These safe methods only transport address bits. No resulting pointer is
+    // dereferenced, including when wrapping changes its allocation/provenance.
+    let pointer = data[0] as *mut u32;
+    output[0] = pointer.addr() as u64;
+    output[1] = pointer.with_addr(data[1] as usize) as u64;
+    output[2] = pointer.map_addr(|address| address.wrapping_add(data[1] as usize)) as u64;
+}
