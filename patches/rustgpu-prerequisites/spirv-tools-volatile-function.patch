diff --git a/source/opt/instruction.cpp b/source/opt/instruction.cpp
index d697f0c..112f9b3 100644
--- a/source/opt/instruction.cpp
+++ b/source/opt/instruction.cpp
@@ -225,0 +226,11 @@ void Instruction::ReplaceOperands(const OperandList& new_operands) {
+bool Instruction::HasVolatileMemoryAccess() const {
+  for (uint32_t i = 0; i < NumInOperands(); ++i) {
+    const Operand& operand = GetInOperand(i);
+    if (operand.type == SPV_OPERAND_TYPE_MEMORY_ACCESS &&
+        (operand.words[0] & uint32_t(spv::MemoryAccessMask::Volatile)) != 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
