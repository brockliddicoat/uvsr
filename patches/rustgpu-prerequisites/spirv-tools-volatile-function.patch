@@ -651,0 +652,6 @@ void AggressiveDCEPass::InitializeWorkList(
+      // Volatile accesses remain observable even for Function storage and
+      // even when no load result or destination value escapes the function.
+      if (ii->HasVolatileMemoryAccess()) {
+        AddToWorklist(&*ii);
