+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] data: &[u64; 3],
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 3],
+) {
+    // Wrapping arithmetic does not assert allocation validity. These pointers
+    // are converted back to addresses without any memory access.
+    let pointer = data[0] as *mut u32;
+    output[0] = pointer.wrapping_add(data[1] as usize) as u64;
+    output[1] = pointer.wrapping_sub(data[1] as usize) as u64;
+    output[2] = pointer.wrapping_offset(data[2] as isize) as u64;
+}
