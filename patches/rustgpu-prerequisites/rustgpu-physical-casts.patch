@@ -0,0 +1,23 @@
+// build-pass
+// only-vulkan1.3
+// compile-flags: -C target-feature=+Int64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] input: &u32,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 4],
+) {
+    // The source signedness controls extension independently of the result type.
+    output[0] = (*input as i32) as u64;
+    output[1] = (*input as i64) as u64;
+    output[2] = (-1_i32) as u64;
+    output[3] = u32::MAX as i64 as u64;
+}
