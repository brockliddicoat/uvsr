@@ -9,0 +10,83 @@ use std::mem::take;
+#[cfg(test)]
+mod physical_pointer_tests;
+
+/// Satisfy the physical-pointer alias decoration rules after storage-class
+/// inference. Raw pointers may alias, so do not invent a Restrict promise.
+/// Existing explicit alias/restriction decorations retain their meaning.
+pub fn decorate_physical_pointer_aliases(module: &mut Module) {
+    if !module.memory_model.as_ref().is_some_and(|inst| {
+        inst.operands[0].unwrap_addressing_model() == AddressingModel::PhysicalStorageBuffer64
+    }) {
+        return;
+    }
+
+    let types: FxHashMap<_, _> = module
+        .types_global_values
+        .iter()
+        .filter_map(|inst| inst.result_id.map(|id| (id, inst)))
+        .collect();
+    let existing: FxHashSet<_> = module
+        .annotations
+        .iter()
+        .filter_map(|inst| {
+            (inst.class.opcode == Op::Decorate).then(|| {
+                (
+                    inst.operands[0].unwrap_id_ref(),
+                    inst.operands[1].unwrap_decoration(),
+                )
+            })
+        })
+        .collect();
+    let is_physical_pointer_or_array = |mut ty| {
+        while let Some(inst) = types.get(&ty) {
+            match inst.class.opcode {
+                Op::TypeArray | Op::TypeRuntimeArray => ty = inst.operands[0].unwrap_id_ref(),
+                Op::TypePointer | Op::TypeUntypedPointerKHR => {
+                    return inst.operands[0].unwrap_storage_class()
+                        == StorageClass::PhysicalStorageBuffer;
+                }
+                _ => return false,
+            }
+        }
+        false
+    };
+    let mut annotations = Vec::new();
+    let candidates = module
+        .types_global_values
+        .iter()
+        .filter(|inst| inst.class.opcode == Op::Variable)
+        .chain(module.functions.iter().flat_map(|f| {
+            f.parameters.iter().chain(f.blocks.iter().flat_map(|b| {
+                b.instructions
+                    .iter()
+                    .filter(|i| i.class.opcode == Op::Variable)
+            }))
+        }));
+    for inst in candidates {
+        let ty = inst.result_type.unwrap();
+        let decorations =
+            if inst.class.opcode == Op::FunctionParameter && is_physical_pointer_or_array(ty) {
+                Some((Decoration::Aliased, Decoration::Restrict))
+            } else if types.get(&ty).is_some_and(|t| {
+                t.class.opcode == Op::TypePointer
+                    && is_physical_pointer_or_array(t.operands[1].unwrap_id_ref())
+            }) {
+                Some((Decoration::AliasedPointer, Decoration::RestrictPointer))
+            } else {
+                None
+            };
+        if let Some((aliased, restricted)) = decorations {
+            let id = inst.result_id.unwrap();
+            if !existing.contains(&(id, aliased)) && !existing.contains(&(id, restricted)) {
+                annotations.push(Instruction::new(
+                    Op::Decorate,
+                    None,
+                    None,
+                    vec![Operand::IdRef(id), Operand::Decoration(aliased)],
+                ));
+            }
+        }
+    }
+    module.annotations.extend(annotations);
+}
