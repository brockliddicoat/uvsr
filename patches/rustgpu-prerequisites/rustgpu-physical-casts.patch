+//! Non-executed address conversions through the real linker and specializer.
+#![forbid(unsafe_code)]
+
+use super::{assemble_spirv, link_with_linker_opts, validate};
+use rspirv::binary::{Assemble, Disassemble};
+
+fn check_casts(untyped: bool, qptr: bool) {
+    let mut source = r#"
+OpCapability Shader
+OpCapability Int64
+OpCapability PhysicalStorageBufferAddresses
+OpMemoryModel PhysicalStorageBuffer64 GLSL450
+OpEntryPoint GLCompute %main "main" %output
+OpExecutionMode %main LocalSize 1 1 1
+%void = OpTypeVoid
+%u32 = OpTypeInt 32 0
+%u64 = OpTypeInt 64 0
+%address = OpConstant %u64 4096
+%physical = OpTypePointer PhysicalStorageBuffer %u32
+%private = OpTypePointer Private %u64
+%main_type = OpTypeFunction %void
+%helper_type = OpTypeFunction %u64 %physical
+%output = OpVariable %private Private
+%main = OpFunction %void None %main_type
+%entry = OpLabel
+%pointer = OpConvertUToPtr %physical %address
+%bits = OpFunctionCall %u64 %helper %pointer
+OpStore %output %bits
+OpReturn
+OpFunctionEnd
+%helper = OpFunction %u64 DontInline %helper_type
+%parameter = OpFunctionParameter %physical
+%helper_entry = OpLabel
+%result = OpConvertPtrToU %u64 %parameter
+OpReturnValue %result
+OpFunctionEnd
+"#
+    .to_owned();
+    if untyped {
+        source = source
+            .replace(
+                "OpMemoryModel",
+                "OpCapability UntypedPointersKHR\nOpExtension \"SPV_KHR_untyped_pointers\"\nOpMemoryModel",
+            )
+            .replace(
+                "OpTypePointer PhysicalStorageBuffer %u32",
+                "OpTypeUntypedPointerKHR PhysicalStorageBuffer",
+            );
+    }
+    let binary = assemble_spirv(&source);
+    let module = link_with_linker_opts(
+        &[&binary],
+        &crate::linker::Options {
+            infer_storage_classes: true,
+            structurize: true,
+            spirt_passes: if qptr { vec!["qptr".into()] } else { vec![] },
+            ..Default::default()
+        },
+    )
+    .expect("physical address conversions must survive specialization");
+    validate(&module.assemble());
+    let text = module.disassemble();
+    for instruction in [
+        "OpConvertUToPtr",
+        "OpConvertPtrToU",
+        "OpFunctionCall",
+        "Aliased",
+    ] {
+        assert!(text.contains(instruction), "missing {instruction}:\n{text}");
+    }
+    assert_eq!(module.functions.len(), 2, "keep the physical parameter");
+}
+
+#[test]
+fn typed_casts() {
+    check_casts(false, false);
+}
+
+#[test]
+fn untyped_casts() {
+    check_casts(true, false);
+}
+
+#[test]
+fn typed_casts_qptr() {
+    check_casts(false, true);
+}
+
+#[test]
+fn untyped_casts_qptr() {
+    check_casts(true, true);
+}
