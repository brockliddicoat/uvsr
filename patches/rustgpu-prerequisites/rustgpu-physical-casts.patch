diff --git a/tests/compiletests/ui/physical_storage/cast_physical64.rs b/tests/compiletests/ui/physical_storage/cast_physical64.rs
new file mode 100644
index 0000000..f0b427a
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/cast_physical64.rs
@@ -0,0 +1,34 @@
+// build-pass
+// only-vulkan1.3_physical64
+// compile-flags: -C llvm-args=--disassemble
+// normalize-stderr-test "\n\W*OpSource .*" -> ""
+// normalize-stderr-test "\n\W*OpLine .*" -> ""
+// normalize-stderr-test "\n\W*%\d+ = OpString .*" -> ""
+
+#![forbid(unsafe_code)]
+
+use spirv_std::spirv;
+
+#[inline(never)]
+fn to_pointer(address: u64) -> *mut u32 {
+    address as *mut u32
+}
+
+#[inline(never)]
+fn to_address(pointer: *mut u32) -> u64 {
+    pointer as u64
+}
+
+#[spirv(compute(threads(1)))]
+pub fn main(
+    #[spirv(push_constant)] address: &u64,
+    #[spirv(storage_buffer, descriptor_set = 0, binding = 0)] output: &mut [u64; 4],
+) {
+    // No address is dereferenced. The pointer storage class is inferred across
+    // function arguments and returns rather than annotated at each use.
+    let pointer = to_pointer(*address);
+    output[0] = to_address(pointer);
+    output[1] = (pointer as u32) as u64;
+    output[2] = to_address((*address as u32) as *mut u32);
+    output[3] = to_address((*address as i32) as *mut u32);
+}
