@@ -0,0 +1,95 @@
+#![forbid(unsafe_code)]
+
+use super::*;
+use rspirv::binary::Assemble;
+use spirv_tools::assembler::{self, Assembler};
+use spirv_tools::val::{self, Validator};
+use std::collections::BTreeSet;
+
+#[test]
+fn physical_alias_decorations_validate_and_preserve_explicit_restrictions() {
+    let source = r#"
+OpCapability Shader
+OpCapability PhysicalStorageBufferAddresses
+OpMemoryModel PhysicalStorageBuffer64 GLSL450
+OpEntryPoint GLCompute %main "main"
+OpExecutionMode %main LocalSize 1 1 1
+OpName %a "a"
+OpName %b "b"
+OpName %c "c"
+OpName %logical "logical"
+OpName %slot "slot"
+OpName %slots "slots"
+OpDecorate %b Restrict
+%void = OpTypeVoid
+%u32 = OpTypeInt 32 0
+%two = OpConstant %u32 2
+%physical = OpTypePointer PhysicalStorageBuffer %u32
+%physical_array = OpTypeArray %physical %two
+%slot_type = OpTypePointer Function %physical
+%slots_type = OpTypePointer Function %physical_array
+%logical_type = OpTypePointer Function %u32
+%main_type = OpTypeFunction %void
+%helper_type = OpTypeFunction %void %physical %physical %slot_type %logical_type
+%main = OpFunction %void None %main_type
+%main_label = OpLabel
+%slot = OpVariable %slot_type Function
+%slots = OpVariable %slots_type Function
+OpReturn
+OpFunctionEnd
+%helper = OpFunction %void None %helper_type
+%a = OpFunctionParameter %physical
+%b = OpFunctionParameter %physical
+%c = OpFunctionParameter %slot_type
+%logical = OpFunctionParameter %logical_type
+%helper_label = OpLabel
+OpReturn
+OpFunctionEnd
+"#;
+    let words = assembler::create(None)
+        .assemble(source, assembler::AssemblerOptions::default())
+        .unwrap();
+    let bytes: &[u8] = words.as_ref();
+    let mut module =
+        crate::link::with_rspirv_loader(|loader| rspirv::binary::parse_bytes(bytes, loader))
+            .unwrap();
+    let validator = val::create(None);
+    // The pinned validator does not require missing alias decorations. Check
+    // their exact presence below as well as validating their legal placement.
+
+    decorate_physical_pointer_aliases(&mut module);
+    validator.validate(&module.assemble(), None).unwrap();
+    let names: FxHashMap<_, _> = module
+        .debug_names
+        .iter()
+        .map(|inst| {
+            (
+                inst.operands[0].unwrap_id_ref(),
+                inst.operands[1].unwrap_literal_string(),
+            )
+        })
+        .collect();
+    let found: BTreeSet<_> = module
+        .annotations
+        .iter()
+        .map(|inst| {
+            (
+                names[&inst.operands[0].unwrap_id_ref()],
+                inst.operands[1].unwrap_decoration(),
+            )
+        })
+        .collect();
+    assert_eq!(
+        found,
+        BTreeSet::from([
+            ("a", Decoration::Aliased),
+            ("b", Decoration::Restrict),
+            ("c", Decoration::AliasedPointer),
+            ("slot", Decoration::AliasedPointer),
+            ("slots", Decoration::AliasedPointer),
+        ])
+    );
+    let first = module.assemble();
+    decorate_physical_pointer_aliases(&mut module);
+    assert_eq!(module.assemble(), first, "must not duplicate decorations");
+}
