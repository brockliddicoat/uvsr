+++ b/crates/rustc_codegen_spirv/src/linker/spirt_passes/explicit_layout.rs
@@ -625,0 +626,21 @@ impl<'a> SelectiveEraser<'a> {
+            DataInstKind::SpvInstWithTypeInputs { spv_inst, .. } => {
+                // These operations explicitly supply their data interpretation.
+                // Untyped access chains also accept a typed base whose pointee
+                // need not match that explicit data type.
+                if matches!(
+                    spv_inst.opcode.name(),
+                    "OpUntypedVariableKHR"
+                        | "OpUntypedAccessChainKHR"
+                        | "OpUntypedInBoundsAccessChainKHR"
+                        | "OpUntypedPtrAccessChainKHR"
+                        | "OpUntypedInBoundsPtrAccessChainKHR"
+                ) {
+                    return Ok(());
+                }
+                return Err(Diag::bug([format!(
+                    "unhandled type change in SPIR-V instruction with static type operands ({})",
+                    spv_inst.opcode.name()
+                )
+                .into()]));
+            }
+
