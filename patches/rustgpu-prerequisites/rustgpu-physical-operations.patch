+fn check_volatile_function_storage(qptr: bool) {
+    let binary = assemble_spirv(
+        r#"
+OpCapability Shader
+OpCapability VulkanMemoryModel
+OpMemoryModel Logical Vulkan
+OpEntryPoint GLCompute %main "main" %output
+OpExecutionMode %main LocalSize 1 1 1
+%void = OpTypeVoid
+%u32 = OpTypeInt 32 0
+%two = OpConstant %u32 2
+%one = OpConstant %u32 1
+%value = OpConstant %u32 42
+%array = OpTypeArray %u32 %two
+%local_array = OpTypePointer Function %array
+%local_u32 = OpTypePointer Function %u32
+%shared_u32 = OpTypePointer Workgroup %u32
+%function = OpTypeFunction %void
+%output = OpVariable %shared_u32 Workgroup
+%main = OpFunction %void None %function
+%entry = OpLabel
+%local = OpVariable %local_array Function
+%ordinary = OpVariable %local_u32 Function
+OpStore %ordinary %value
+%input = OpLoad %u32 %ordinary
+%element = OpAccessChain %local_u32 %local %one
+OpStore %element %input Volatile|Nontemporal
+%used = OpLoad %u32 %element Volatile|Nontemporal
+%unused = OpLoad %u32 %element Volatile|Nontemporal
+OpStore %output %used
+OpReturn
+OpFunctionEnd
+"#,
+    );
+    let module = link_with_linker_opts(
+        &[&binary],
+        &crate::linker::Options {
+            infer_storage_classes: true,
+            structurize: true,
+            spirt_passes: if qptr { vec!["qptr".into()] } else { vec![] },
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    validate(&module.assemble());
+    let check = |module: &rspirv::dr::Module| {
+        for (op, index, count) in [(Op::Load, 1, 2), (Op::Store, 2, 1)] {
+            assert_eq!(
+                module
+                    .all_inst_iter()
+                    .filter(|inst| inst.class.opcode == op
+                        && matches!(inst.operands.get(index), Some(Operand::MemoryAccess(mask))
+                            if mask.contains(MemoryAccess::VOLATILE)))
+                    .count(),
+                count,
+                "retain Function memory effects through promotion and qptr:\n{}",
+                module.disassemble()
+            );
+        }
+        assert_eq!(
+            module
+                .all_inst_iter()
+                .filter(|inst| inst.class.opcode == Op::Variable
+                    && inst.operands.first()
+                        == Some(&Operand::StorageClass(
+                            rspirv::spirv::StorageClass::Function
+                        )))
+                .count(),
+            1,
+            "promote only the ordinary Function variable"
+        );
+    };
+    check(&module);
+    let mut optimizer = spirv_tools::opt::create(None);
+    optimizer.register_performance_passes();
+    let optimized = optimizer
+        .optimize(module.assemble(), &mut |_| {}, None)
+        .unwrap();
+    validate(optimized.as_words());
+    let optimized = crate::link::with_rspirv_loader(|loader| {
+        rspirv::binary::parse_words(optimized.as_words(), loader)
+    })
+    .unwrap();
+    check(&optimized);
+}
+
+#[test]
+fn volatile_function_storage() {
+    check_volatile_function_storage(false);
+}
+
+#[test]
+fn volatile_function_storage_qptr() {
+    check_volatile_function_storage(true);
+}
