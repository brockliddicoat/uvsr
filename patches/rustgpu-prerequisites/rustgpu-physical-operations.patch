+        id_decoration_dependencies(Op::DecorateId, Decoration::ArrayStrideIdEXT);
+    }
+
+    #[test]
+    fn retained_member_id_decoration_roots_constant_without_retaining_dead_target() {
+        id_decoration_dependencies(Op::MemberDecorateIdEXT, Decoration::OffsetIdEXT);
+    }
+}
