diff --git a/tests/compiletests/ui/physical_storage/auxiliary/operations_body.rs b/tests/compiletests/ui/physical_storage/auxiliary/operations_body.rs
new file mode 100644
index 0000000..55c8683
--- /dev/null
+++ b/tests/compiletests/ui/physical_storage/auxiliary/operations_body.rs
@@ -0,0 +1,93 @@
+use core::arch::asm;
+use spirv_std::{PhysicalPtr, spirv};
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct Source {
+    alias: PhysicalPtr<[u32; 3]>,
+    values: [u32; 3],
+    tag: u32,
+}
+
+#[repr(C)]
+pub struct Root {
+    source: PhysicalPtr<Source>,
+    destination: PhysicalPtr<[u32; 3]>,
+}
+
+const _: () = {
+    assert!(core::mem::size_of::<Source>() == 24);
+    assert!(core::mem::align_of::<Source>() == 8);
+    assert!(core::mem::offset_of!(Source, alias) == 0);
+    assert!(core::mem::offset_of!(Source, values) == 8);
+    assert!(core::mem::offset_of!(Source, tag) == 20);
+    assert!(core::mem::size_of::<Root>() == 16);
+    assert!(core::mem::align_of::<Root>() == 8);
+    assert!(core::mem::offset_of!(Root, destination) == 8);
+};
+
+/// Aggregate access with a separately loaded alias and logical volatile memory.
+///
+/// # Safety
+/// Dispatch exactly one invocation. Source names a live nonzero eight-byte-
+/// aligned allocation containing an initialized, visible Source. Its alias
+/// must equal destination, which names a disjoint live allocation of at least
+/// 32 bytes aligned to eight. Both remain live through queue completion.
+/// This invocation exclusively writes destination with no concurrent readers,
+/// writers or incompatible Rust reference aliases. Establish initialization
+/// visibility before execution and output visibility before reading or reuse.
+/// Synthetic addresses must never be dispatched. The compiletest does not run
+/// this entry. An external host must establish every obligation before doing so.
+#[allow(unsafe_code, non_snake_case)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn computeMain(#[spirv(push_constant)] root: &Root) {
+    // SAFETY: The complete initialized 24-byte Source has the
+    // asserted layout/alignment, is live and visible, and contains valid bits.
+    let source = unsafe { root.source.read() };
+    // SAFETY: The first 12 destination bytes are aligned, live and
+    // exclusively writable. Values are Copy and no reference is manufactured.
+    unsafe { root.destination.write(source.values) };
+    // SAFETY: The separately loaded address equals destination.
+    // The preceding write initialized its three words in this invocation.
+    let before = unsafe { source.alias.read() };
+    let changed = [
+        before[0].wrapping_add(1),
+        before[1].wrapping_add(2),
+        before[2].wrapping_add(3),
+    ];
+    // SAFETY: This is the same exclusive 12-byte range, accessed
+    // sequentially through address values without competing Rust references.
+    unsafe { source.alias.write(changed) };
+    // SAFETY: The alias write is sequenced before this read.
+    let after = unsafe { root.destination.read() };
+    let sum = after[0].wrapping_add(after[1]).wrapping_add(after[2]);
+    let mut local = 0_u32;
+    let mut observed = 0_u32;
+    // SAFETY: The Function variable belongs only to this invocation and
+    // is initialized before both loads. The live, aligned output reference is
+    // used only to store a valid u32 within the assembly block. No pointer
+    // escapes. The unused volatile load must survive lowering and optimization.
+    unsafe {
+        asm!(
+            "%uint = OpTypeInt 32 0",
+            "OpStore {local} {value} Volatile",
+            "%used = OpLoad %uint {local} Volatile",
+            "%unused = OpLoad %uint {local} Volatile",
+            "OpStore {output} %used",
+            value = in(reg) sum,
+            local = in(reg) &mut local,
+            output = in(reg) &mut observed,
+        );
+    }
+    let words = root.destination.cast::<u32>();
+    // SAFETY: These distinct aligned words 3..6 fit inside the
+    // exclusive 32-byte destination. Word 7 remains an untouched host guard.
+    unsafe {
+        words.wrapping_add(3).write(observed);
+        words.wrapping_add(4).write(source.alias.address() as u32);
+        words
+            .wrapping_add(5)
+            .write((source.alias.address() >> 32) as u32);
+        words.wrapping_add(6).write(source.tag);
+    }
