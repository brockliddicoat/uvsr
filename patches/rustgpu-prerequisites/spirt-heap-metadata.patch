diff --git a/tests/untyped_pointers.rs b/tests/untyped_pointers.rs
index 8f024dc..fea6911 100644
--- a/tests/untyped_pointers.rs
+++ b/tests/untyped_pointers.rs
@@ -177,0 +178,88 @@ fn qptr_diagnoses_typed_whole_buffer_base() {
+
+fn insert_before(words: &mut Vec<u32>, name: &str, inserted: Vec<u32>) {
+    let opcode = spv::spec::Spec::get().instructions.lookup(name).unwrap().as_u16();
+    let mut offset = 5;
+    while words[offset] as u16 != opcode {
+        offset += (words[offset] >> 16) as usize;
+    }
+    words.splice(offset..offset, inserted);
+}
+
+fn heap_fixture(forward_stride: bool, duplicate_stride: bool) -> Vec<u32> {
+    let mut words = fixture(false, true);
+    let mut annotations = vec![];
+    emit(&mut annotations, "OpDecorateId", &[22, 5124, 21]); // ArrayStrideIdEXT.
+    if duplicate_stride {
+        emit(&mut annotations, "OpDecorateId", &[22, 5124, 4]);
+    }
+    emit(&mut annotations, "OpMemberDecorateIdEXT", &[25, 0, 5125, 4]); // OffsetIdEXT.
+    insert_before(&mut words, "OpTypeVoid", annotations);
+    let mut globals = vec![];
+    emit(&mut globals, "OpTypeSampler", &[20]);
+    if forward_stride {
+        emit(&mut globals, "OpTypeRuntimeArray", &[22, 20]);
+        emit(&mut globals, "OpConstantSizeOfEXT", &[3, 21, 20]);
+    } else {
+        emit(&mut globals, "OpConstantSizeOfEXT", &[3, 21, 20]);
+        emit(&mut globals, "OpTypeRuntimeArray", &[22, 20]);
+    }
+    emit(&mut globals, "OpTypeStruct", &[25, 20]);
+    insert_before(&mut words, "OpFunction", globals);
+    let mut accesses = vec![];
+    emit(&mut accesses, "OpUntypedAccessChainKHR", &[17, 23, 22, 18, 4]);
+    emit(&mut accesses, "OpLoad", &[20, 24, 23]);
+    emit(&mut accesses, "OpUntypedAccessChainKHR", &[17, 26, 25, 18, 4]);
+    insert_before(&mut words, "OpReturn", accesses);
+    words
+}
+
+#[test]
+fn descriptor_size_and_id_decorations_survive_renumbering() {
+    let cx = Rc::new(Context::new());
+    let mut module =
+        Module::lower_from_spv_bytes(cx.clone(), bytes(&heap_fixture(false, false))).unwrap();
+    let layout = &spirt::qptr::LayoutConfig::VULKAN_SCALAR_LAYOUT;
+    spirt::passes::qptr::lower_from_spv_ptrs(&mut module, layout);
+    spirt::passes::qptr::analyze_uses(&mut module, layout);
+    spirt::passes::qptr::lift_to_spv_ptrs(&mut module, layout);
+    let text = spirt::print::Plan::for_module(&module).pretty_print().to_string();
+    assert!(text.contains("ArrayStrideIdEXT"));
+    assert!(text.contains("OffsetIdEXT"));
+    assert!(text.contains("OpConstantSizeOfEXT"));
+    let output = module.lift_to_spv_module_emitter().unwrap().words;
+    let insts: Vec<_> = spv::read::ModuleParser::read_from_spv_bytes(bytes(&output))
+        .unwrap()
+        .collect::<std::io::Result<_>>()
+        .unwrap();
+    let def = |id| insts.iter().position(|inst| inst.result_id == Some(id)).unwrap();
+    let stride = insts.iter().find(|i| i.without_ids.opcode.name() == "OpDecorateId").unwrap();
+    let (array, size) = (def(stride.ids[0]), def(stride.ids[1]));
+    assert!(size < array, "stride constant must precede its decorated type");
+    assert_eq!(insts[size].without_ids.opcode.name(), "OpConstantSizeOfEXT");
+    let sampler = def(insts[size].ids[0]);
+    assert!(sampler < size);
+    assert_eq!(insts[sampler].without_ids.opcode.name(), "OpTypeSampler");
+    let offset =
+        insts.iter().find(|i| i.without_ids.opcode.name() == "OpMemberDecorateIdEXT").unwrap();
+    assert!(def(offset.ids[1]) < def(offset.ids[0]));
+    let again = Module::lower_from_spv_bytes(cx, bytes(&output)).unwrap();
+    assert_eq!(again.lift_to_spv_module_emitter().unwrap().words, output);
+}
+
+#[test]
+fn id_decoration_rejects_operand_defined_after_target() {
+    let error =
+        Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&heap_fixture(true, false)))
+            .err()
+            .expect("forward stride operand must be rejected");
+    assert!(error.to_string().contains("defined before its target"), "{error}");
+}
+
+#[test]
+fn duplicate_id_decoration_is_diagnosed() {
+    let error =
+        Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&heap_fixture(false, true)))
+            .err()
+            .expect("duplicate stride must be rejected before interning");
+    assert!(error.to_string().contains("duplicate ID decoration"), "{error}");
+}
