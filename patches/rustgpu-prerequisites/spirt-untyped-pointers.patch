diff --git a/tests/untyped_pointers.rs b/tests/untyped_pointers.rs
new file mode 100644
index 0000000..8f024dc
--- /dev/null
+++ b/tests/untyped_pointers.rs
@@ -0,0 +1,177 @@
+//! Structural IR regressions. Full SPIR-V validation is exercised by consumers.
+#![forbid(unsafe_code)]
+
+use spirt::{Context, Module, spv};
+use std::rc::Rc;
+
+fn emit(words: &mut Vec<u32>, name: &str, operands: &[u32]) {
+    let opcode = spv::spec::Spec::get().instructions.lookup(name).unwrap();
+    words.push((((operands.len() + 1) as u32) << 16) | u32::from(opcode.as_u16()));
+    words.extend_from_slice(operands);
+}
+
+fn string_words(text: &str) -> Vec<u32> {
+    let mut bytes = text.as_bytes().to_vec();
+    bytes.push(0);
+    while bytes.len() % 4 != 0 {
+        bytes.push(0);
+    }
+    bytes.chunks_exact(4).map(|chunk| u32::from_le_bytes(chunk.try_into().unwrap())).collect()
+}
+
+fn fixture(typed_base: bool, whole_buffer: bool) -> Vec<u32> {
+    let mut w = vec![0x07230203, 0x00010600, 0, 64, 0];
+    for cap in [1, 4473, 5128] {
+        // Shader, UntypedPointersKHR, DescriptorHeapEXT.
+        emit(&mut w, "OpCapability", &[cap]);
+    }
+    for ext in ["SPV_KHR_untyped_pointers", "SPV_EXT_descriptor_heap"] {
+        emit(&mut w, "OpExtension", &string_words(ext));
+    }
+    emit(&mut w, "OpMemoryModel", &[0, 1]); // Logical GLSL450.
+    let mut entry = vec![5, 9]; // GLCompute %main.
+    entry.extend(string_words("computeMain"));
+    entry.extend([8, 16, 18]);
+    emit(&mut w, "OpEntryPoint", &entry);
+    emit(&mut w, "OpExecutionMode", &[9, 17, 1, 1, 1]);
+    if whole_buffer {
+        emit(&mut w, "OpDecorate", &[6, 2]); // Block.
+        emit(&mut w, "OpMemberDecorate", &[6, 0, 35, 0]); // Offset 0.
+        emit(&mut w, "OpDecorate", &[8, 34, 0]); // DescriptorSet 0.
+        emit(&mut w, "OpDecorate", &[8, 33, 0]); // Binding 0.
+    }
+    emit(&mut w, "OpDecorate", &[18, 11, 5123]); // BuiltIn ResourceHeapEXT.
+    emit(&mut w, "OpTypeVoid", &[1]);
+    emit(&mut w, "OpTypeFunction", &[2, 1]);
+    emit(&mut w, "OpTypeInt", &[3, 32, 0]);
+    emit(&mut w, "OpConstant", &[3, 4, 0]);
+    emit(&mut w, "OpConstant", &[3, 5, 42]);
+    emit(&mut w, "OpTypeStruct", &[6, 3]);
+    let storage_class = if whole_buffer { 12 } else { 6 }; // StorageBuffer or Private.
+    emit(&mut w, "OpTypeUntypedPointerKHR", &[7, storage_class]);
+    if typed_base {
+        emit(&mut w, "OpTypePointer", &[19, storage_class, 6]);
+        emit(&mut w, "OpVariable", &[19, 8, storage_class]);
+    } else {
+        emit(&mut w, "OpUntypedVariableKHR", &[7, 8, storage_class, 6]);
+    }
+    emit(&mut w, "OpTypeUntypedPointerKHR", &[12, 7]); // Function.
+    emit(&mut w, "OpTypeUntypedPointerKHR", &[15, 6]); // Private.
+    emit(&mut w, "OpUntypedVariableKHR", &[15, 16, 6, 3, 4]);
+    emit(&mut w, "OpTypeUntypedPointerKHR", &[17, 0]); // UniformConstant.
+    emit(&mut w, "OpUntypedVariableKHR", &[17, 18, 0]); // No Data Type.
+    emit(&mut w, "OpFunction", &[1, 9, 0, 2]);
+    emit(&mut w, "OpLabel", &[10]);
+    emit(&mut w, "OpUntypedVariableKHR", &[12, 13, 7, 3, 4]);
+    emit(&mut w, "OpUntypedAccessChainKHR", &[7, 11, 6, 8, 4]);
+    emit(&mut w, "OpStore", &[13, 5]);
+    emit(&mut w, "OpLoad", &[3, 14, 13]);
+    emit(&mut w, "OpStore", &[11, 14]);
+    emit(&mut w, "OpReturn", &[]);
+    emit(&mut w, "OpFunctionEnd", &[]);
+    w
+}
+
+fn bytes(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|word| word.to_le_bytes()).collect()
+}
+
+fn roundtrip(typed_base: bool, qptr: bool) {
+    let mut module = Module::lower_from_spv_bytes(
+        Rc::new(Context::new()),
+        bytes(&fixture(typed_base, !typed_base)),
+    )
+    .unwrap();
+    if qptr {
+        let layout = &spirt::qptr::LayoutConfig {
+            abstract_bool_size_align: (1, 1),
+            logical_ptr_size_align: (4, 4),
+            ..spirt::qptr::LayoutConfig::VULKAN_SCALAR_LAYOUT
+        };
+        spirt::passes::qptr::lower_from_spv_ptrs(&mut module, layout);
+        spirt::passes::qptr::analyze_uses(&mut module, layout);
+        spirt::passes::qptr::lift_to_spv_ptrs(&mut module, layout);
+    }
+    let printed = spirt::print::Plan::for_module(&module).pretty_print().to_string();
+    assert!(printed.contains("untyped"));
+    let output = module.lift_to_spv_module_emitter().unwrap().words;
+    let insts: Vec<_> = spv::read::ModuleParser::read_from_spv_bytes(bytes(&output))
+        .unwrap()
+        .collect::<std::io::Result<_>>()
+        .unwrap();
+    let named = |name: &'static str| {
+        insts.iter().filter(move |inst| inst.without_ids.opcode.name() == name)
+    };
+    let def = |id| insts.iter().find(|inst| inst.result_id == Some(id)).unwrap();
+    let mut globals = 0;
+    let mut locals = 0;
+    let mut in_func = false;
+    for inst in &insts {
+        let name = inst.without_ids.opcode.name();
+        if name == "OpFunction" {
+            in_func = true;
+        }
+        if name != "OpUntypedVariableKHR" {
+            continue;
+        }
+        if in_func {
+            locals += 1;
+        } else {
+            globals += 1;
+        }
+        if let Some(&data_type) = inst.ids.first() {
+            assert!(def(data_type).without_ids.opcode.name().starts_with("OpType"));
+        }
+        if let Some(&initializer) = inst.ids.get(1) {
+            assert_eq!(def(initializer).without_ids.opcode.name(), "OpConstant");
+        }
+    }
+    assert_eq!((globals, locals), (if typed_base { 2 } else { 3 }, 1));
+    assert_eq!(named("OpUntypedVariableKHR").filter(|inst| inst.ids.is_empty()).count(), 1);
+    let chain = named("OpUntypedAccessChainKHR").next().unwrap();
+    assert_eq!(chain.ids.len(), 3);
+    assert_eq!(def(chain.ids[0]).without_ids.opcode.name(), "OpTypeStruct");
+    assert_eq!(
+        def(chain.ids[1]).without_ids.opcode.name(),
+        if typed_base { "OpVariable" } else { "OpUntypedVariableKHR" }
+    );
+    assert_eq!(def(chain.ids[2]).without_ids.opcode.name(), "OpConstant");
+    assert_eq!(named("OpLoad").count(), 1);
+    assert_eq!(named("OpStore").count(), 2);
+    // Re-lowering also verifies every newly emitted type/constant reference.
+    let again = Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&output)).unwrap();
+    assert_eq!(again.lift_to_spv_module_emitter().unwrap().words, output);
+}
+
+#[test]
+fn untyped_globals_locals_and_type_operands() {
+    roundtrip(false, false);
+}
+
+#[test]
+fn qptr_preserves_untyped_memory_operations() {
+    roundtrip(false, true);
+}
+
+#[test]
+fn untyped_access_chain_accepts_typed_base() {
+    roundtrip(true, false);
+}
+
+#[test]
+fn qptr_preserves_untyped_access_chain_with_typed_base() {
+    roundtrip(true, true);
+}
+
+#[test]
+fn qptr_diagnoses_typed_whole_buffer_base() {
+    // qptr already rejects opaque operations consuming a whole typed Block.
+    // Keep that restriction explicit rather than silently dropping its usage.
+    let mut module =
+        Module::lower_from_spv_bytes(Rc::new(Context::new()), bytes(&fixture(true, true))).unwrap();
+    let layout = &spirt::qptr::LayoutConfig::VULKAN_SCALAR_LAYOUT;
+    spirt::passes::qptr::lower_from_spv_ptrs(&mut module, layout);
+    spirt::passes::qptr::analyze_uses(&mut module, layout);
+    let printed = spirt::print::Plan::for_module(&module).pretty_print().to_string();
+    assert!(printed.contains("ToSpvPtrInput: whole Buffer ambiguous"), "{printed}");
+}
