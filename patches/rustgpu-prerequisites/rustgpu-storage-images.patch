diff --git a/crates/spirv-std/README.md b/crates/spirv-std/README.md
index ab3631a..a775d29 100644
--- a/crates/spirv-std/README.md
+++ b/crates/spirv-std/README.md
@@ -66,0 +67,8 @@ for every image parameter, storage access, stage or device.
+The shared `descriptor_heap/auxiliary/storage_body.rs` fixture also compiles
+typed rgba32ui storage-image reads/writes and a physical output through default
+and qptr lowering at opt0/opt3. Its profile declares `ShaderNonUniform` and
+`StorageImageArrayNonUniformIndexing`, so the consumer must query and enable the
+corresponding storage-image device feature. Its complete unsafe entry contract
+is in the fixture. These compiletests do not dispatch an image or prove runtime
+support for untested formats, access modes or stages.
+
diff --git a/tests/compiletests/ui/descriptor_heap/auxiliary/storage_body.rs b/tests/compiletests/ui/descriptor_heap/auxiliary/storage_body.rs
new file mode 100644
index 0000000..ab87e61
--- /dev/null
+++ b/tests/compiletests/ui/descriptor_heap/auxiliary/storage_body.rs
@@ -0,0 +1,58 @@
+use spirv_std::glam::{UVec2, UVec4};
+use spirv_std::{Image, PhysicalPtr, spirv};
+
+type StorageImage = Image!(2D, format = rgba32ui, sampled = false);
+
+#[repr(C)]
+pub struct Root {
+    pub output: PhysicalPtr<[u32; 4]>,
+    pub source: u32,
+    pub destination: u32,
+}
+
+const _: () = {
+    assert!(core::mem::size_of::<Root>() == 16);
+    assert!(core::mem::align_of::<Root>() == 8);
+    assert!(core::mem::offset_of!(Root, output) == 0);
+    assert!(core::mem::offset_of!(Root, source) == 8);
+    assert!(core::mem::offset_of!(Root, destination) == 12);
+};
+
+/// Read and write native storage images, with an independent physical output.
+///
+/// # Safety
+/// Bind a live native resource heap whose selected complete, aligned descriptor
+/// ranges describe distinct 2D rgba32ui storage images, at least 2 by 2 texels.
+/// Both images and their initialization must be visible in GENERAL layout.
+/// This invocation exclusively writes the destination's texel (0, 1). No other
+/// access may conflict, and descriptors must remain unchanged through completion.
+/// Output is a separate, live, nonzero, four-byte-aligned exclusive 16-byte range.
+/// Enable every declared shader capability and corresponding device feature.
+/// Dispatch exactly one invocation with this 16-byte root. Keep all allocations
+/// live through queue completion and establish visibility before readback/reuse.
+/// Neither construction nor compiler validation establishes these obligations.
+#[allow(unsafe_code, non_snake_case)]
+#[spirv(compute(threads(1)))]
+pub unsafe fn computeMain(#[spirv(push_constant)] root: &Root) {
+    // SAFETY: The entry contract provides initialized native-size descriptors
+    // for the exact storage image type, with complete bounds and live resources.
+    let (source, destination) = unsafe {
+        (
+            StorageImage::from_resource_heap(root.source),
+            StorageImage::from_resource_heap(root.destination),
+        )
+    };
+    let original = source.read(UVec2::new(1, 0));
+    let value = UVec4::new(
+        original.x.wrapping_add(1),
+        original.y.wrapping_add(2),
+        original.z.wrapping_add(3),
+        original.w.wrapping_add(4),
+    );
+    // SAFETY: Texel (0, 1) is in the live destination, with exclusive access by
+    // this invocation. The rgba32ui value matches the descriptor's storage type.
+    unsafe { destination.write(UVec2::new(0, 1), value) };
+    // SAFETY: The entry guarantees a disjoint complete aligned physical range
+    // and exclusive write access. Every u32 representation is a valid value.
+    unsafe { root.output.write([value.x, value.y, value.z, value.w]) };
+}
