--- a/crates/rustc_codegen_spirv/src/linker/duplicates.rs
+++ b/crates/rustc_codegen_spirv/src/linker/duplicates.rs
@@ -85,0 +86 @@ fn gather_annotations(annotations: &[Instruction]) -> FxHashMap<Word, Vec<u32>>
+            | Op::MemberDecorateIdEXT
@@ -274,0 +276,53 @@ pub fn remove_duplicate_types(module: &mut Module) {
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn member_id_offsets_distinguish_descriptor_structs() {
+        let mut module = Module::new();
+        module.types_global_values = vec![
+            Instruction::new(
+                Op::TypeInt,
+                None,
+                Some(1),
+                vec![Operand::LiteralBit32(32), Operand::LiteralBit32(0)],
+            ),
+            Instruction::new(
+                Op::Constant,
+                Some(1),
+                Some(2),
+                vec![Operand::LiteralBit32(0)],
+            ),
+            Instruction::new(
+                Op::Constant,
+                Some(1),
+                Some(3),
+                vec![Operand::LiteralBit32(16)],
+            ),
+            Instruction::new(Op::TypeSampler, None, Some(4), vec![]),
+            Instruction::new(Op::TypeStruct, None, Some(5), vec![Operand::IdRef(4)]),
+            Instruction::new(Op::TypeStruct, None, Some(6), vec![Operand::IdRef(4)]),
+        ];
+        module.annotations = [(5, 2), (6, 3)]
+            .into_iter()
+            .map(|(target, offset)| {
+                Instruction::new(
+                    Op::MemberDecorateIdEXT,
+                    None,
+                    None,
+                    vec![
+                        Operand::IdRef(target),
+                        Operand::LiteralBit32(0),
+                        Operand::Decoration(rspirv::spirv::Decoration::OffsetIdEXT),
+                        Operand::IdRef(offset),
+                    ],
+                )
+            })
+            .collect();
+        let original = module.clone();
+        remove_duplicate_types(&mut module);
+        assert_eq!(module.types_global_values, original.types_global_values);
+        assert_eq!(module.annotations, original.annotations);
+    }
+}
+
