+
+void ImGui::SetUvsrSliderTrackColors(
+    const ImVec4& normal,
+    const ImVec4& hovered,
+    const ImVec4& active)
+{
+    ImGuiContext& g = *GImGui;
+    const auto saturated = [](const ImVec4& color)
+    {
+        return ImVec4(
+            ImSaturate(color.x),
+            ImSaturate(color.y),
+            ImSaturate(color.z),
+            ImSaturate(color.w));
+    };
+    g.UvsrSliderTrack = saturated(normal);
+    g.UvsrSliderTrackHovered = saturated(hovered);
+    g.UvsrSliderTrackActive = saturated(active);
+}
+
+void ImGui::PushUvsrDisabledPresentation(float amount)
+{
+    ImGuiContext& g = *GImGui;
+    const float inherited =
+        g.UvsrDisabledPresentationAmountStack.Size > 0
+            ? g.UvsrDisabledPresentationAmountStack.back()
+            : 0.0f;
+    g.UvsrDisabledPresentationAmountStack.push_back(
+        ImMax(inherited, ImSaturate(amount)));
+}
+
+void ImGui::PopUvsrDisabledPresentation()
+{
+    ImGuiContext& g = *GImGui;
+    IM_ASSERT(g.UvsrDisabledPresentationAmountStack.Size > 0);
+    g.UvsrDisabledPresentationAmountStack.pop_back();
+}
