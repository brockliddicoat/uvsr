+
+static void BeginUvsrComboPopupHighlight(
+    ImGuiWindow* window,
+    ImGuiContext& g)
+{
+    ImGuiStorage& storage = window->StateStorage;
+    storage.SetInt(
+        GetUvsrComboPopupHighlightKey(
+            window,
+            "##UvsrComboHighlightTargetFrame"),
+        g.FrameCount);
+    storage.SetInt(
+        GetUvsrComboPopupHighlightKey(
+            window,
+            "##UvsrComboHighlightTargetPriority"),
+        0);
+    window->DrawList->ChannelsSplit(2);
+    window->DrawList->ChannelsSetCurrent(1);
+}
+
+static void RegisterUvsrComboPopupHighlight(
+    ImGuiWindow* window,
+    ImGuiContext& g,
+    const ImRect& rect,
+    const ImVec4& color,
+    int priority)
+{
+    ImGuiStorage& storage = window->StateStorage;
+    const ImGuiID frame_key = GetUvsrComboPopupHighlightKey(
+        window,
+        "##UvsrComboHighlightTargetFrame");
+    const ImGuiID priority_key = GetUvsrComboPopupHighlightKey(
+        window,
+        "##UvsrComboHighlightTargetPriority");
+    if (storage.GetInt(frame_key, -1) != g.FrameCount ||
+        priority <= storage.GetInt(priority_key, 0))
+    {
+        return;
+    }
+
+    const ImRect local_rect(
+        rect.Min - window->Pos,
+        rect.Max - window->Pos);
+    storage.SetInt(priority_key, priority);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMinX"),
+        local_rect.Min.x);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMinY"),
+        local_rect.Min.y);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMaxX"),
+        local_rect.Max.x);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMaxY"),
+        local_rect.Max.y);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorR"),
+        color.x);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorG"),
+        color.y);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorB"),
+        color.z);
+    storage.SetFloat(
+        GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorA"),
+        color.w);
+}
+
+static void EndUvsrComboPopupHighlight(
+    ImGuiWindow* window,
+    ImGuiContext& g)
+{
+    ImGuiStorage& storage = window->StateStorage;
+    const bool has_target =
+        storage.GetInt(
+            GetUvsrComboPopupHighlightKey(
+                window,
+                "##UvsrComboHighlightTargetFrame"),
+            -1) == g.FrameCount &&
+        storage.GetInt(
+            GetUvsrComboPopupHighlightKey(
+                window,
+                "##UvsrComboHighlightTargetPriority"),
+            0) > 0;
+    const ImGuiID valid_key = GetUvsrComboPopupHighlightKey(
+        window,
+        "##UvsrComboHighlightValid");
+    const ImGuiID frame_key = GetUvsrComboPopupHighlightKey(
+        window,
+        "##UvsrComboHighlightFrame");
+    const int last_frame = storage.GetInt(frame_key, -2);
+    bool valid = storage.GetInt(valid_key, 0) != 0;
+    ImRect current_rect(
+        ImVec2(
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMinX"), 0.0f),
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMinY"), 0.0f)),
+        ImVec2(
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMaxX"), 0.0f),
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMaxY"), 0.0f)));
+    ImVec4 current_color(
+        storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorR"), 0.0f),
+        storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorG"), 0.0f),
+        storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorB"), 0.0f),
+        storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorA"), 0.0f));
+
+    ImRect target_rect = current_rect;
+    ImVec4 target_color = current_color;
+    if (has_target)
+    {
+        target_rect = ImRect(
+            ImVec2(
+                storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMinX"), 0.0f),
+                storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMinY"), 0.0f)),
+            ImVec2(
+                storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMaxX"), 0.0f),
+                storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetMaxY"), 0.0f)));
+        target_color = ImVec4(
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorR"), 0.0f),
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorG"), 0.0f),
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorB"), 0.0f),
+            storage.GetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboTargetColorA"), 0.0f));
+    }
+    else
+    {
+        target_color.w = 0.0f;
+    }
+
+    const bool submission_was_interrupted =
+        last_frame < g.FrameCount - 1;
+    if (has_target &&
+        (!valid || window->Appearing || submission_was_interrupted ||
+            !g.UvsrUiMotionEnabled))
+    {
+        current_rect = target_rect;
+        current_color = target_color;
+        valid = true;
+    }
+    else if (valid)
+    {
+        const float delta_time = ImClamp(
+            g.IO.DeltaTime,
+            0.0f,
+            1.0f / 30.0f);
+        const float half_life = 0.055f;
+        const float blend = g.UvsrUiMotionEnabled
+            ? 1.0f - ImPow(2.0f, -delta_time / half_life)
+            : 1.0f;
+        current_rect.Min = ImLerp(current_rect.Min, target_rect.Min, blend);
+        current_rect.Max = ImLerp(current_rect.Max, target_rect.Max, blend);
+        current_color = ImLerp(current_color, target_color, blend);
+        if (!has_target && current_color.w < 0.002f)
+            valid = false;
+    }
+
+    window->DrawList->ChannelsSetCurrent(0);
+    if (valid && current_rect.GetWidth() > 0.0f && current_rect.GetHeight() > 0.0f)
+    {
+        window->DrawList->AddRectFilled(
+            current_rect.Min + window->Pos,
+            current_rect.Max + window->Pos,
+            ImGui::GetColorU32(current_color),
+            g.Style.FrameRounding);
+    }
+    window->DrawList->ChannelsMerge();
+
+    storage.SetInt(valid_key, valid ? 1 : 0);
+    storage.SetInt(frame_key, g.FrameCount);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMinX"), current_rect.Min.x);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMinY"), current_rect.Min.y);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMaxX"), current_rect.Max.x);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentMaxY"), current_rect.Max.y);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorR"), current_color.x);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorG"), current_color.y);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorB"), current_color.z);
+    storage.SetFloat(GetUvsrComboPopupHighlightKey(window, "##UvsrComboCurrentColorA"), current_color.w);
+}
