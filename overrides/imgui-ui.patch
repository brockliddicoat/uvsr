+void ImGui::RenderGradientFrame(
+    ImVec2 p_min,
+    ImVec2 p_max,
+    ImU32 top_col,
+    ImU32 bottom_col,
+    bool borders,
+    float rounding,
+    bool raised,
+    ImDrawFlags rounding_flags)
+{
+    ImGuiContext& g = *GImGui;
+    ImGuiWindow* window = g.CurrentWindow;
+    const int vertex_start = window->DrawList->VtxBuffer.Size;
+    window->DrawList->AddRectFilled(
+        p_min,
+        p_max,
+        IM_COL32_WHITE,
+        rounding,
+        rounding_flags);
+    const int vertex_end = window->DrawList->VtxBuffer.Size;
+
+    const ImVec4 top_color = ColorConvertU32ToFloat4(top_col);
+    const ImVec4 bottom_color = ColorConvertU32ToFloat4(bottom_col);
+    const float gradient_extent = ImMax(p_max.y - p_min.y, 1.0f);
+    for (int vertex_index = vertex_start;
+        vertex_index < vertex_end;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = window->DrawList->VtxBuffer[vertex_index];
+        const float coverage =
+            float((vertex.col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT) / 255.0f;
+        const float gradient_position = ImSaturate(
+            (vertex.pos.y - p_min.y) / gradient_extent);
+        ImVec4 fill_color = ImLerp(top_color, bottom_color, gradient_position);
+        fill_color.w *= coverage;
+        vertex.col = ColorConvertFloat4ToU32(fill_color);
+    }
+
+    const float border_size = g.Style.FrameBorderSize;
+    if (borders && border_size > 0.0f)
+    {
+        window->DrawList->AddRect(
+            p_min + ImVec2(1, 1),
+            p_max + ImVec2(1, 1),
+            GetColorU32(ImGuiCol_BorderShadow),
+            rounding,
+            0,
+            border_size);
+        window->DrawList->AddRect(
+            p_min,
+            p_max,
+            GetColorU32(ImGuiCol_Border),
+            rounding,
+            0,
+            border_size);
+    }
+    const bool dark_outline =
+        raised &&
+        IsUltraBrightFrameSurface(top_col);
+    RenderGradientFrameOutline(
+        window->DrawList,
+        ImRect(p_min, p_max),
+        rounding,
+        raised,
+        dark_outline,
+        rounding_flags);
+}
