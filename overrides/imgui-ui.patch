+bool ImGui::IsUltraBrightFrameSurface(ImU32 surface_col)
+{
+    const ImVec4 surface = ColorConvertU32ToFloat4(surface_col);
+    const float luminance =
+        surface.x * 0.2126f +
+        surface.y * 0.7152f +
+        surface.z * 0.0722f;
+    return surface.w > 0.0f && luminance >= 0.68f;
+}
+
+static void RenderGradientFrameOutline(
+    ImDrawList* draw_list,
+    const ImRect& bounding_box,
+    float rounding,
+    bool raised,
+    bool dark_outline = false,
+    ImDrawFlags rounding_flags = ImDrawFlags_RoundCornersAll)
+{
+    if (GImGui != NULL && GImGui->UvsrStockWidgetRendering)
+        return;
+
+    const float thickness = 1.0f;
+    const float inset = thickness;
+    const ImRect outline_box(
+        bounding_box.Min + ImVec2(inset, inset),
+        bounding_box.Max - ImVec2(inset, inset));
+    if (outline_box.GetWidth() <= thickness ||
+        outline_box.GetHeight() <= thickness)
+    {
+        return;
+    }
+
+    const int vertex_start = draw_list->VtxBuffer.Size;
+    draw_list->AddRect(
+        outline_box.Min,
+        outline_box.Max,
+        IM_COL32_WHITE,
+        ImMax(0.0f, rounding - inset),
+        rounding_flags,
+        thickness);
+    const int vertex_end = draw_list->VtxBuffer.Size;
+
+    const float gradient_extent = ImMax(outline_box.GetHeight(), 1.0f);
+    for (int vertex_index = vertex_start;
+        vertex_index < vertex_end;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = draw_list->VtxBuffer[vertex_index];
+        const float gradient_position = ImSaturate(
+            (vertex.pos.y - outline_box.Min.y) / gradient_extent);
+        const ImVec4 raised_top(1.0f, 1.0f, 1.0f, 0.12f);
+        const ImVec4 raised_bottom(0.01f, 0.012f, 0.016f, 0.10f);
+        const ImVec4 carved_top(0.005f, 0.006f, 0.008f, 0.14f);
+        const ImVec4 carved_bottom(0.88f, 0.90f, 0.94f, 0.070f);
+        const ImVec4 bright_top(0.0f, 0.0f, 0.0f, 0.24f);
+        const ImVec4 bright_bottom(0.16f, 0.17f, 0.19f, 0.32f);
+        const ImVec4& top_color = dark_outline
+            ? bright_top
+            : raised ? raised_top : carved_top;
+        const ImVec4& bottom_color = dark_outline
+            ? bright_bottom
+            : raised ? raised_bottom : carved_bottom;
+        ImVec4 outline_color = ImLerp(
+            top_color,
+            bottom_color,
+            gradient_position);
+        outline_color.w *= float((vertex.col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT) / 255.0f;
+        vertex.col = ImGui::GetColorU32(outline_color);
+    }
+}
+
+static ImU32 GetRaisedFrameGradientBottomColor(ImU32 top_color)
+{
+    ImVec4 bottom_color = ImGui::ColorConvertU32ToFloat4(top_color);
+    const float shade =
+        ImGui::IsUltraBrightFrameSurface(top_color)
+        ? 0.025f
+        : 0.045f;
+    bottom_color.x *= 1.0f - shade;
+    bottom_color.y *= 1.0f - shade;
+    bottom_color.z *= 1.0f - shade;
+    bottom_color.w *= 0.98f;
+    return ImGui::ColorConvertFloat4ToU32(bottom_color);
+}
