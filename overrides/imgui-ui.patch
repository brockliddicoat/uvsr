+
+    const ImVec2 outer_size(
+        outer_width,
+        ImMin(expected_outer_height, available_height));
+    const ImVec2 popup_position(
+        requested_x,
+        ImClamp(
+            default_anchor.y,
+            allowed.Min.y,
+            ImMax(allowed.Min.y, allowed.Max.y - outer_size.y)));
