+static UvsrColorPickerPopupLayout ConfigureUvsrColorPickerPopup(
+    ImGuiWindow* parent_window,
+    const ImVec2& default_anchor,
+    float content_right,
+    float maximum_bottom,
+    float square_sz,
+    bool has_visible_label,
+    bool configure_window)
+{
+    ImGuiContext& g = *GImGui;
+    const ImGuiStyle& style = g.Style;
+    ImRect allowed = ImGui::GetPopupAllowedExtentRect(parent_window);
+    allowed.Max.y = ImMin(allowed.Max.y, maximum_bottom);
+    const float normal_picker_width = square_sz * 12.0f;
+    const float normal_content_width =
+        normal_picker_width +
+        style.ItemInnerSpacing.x +
+        square_sz * 3.0f;
+    const float normal_outer_width =
+        normal_content_width + style.WindowPadding.x * 2.0f;
+    const float minimum_picker_width =
+        square_sz * 3.0f + style.ItemInnerSpacing.x * 2.0f;
+    const float minimum_outer_width =
+        minimum_picker_width + style.WindowPadding.x * 2.0f;
+    const float minimum_outer_height =
+        square_sz * 3.0f + style.WindowPadding.y * 2.0f;
+    const float requested_x = ImClamp(
+        content_right,
+        allowed.Min.x,
+        allowed.Max.x);
+    const float available_width =
+        ImMax(allowed.Max.x - requested_x, 0.0f);
+    const float available_height =
+        ImMax(allowed.Max.y - allowed.Min.y, 0.0f);
+
+    UvsrColorPickerPopupLayout layout = {
+        normal_picker_width,
+        available_width < normal_outer_width,
+        available_width >= minimum_outer_width &&
+            available_height >= minimum_outer_height
