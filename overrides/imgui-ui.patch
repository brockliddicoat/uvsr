+struct UvsrVerticalGradientStop
+{
+    float Position;
+    ImU32 Color;
+};
+
+static void AddUvsrSortedGradientCoordinate(ImVector<float>& coordinates, float value)
+{
+    int insert_index = 0;
+    while (insert_index < coordinates.Size && coordinates[insert_index] < value)
+        ++insert_index;
+    if (insert_index < coordinates.Size && ImAbs(coordinates[insert_index] - value) <= 0.01f)
+        return;
+    if (insert_index > 0 && ImAbs(coordinates[insert_index - 1] - value) <= 0.01f)
+        return;
+    coordinates.insert(coordinates.begin() + insert_index, value);
+}
+
+static ImU32 GetUvsrVerticalGradientColor(const UvsrVerticalGradientStop* stops, int stops_count, float position, float coverage)
+{
+    IM_ASSERT(stops_count >= 2);
+    position = ImSaturate(position);
+    int stop_index = 0;
+    while (stop_index + 1 < stops_count - 1 && position > stops[stop_index + 1].Position)
+        ++stop_index;
+    const UvsrVerticalGradientStop& first = stops[stop_index];
+    const UvsrVerticalGradientStop& second = stops[stop_index + 1];
+    const float denominator = ImMax(second.Position - first.Position, FLT_EPSILON);
+    const float amount = ImSaturate((position - first.Position) / denominator);
+    const ImVec4 first_color = ImGui::ColorConvertU32ToFloat4(first.Color);
+    const ImVec4 second_color = ImGui::ColorConvertU32ToFloat4(second.Color);
+    ImVec4 color(
+        ImLerp(first_color.x, second_color.x, amount),
+        ImLerp(first_color.y, second_color.y, amount),
+        ImLerp(first_color.z, second_color.z, amount),
+        ImLerp(first_color.w, second_color.w, amount) * coverage);
+    return ImGui::ColorConvertFloat4ToU32(color);
+}
+
+static float GetUvsrRoundedRectDistance(const ImRect& bounds, float rounding, const ImVec2& position)
+{
+    const ImVec2 center = bounds.GetCenter();
+    const ImVec2 half_size = bounds.GetSize() * 0.5f;
+    const ImVec2 rounded_half_size(
+        ImMax(half_size.x - rounding, 0.0f),
+        ImMax(half_size.y - rounding, 0.0f));
+    const ImVec2 offset(
+        ImAbs(position.x - center.x) - rounded_half_size.x,
+        ImAbs(position.y - center.y) - rounded_half_size.y);
+    const ImVec2 outside(ImMax(offset.x, 0.0f), ImMax(offset.y, 0.0f));
+    return ImSqrt(ImLengthSqr(outside)) +
+        ImMin(ImMax(offset.x, offset.y), 0.0f) - rounding;
+}
+
+static void AddUvsrRoundedVerticalGradient(
+    ImDrawList* draw_list,
+    const ImRect& bounds,
+    const UvsrVerticalGradientStop* stops,
+    int stops_count,
+    float rounding)
+{
+    const float width = bounds.GetWidth();
+    const float height = bounds.GetHeight();
+    if (width <= 0.0f || height <= 0.0f || stops_count < 2)
+        return;
+
+    rounding = ImClamp(rounding, 0.0f, ImMin(width, height) * 0.5f);
+    const float fringe = (draw_list->Flags & ImDrawListFlags_AntiAliasedFill)
+        ? ImMax(draw_list->_FringeScale, 0.5f)
+        : 0.0f;
+    ImVector<float> x_coordinates;
+    ImVector<float> y_coordinates;
+    AddUvsrSortedGradientCoordinate(x_coordinates, bounds.Min.x - fringe);
+    AddUvsrSortedGradientCoordinate(x_coordinates, bounds.Max.x + fringe);
+    AddUvsrSortedGradientCoordinate(y_coordinates, bounds.Min.y - fringe);
+    AddUvsrSortedGradientCoordinate(y_coordinates, bounds.Max.y + fringe);
+
+    const int x_sections = ImMax(4, (int)ImCeil(width / 2.0f));
+    int y_sections = ImMax(12, (int)ImCeil(height / 4.0f));
+    const int gradient_sections = stops_count - 1;
+    y_sections = ((y_sections + gradient_sections - 1) / gradient_sections) * gradient_sections;
+    for (int section = 0; section <= x_sections; ++section)
+    {
+        AddUvsrSortedGradientCoordinate(
+            x_coordinates,
+            ImLerp(bounds.Min.x, bounds.Max.x, (float)section / (float)x_sections));
+    }
+    for (int section = 0; section <= y_sections; ++section)
+    {
+        AddUvsrSortedGradientCoordinate(
+            y_coordinates,
+            ImLerp(bounds.Min.y, bounds.Max.y, (float)section / (float)y_sections));
+    }
+    for (int stop_index = 0; stop_index < stops_count; ++stop_index)
+    {
+        AddUvsrSortedGradientCoordinate(
+            y_coordinates,
+            ImLerp(bounds.Min.y, bounds.Max.y, ImSaturate(stops[stop_index].Position)));
+    }
+    if (rounding > 0.0f)
+    {
+        const int arc_sections = ImClamp(
+            draw_list->_CalcCircleAutoSegmentCount(rounding) / 4,
+            2,
+            8);
+        for (int section = 0; section <= arc_sections; ++section)
+        {
+            const float angle = (float)section / (float)arc_sections * IM_PI * 0.5f;
+            const float offset = rounding * (1.0f - ImCos(angle));
+            AddUvsrSortedGradientCoordinate(x_coordinates, bounds.Min.x + offset);
+            AddUvsrSortedGradientCoordinate(x_coordinates, bounds.Max.x - offset);
+            AddUvsrSortedGradientCoordinate(y_coordinates, bounds.Min.y + offset);
+            AddUvsrSortedGradientCoordinate(y_coordinates, bounds.Max.y - offset);
+        }
+    }
+
+    const int vertex_count = x_coordinates.Size * y_coordinates.Size;
+    const int index_count =
+        (x_coordinates.Size - 1) * (y_coordinates.Size - 1) * 6;
+    draw_list->PrimReserve(index_count, vertex_count);
+    const ImDrawIdx base_vertex = (ImDrawIdx)draw_list->_VtxCurrentIdx;
+    const ImVec2 white_pixel = draw_list->_Data->TexUvWhitePixel;
+    const float safe_height = ImMax(height, FLT_EPSILON);
+    for (int y_index = 0; y_index < y_coordinates.Size; ++y_index)
+    {
+        const float y = y_coordinates[y_index];
+        const float gradient_position = (y - bounds.Min.y) / safe_height;
+        for (int x_index = 0; x_index < x_coordinates.Size; ++x_index)
+        {
+            const ImVec2 position(x_coordinates[x_index], y);
+            const float distance = GetUvsrRoundedRectDistance(bounds, rounding, position);
+            const float coverage = fringe > 0.0f
+                ? ImSaturate(0.5f - distance / fringe)
+                : (distance <= 0.0f ? 1.0f : 0.0f);
+            draw_list->PrimWriteVtx(
+                position,
+                white_pixel,
+                GetUvsrVerticalGradientColor(stops, stops_count, gradient_position, coverage));
+        }
+    }
+    for (int y_index = 0; y_index + 1 < y_coordinates.Size; ++y_index)
+    {
+        for (int x_index = 0; x_index + 1 < x_coordinates.Size; ++x_index)
+        {
+            const ImDrawIdx top_left = (ImDrawIdx)(
+                base_vertex + y_index * x_coordinates.Size + x_index);
+            const ImDrawIdx top_right = (ImDrawIdx)(top_left + 1);
+            const ImDrawIdx bottom_left = (ImDrawIdx)(top_left + x_coordinates.Size);
+            const ImDrawIdx bottom_right = (ImDrawIdx)(bottom_left + 1);
+            draw_list->PrimWriteIdx(top_left);
+            draw_list->PrimWriteIdx(top_right);
+            draw_list->PrimWriteIdx(bottom_right);
+            draw_list->PrimWriteIdx(top_left);
+            draw_list->PrimWriteIdx(bottom_right);
+            draw_list->PrimWriteIdx(bottom_left);
+        }
+    }
+}
+
+static void AddUvsrRoundedTriangle(
+    ImDrawList* draw_list,
+    const ImVec2& first,
+    const ImVec2& second,
+    const ImVec2& third,
+    ImU32 color)
+{
+    if ((color & IM_COL32_A_MASK) == 0)
+        return;
+    const ImVec2 points[3] = { first, second, third };
+    ImVec2 incoming[3];
+    ImVec2 outgoing[3];
+    for (int point_index = 0; point_index < 3; ++point_index)
+    {
+        const ImVec2& point = points[point_index];
+        const ImVec2& previous = points[(point_index + 2) % 3];
+        const ImVec2& next = points[(point_index + 1) % 3];
+        const ImVec2 to_previous = previous - point;
+        const ImVec2 to_next = next - point;
+        const float previous_length = ImSqrt(ImLengthSqr(to_previous));
+        const float next_length = ImSqrt(ImLengthSqr(to_next));
+        const float tangent_distance = ImMax(
+            0.5f,
+            ImMin(previous_length, next_length) * 0.18f);
+        incoming[point_index] = point +
+            to_previous * (ImMin(tangent_distance, previous_length * 0.45f) /
+                ImMax(previous_length, FLT_EPSILON));
+        outgoing[point_index] = point +
+            to_next * (ImMin(tangent_distance, next_length * 0.45f) /
+                ImMax(next_length, FLT_EPSILON));
+    }
+
+    draw_list->PathClear();
+    draw_list->PathLineTo(incoming[0]);
+    for (int point_index = 0; point_index < 3; ++point_index)
+    {
+        if (point_index > 0)
+            draw_list->PathLineTo(incoming[point_index]);
+        draw_list->PathBezierQuadraticCurveTo(
+            points[point_index],
+            outgoing[point_index],
+            3);
+    }
+    draw_list->PathFillConvex(color);
+}
