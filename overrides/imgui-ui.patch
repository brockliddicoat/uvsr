+static void ApplyDisabledGrayscale(ImVec4& color)
+{
+    ImGuiContext& g = *GImGui;
+    if (g.UvsrStockWidgetRendering)
+        return;
+
+    const float amount =
+        g.UvsrDisabledPresentationAmountStack.Size > 0
+            ? g.UvsrDisabledPresentationAmountStack.back()
+            : (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0
+                ? 1.0f
+                : 0.0f;
+    if (amount <= 0.0f)
+        return;
+
+    const float luminance =
+        color.x * 0.299f +
+        color.y * 0.587f +
+        color.z * 0.114f;
+    color.x = ImLerp(color.x, luminance, amount);
+    color.y = ImLerp(color.y, luminance, amount);
+    color.z = ImLerp(color.z, luminance, amount);
+}
