 // Note: p_data, p_min and p_max are _pointers_ to a memory address holding the data. For a Drag widget, p_min and p_max are optional.
 // Read code of e.g. DragFloat(), DragInt() etc. or examples in 'Demo->Widgets->Data Types' to understand how to use this function directly.
+static const char* UvsrExactNumberFormat(ImGuiDataType type)
+{
+    return type == ImGuiDataType_Float ? "%.9g" : type == ImGuiDataType_Double ? "%.17g" : ImGui::DataTypeGetInfo(type)->PrintFmt;
+}
+
+int ImGui::FormatUvsrNumber(char* buffer, int size, ImGuiDataType type, const void* data, const char* format)
+{
+    if (!format || !*format) return ImFormatString(buffer, size, "");
+    char number[64];
+    DataTypeFormatString(number, IM_ARRAYSIZE(number), type, data, UvsrExactNumberFormat(type));
+    const double value = strtod(number, NULL);
+    const double magnitude = fabs(value);
+    const auto digits = [](const char* text)
+    {
+        int count = 0;
+        for (; *text; ++text)
+            count += *text >= '0' && *text <= '9';
+        return count;
+    };
+    if (type < ImGuiDataType_Float && magnitude < 10000.0)
+        ImFormatString(number, IM_ARRAYSIZE(number), "%s%04d", value < 0 ? "-" : "", int(magnitude));
+    else if (magnitude == 0.0 || (magnitude >= 0.001 && magnitude < 10000.0))
+        for (int decimals = 3; decimals >= 0; --decimals)
+        {
+            ImFormatString(number, IM_ARRAYSIZE(number), "%.*f", decimals, value);
+            if (digits(number) == 4) break;
+        }
+    if (digits(number) != 4 && value == value && magnitude != HUGE_VAL)
+        for (int decimals = 3; decimals >= 0; --decimals)
+        {
+            char scientific[64];
+            ImFormatString(scientific, IM_ARRAYSIZE(scientific), "%.*e", decimals, value);
+            char* exponent = strchr(scientific, 'e');
+            const int power = atoi(exponent + 1);
+            *exponent = 0;
+            ImFormatString(number, IM_ARRAYSIZE(number), "%se%+d", scientific, power);
+            if (digits(number) == 4) break;
+        }
+    const char* suffix = ImParseFormatFindEnd(ImParseFormatFindStart(format));
+    return ImFormatString(buffer, size, "%s%s%s", number[0] != '-' && strchr(format, '+') ? "+" : "", number, suffix);
+}
