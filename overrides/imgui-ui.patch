+        3.0f * (square_sz + style.ItemSpacing.y);
+    if (has_visible_label)
+        expected_outer_height += g.FontSize + style.ItemSpacing.y;
+
+    const ImGuiID popup_id = parent_window->GetID("picker");
+    char popup_name[20];
+    ImFormatString(
+        popup_name,
+        IM_ARRAYSIZE(popup_name),
+        "##Popup_%08x",
+        popup_id);
+    if (ImGuiWindow* popup_window = ImGui::FindWindowByName(popup_name))
