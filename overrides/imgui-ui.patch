+static void AnimateSliderGrab(
+    ImGuiWindow* window,
+    ImGuiContext& g,
+    ImGuiID id,
+    ImGuiAxis axis,
+    ImRect* grab_bb)
+{
+    if (grab_bb->Max[axis] <= grab_bb->Min[axis])
+        return;
+
+    ImGuiStorage& storage = window->StateStorage;
+    const ImGuiID animation_key = ImHashStr(
+        "##SliderGrabAnimation",
+        0,
+        id);
+    const ImGuiID animation_frame_key = ImHashStr(
+        "##SliderGrabAnimationFrame",
+        0,
+        id);
+    const float target_position =
+        (grab_bb->Min[axis] + grab_bb->Max[axis]) * 0.5f;
+    float animated_position = storage.GetFloat(
+        animation_key,
+        target_position);
+    const int last_animation_frame = storage.GetInt(
+        animation_frame_key,
+        -2);
+    if (!g.UvsrUiMotionEnabled ||
+        g.ActiveId == id ||
+        last_animation_frame < g.FrameCount - 1)
+    {
+        animated_position = target_position;
+    }
+    else if (last_animation_frame != g.FrameCount)
+    {
+        const float delta_time = ImClamp(
+            g.IO.DeltaTime,
+            0.0f,
+            1.0f / 30.0f);
+        const float animation_half_life = 0.040f;
+        const float animation_blend = 1.0f - ImPow(
+            2.0f,
+            -delta_time / animation_half_life);
+        animated_position = ImLerp(
+            animated_position,
+            target_position,
+            animation_blend);
+        if (ImFabs(target_position - animated_position) < 0.25f)
+            animated_position = target_position;
+    }
+    storage.SetFloat(animation_key, animated_position);
+    storage.SetInt(animation_frame_key, g.FrameCount);
+
+    const float offset = animated_position - target_position;
+    grab_bb->Min[axis] += offset;
+    grab_bb->Max[axis] += offset;
+}
