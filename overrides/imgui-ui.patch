+static void RenderUvsrRoundedMarkersForVerticalBar(ImDrawList* draw_list, ImVec2 pos, ImVec2 half_sz, float bar_w, float alpha)
+{
+    const ImU32 alpha8 = IM_F32_TO_INT8_SAT(alpha);
+    const ImVec2 outer_half(half_sz.x + 2.0f, half_sz.y + 1.0f);
+    const ImVec2 left_outer_tip(pos.x + half_sz.x + 1.0f, pos.y);
+    const ImVec2 left_inner_tip(pos.x + half_sz.x, pos.y);
