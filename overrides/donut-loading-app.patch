+bool ApplicationBase::ProcessPendingSceneRetirement(
+    nvrhi::IFramebuffer* framebuffer)
+{
+    if (m_SceneRetirementState == SceneRetirementState::Idle)
+        return false;
+
+    if (m_SceneRetirementState == SceneRetirementState::ArmQuery)
+    {
+        if (!m_SceneRetirementQuery)
+            m_SceneRetirementQuery = GetDevice()->createEventQuery();
+
+        if (m_SceneRetirementQuery)
+        {
+            GetDevice()->resetEventQuery(m_SceneRetirementQuery);
+            GetDevice()->setEventQuery(
+                m_SceneRetirementQuery,
+                nvrhi::CommandQueue::Graphics);
+            m_SceneRetirementState =
+                SceneRetirementState::WaitForQuery;
+            RenderSplashScreen(framebuffer);
+            return true;
+        }
+
+        // Event-query allocation failure is exceptional. Preserve correctness
+        // with the old blocking path rather than freeing in-flight resources.
+        GetDevice()->waitForIdle();
+    }
+    else if (!GetDevice()->pollEventQuery(m_SceneRetirementQuery))
+    {
+        RenderSplashScreen(framebuffer);
+        return true;
+    }
+
+    if (m_SceneRetirementQuery)
+        GetDevice()->resetEventQuery(m_SceneRetirementQuery);
+    SceneUnloading();
+    if (m_TextureCache)
+        m_TextureCache->Reset();
+    GetDevice()->runGarbageCollection();
+    m_HasSceneResources = false;
+    StartPendingSceneLoad();
+    RenderSplashScreen(framebuffer);
+    return true;
+}
