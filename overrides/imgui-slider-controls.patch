+struct UvsrSliderValueLane
+{
+    bool Usable;
+    ImRect TrackRect;
+    ImRect ValueRect;
+};
+
+static UvsrSliderValueLane ResolveUvsrSliderValueLane(
+    const ImRect& slider_bb,
+    const float frame_height)
+{
+    const float value_width =
+        GetUvsrAuthoredToggleTrackWidth() * 2.0f;
+    constexpr float BubbleGap = 2.0f;
+    const float track_width =
+        slider_bb.GetWidth() - value_width - BubbleGap;
+    if (track_width < frame_height)
+    {
+        return { false, slider_bb, ImRect() };
+    }
+    ImRect track_rect = slider_bb;
+    ImRect value_rect = slider_bb;
+    value_rect.Min.x = value_rect.Max.x - value_width;
+    track_rect.Max.x = value_rect.Min.x - BubbleGap;
+    return { true, track_rect, value_rect };
+}
+
+static double GetUvsrSliderNumericValue(
+    ImGuiDataType data_type,
+    const void* data)
+{
+    switch (data_type)
+    {
+    case ImGuiDataType_S8: return double(*(const ImS8*)data);
+    case ImGuiDataType_U8: return double(*(const ImU8*)data);
+    case ImGuiDataType_S16: return double(*(const ImS16*)data);
+    case ImGuiDataType_U16: return double(*(const ImU16*)data);
+    case ImGuiDataType_S32: return double(*(const ImS32*)data);
+    case ImGuiDataType_U32: return double(*(const ImU32*)data);
+    case ImGuiDataType_S64: return double(*(const ImS64*)data);
+    case ImGuiDataType_U64: return double(*(const ImU64*)data);
+    case ImGuiDataType_Float: return double(*(const float*)data);
+    case ImGuiDataType_Double: return *(const double*)data;
+    case ImGuiDataType_COUNT: break;
+    }
+    return 0.0;
+}
+
+static const char* GetUvsrSliderExactInputFormat(
+    ImGuiDataType data_type)
+{
+    if (data_type == ImGuiDataType_Float)
+        return "%.9g";
+    if (data_type == ImGuiDataType_Double)
+        return "%.17g";
+    return ImGui::DataTypeGetInfo(data_type)->PrintFmt;
+}
+
+static int CountUvsrNumericDigits(const char* text)
+{
+    int count = 0;
+    for (const char* cursor = text; *cursor != 0; ++cursor)
+        if (*cursor >= '0' && *cursor <= '9')
+            ++count;
+    return count;
+}
+
+static int FormatUvsrFourDigitSliderValue(
+    char* output,
+    size_t output_size,
+    ImGuiDataType data_type,
+    const void* data)
+{
+    double value = GetUvsrSliderNumericValue(data_type, data);
+    if (!(value >= -DBL_MAX && value <= DBL_MAX))
+        return ImFormatString(output, output_size, "----");
+    if (value == 0.0)
+        value = 0.0; // Normalize negative zero.
+
+    const double absolute_value = fabs(value);
+    const int integer_digits = absolute_value >= 1.0
+        ? int(floor(log10(absolute_value))) + 1
+        : 1;
+    const int fixed_precision = ImMax(0, 4 - integer_digits);
+    char fixed[64];
+    for (int precision = fixed_precision;
+        precision >= 0;
+        --precision)
+    {
+        ImFormatString(
+            fixed,
+            IM_ARRAYSIZE(fixed),
+            "%.*f",
+            precision,
+            value);
+        if (CountUvsrNumericDigits(fixed) == 4)
+            return ImFormatString(output, output_size, "%s", fixed);
+    }
+    return ImFormatString(output, output_size, "----");
+}
