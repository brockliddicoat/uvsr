+static ImGuiID GetUvsrTooltipOwnerId()
+{
+    ImGuiContext& g = *GImGui;
+    ImGuiWindow* window = g.CurrentWindow;
+    ImGuiID owner_id = g.LastItemData.ID;
+    if (owner_id == 0)
+    {
+        const float owner_rect[4] = {
+            g.LastItemData.Rect.Min.x,
+            g.LastItemData.Rect.Min.y,
+            g.LastItemData.Rect.Max.x,
+            g.LastItemData.Rect.Max.y
+        };
+        owner_id = ImHashData(
+            owner_rect,
+            sizeof(owner_rect),
+            window != NULL ? window->ID : 0);
+    }
+    return owner_id != 0 ? owner_id : ImGuiID(1);
+}
+
+static void ResetUvsrTooltipAnimation(ImGuiUvsrTooltipState& state)
+{
+    state = ImGuiUvsrTooltipState();
+}
+
+static void UpdateUvsrTooltipAppearance(
+    ImGuiUvsrTooltipState& state,
+    bool target_visible)
+{
+    ImGuiContext& g = *GImGui;
+    if (!g.UvsrUiMotionEnabled)
+    {
+        state.Appearance = target_visible ? 1.0f : 0.0f;
+        state.FrameStartAppearance = state.Appearance;
+        state.LastAdvancedFrame = g.FrameCount;
+        return;
+    }
+    if (state.LastAdvancedFrame != g.FrameCount)
+    {
+        state.FrameStartAppearance = state.Appearance;
+        state.LastAdvancedFrame = g.FrameCount;
+    }
+    constexpr float duration = 0.18f;
+    const float step = ImMin(g.IO.DeltaTime, 1.0f / 30.0f) / duration;
+    state.Appearance = target_visible
+        ? ImMin(1.0f, state.FrameStartAppearance + step)
+        : ImMax(0.0f, state.FrameStartAppearance - step);
+}
+
+static void ApplyUvsrTooltipAppearance(
+    ImGuiWindow* tooltip_window,
+    float appearance)
+{
+    if (tooltip_window == NULL)
+        return;
+    const float eased = appearance * appearance *
+        (3.0f - 2.0f * appearance);
+    const float scale = ImLerp(0.86f, 1.0f, eased);
+    const ImVec2 pivot = tooltip_window->Pos;
+    for (ImDrawVert& vertex : tooltip_window->DrawList->VtxBuffer)
+    {
+        vertex.pos = pivot + (vertex.pos - pivot) * scale;
+        const ImU32 alpha =
+            (vertex.col >> IM_COL32_A_SHIFT) & 0xFFu;
+        const ImU32 faded_alpha = (ImU32)ImClamp(
+            IM_ROUND((float)alpha * eased), 0.0f, 255.0f);
+        vertex.col = (vertex.col & ~IM_COL32_A_MASK) |
+            (faded_alpha << IM_COL32_A_SHIFT);
+    }
+}
+
+static void SubmitUvsrItemTooltipV(const char* fmt, va_list args)
+{
+    ImGuiContext& g = *GImGui;
+    ImGuiUvsrTooltipState& state = g.UvsrTooltipState;
+    if (g.DragDropActive)
+    {
+        ResetUvsrTooltipAnimation(state);
+        return;
+    }
+    const ImGuiID owner_id = GetUvsrTooltipOwnerId();
+    const bool hovered = ImGui::IsItemHovered(ImGuiHoveredFlags_ForTooltip);
+    if (!hovered && state.OwnerId != owner_id)
+        return;
+    if (hovered)
+        state.OwnerId = owner_id;
+    state.LastOwnerSeenFrame = g.FrameCount;
+    UpdateUvsrTooltipAppearance(state, hovered);
+    if (!hovered && state.Appearance <= 0.0f)
+    {
+        ResetUvsrTooltipAnimation(state);
+        return;
+    }
+    if (!ImGui::BeginTooltipEx(
+            ImGuiTooltipFlags_OverridePrevious,
+            ImGuiWindowFlags_None))
+        return;
+    ImGuiWindow* tooltip_window = ImGui::GetCurrentWindow();
+    ImGui::TextV(fmt, args);
+    ImGui::EndTooltip();
+    ApplyUvsrTooltipAppearance(tooltip_window, state.Appearance);
+    state.LastSubmittedWindow = tooltip_window;
+    state.LastSubmittedFrame = g.FrameCount;
+}
+
+static void FinalizeUvsrTooltipAnimationFrame()
+{
+    ImGuiContext& g = *GImGui;
+    ImGuiUvsrTooltipState& state = g.UvsrTooltipState;
+    if (state.OwnerId == 0)
+        return;
+    if (g.UvsrStockWidgetRendering ||
+        g.DragDropActive ||
+        state.LastOwnerSeenFrame != g.FrameCount)
+    {
+        if (g.DragDropActive &&
+            state.LastSubmittedFrame == g.FrameCount &&
+            g.TooltipPreviousWindow == state.LastSubmittedWindow)
+        {
+            ImGui::SetWindowHiddenAndSkipItemsForCurrentFrame(
+                state.LastSubmittedWindow);
+        }
+        ResetUvsrTooltipAnimation(state);
+    }
+}
