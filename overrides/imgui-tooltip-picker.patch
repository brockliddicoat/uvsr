+static void AddUvsrRoundedPointerTriangle(
+    ImDrawList* draw_list,
+    const ImVec2& tip,
+    const ImVec2& base_top,
+    const ImVec2& base_bottom,
+    ImU32 color,
+    float rounding)
+{
+    if ((color & IM_COL32_A_MASK) == 0)
+        return;
+    const ImVec2 points[3] = { tip, base_top, base_bottom };
+    ImVec2 incoming[3];
+    ImVec2 outgoing[3];
+    for (int point_index = 0; point_index < 3; ++point_index)
+    {
+        const ImVec2& point = points[point_index];
+        const ImVec2& previous = points[(point_index + 2) % 3];
+        const ImVec2& next = points[(point_index + 1) % 3];
+        const ImVec2 to_previous = previous - point;
+        const ImVec2 to_next = next - point;
+        const float previous_length = ImSqrt(ImLengthSqr(to_previous));
+        const float next_length = ImSqrt(ImLengthSqr(to_next));
+        const float tangent_distance = ImMin(
+            ImMax(rounding, 0.0f),
+            ImMin(previous_length, next_length) * 0.30f);
+        incoming[point_index] = point +
+            to_previous * (tangent_distance /
+                ImMax(previous_length, FLT_EPSILON));
+        outgoing[point_index] = point +
+            to_next * (tangent_distance /
+                ImMax(next_length, FLT_EPSILON));
+    }
+
+    draw_list->PathClear();
+    draw_list->PathLineTo(incoming[0]);
+    for (int point_index = 0; point_index < 3; ++point_index)
+    {
+        if (point_index > 0)
+            draw_list->PathLineTo(incoming[point_index]);
+        draw_list->PathBezierQuadraticCurveTo(
+            points[point_index],
+            outgoing[point_index],
+            4);
+    }
+    draw_list->PathFillConvex(color);
+}
+
+static void AddUvsrCarvedRoundedPointerTriangle(
+    ImDrawList* draw_list,
+    const ImVec2& tip,
+    const ImVec2& base_top,
+    const ImVec2& base_bottom,
+    float rounding)
+{
+    const int vertex_start = draw_list->VtxBuffer.Size;
+    AddUvsrRoundedPointerTriangle(
+        draw_list,
+        tip,
+        base_top,
+        base_bottom,
+        IM_COL32_WHITE,
+        rounding);
+    const int vertex_end = draw_list->VtxBuffer.Size;
+    const float minimum_y = ImMin(tip.y, ImMin(base_top.y, base_bottom.y));
+    const float gradient_extent = ImMax(
+        ImMax(tip.y, ImMax(base_top.y, base_bottom.y)) - minimum_y,
+        1.0f);
+    for (int vertex_index = vertex_start;
+        vertex_index < vertex_end;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = draw_list->VtxBuffer[vertex_index];
+        const float coverage =
+            float((vertex.col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT) /
+            255.0f;
+        vertex.col = ImGui::GetUvsrCarvedFrameOutlineColor(
+            (vertex.pos.y - minimum_y) / gradient_extent,
+            coverage);
+    }
+}
