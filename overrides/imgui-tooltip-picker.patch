+static void DrawUvsrColorPickerSourcePointer(
+    ImGuiWindow* parent_window,
+    ImGuiWindow* popup_window,
+    const ImRect& source_rect,
+    const ImGuiUvsrColorPickerPopupScope& scope,
+    float square_sz,
+    float transition_amount)
+{
+    if (parent_window == NULL ||
+        popup_window == NULL ||
+        source_rect.IsInverted())
+    {
+        return;
+    }
+
+    ImGuiContext& g = *GImGui;
+    const ImGuiStyle& style = g.Style;
+    ImDrawList* draw_list = popup_window->DrawList;
+    const float fringe = ImMax(1.0f, draw_list->_FringeScale);
+    const float eased = transition_amount * transition_amount *
+        (3.0f - 2.0f * transition_amount);
+    const float scale = ImLerp(0.86f, 1.0f, eased);
+    const float unscaled_arrow_half =
+        ImMax(fringe * 3.0f, square_sz * 0.30f);
+    const float arrow_half = unscaled_arrow_half * scale;
+    const float tip_x = source_rect.Max.x +
+        ImMax(fringe, style.ItemInnerSpacing.x * 0.25f);
+    const float base_x = popup_window->Pos.x + (fringe + 1.0f) * scale;
+    if (tip_x >= popup_window->Pos.x || base_x - tip_x < fringe * 2.0f)
+        return;
+
+    const float popup_top = popup_window->Pos.y;
+    const float popup_bottom = popup_window->Pos.y + popup_window->Size.y;
+    const float unscaled_base_y = ImClamp(
+        source_rect.GetCenter().y,
+        popup_top + style.PopupRounding + unscaled_arrow_half + fringe,
+        popup_bottom - style.PopupRounding - unscaled_arrow_half - fringe);
+    const float base_y = popup_bottom +
+        (unscaled_base_y - popup_bottom) * scale;
+    ImRect allowed = ImGui::GetPopupAllowedExtentRect(parent_window);
+    allowed.Max.y = ImMin(allowed.Max.y, scope.MaximumBottom);
+    draw_list->PushClipRect(allowed.Min, allowed.Max, false);
+
+    const int pointer_vertex_start = draw_list->VtxBuffer.Size;
+    const float rounding = ImMin(
+        style.FrameRounding * scale,
+        arrow_half * 0.75f);
+    AddUvsrCarvedRoundedPointerTriangle(
+        draw_list,
+        ImVec2(tip_x, source_rect.GetCenter().y),
+        ImVec2(base_x, base_y - arrow_half),
+        ImVec2(base_x, base_y + arrow_half),
+        rounding);
+    const float inner_inset = fringe * scale;
+    AddUvsrRoundedPointerTriangle(
+        draw_list,
+        ImVec2(tip_x + inner_inset, source_rect.GetCenter().y),
+        ImVec2(base_x + inner_inset, base_y - arrow_half + inner_inset),
+        ImVec2(base_x + inner_inset, base_y + arrow_half - inner_inset),
+        ImGui::GetColorU32(scope.PopupBackground),
+        ImMax(0.0f, rounding - inner_inset));
+    for (int vertex_index = pointer_vertex_start;
+        vertex_index < draw_list->VtxBuffer.Size;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = draw_list->VtxBuffer[vertex_index];
+        const ImU32 alpha = (vertex.col & IM_COL32_A_MASK) >>
+            IM_COL32_A_SHIFT;
+        const ImU32 faded_alpha = (ImU32)(alpha * eased + 0.5f);
+        vertex.col = (vertex.col & ~IM_COL32_A_MASK) |
+            (faded_alpha << IM_COL32_A_SHIFT);
+    }
+    draw_list->PopClipRect();
 }
 
