+static void ResetUvsrColorPickerPopupTransition(ImGuiContext& g)
+{
+    g.UvsrColorPickerPopupTransition =
+        ImGuiUvsrColorPickerPopupTransition();
+}
+
+static void BeginUvsrColorPickerPopupTransition(
+    ImGuiContext& g,
+    ImGuiID popup_id,
+    int open_frame,
+    const ImRect& source_rect)
+{
+    ImGuiUvsrColorPickerPopupTransition& transition =
+        g.UvsrColorPickerPopupTransition;
+    if (transition.PopupId != popup_id || transition.OpenFrame != open_frame)
+    {
+        transition = ImGuiUvsrColorPickerPopupTransition();
+        transition.PopupId = popup_id;
+        transition.OpenFrame = open_frame;
+        transition.TargetOpen = true;
+        transition.Amount = g.UvsrUiMotionEnabled ? 0.0f : 1.0f;
+        transition.FrameStartAmount = transition.Amount;
+    }
+    transition.SourceRect = source_rect;
+}
+
+static void AdvanceUvsrColorPickerPopupTransition(ImGuiContext& g)
+{
+    ImGuiUvsrColorPickerPopupTransition& transition =
+        g.UvsrColorPickerPopupTransition;
+    if (!g.UvsrUiMotionEnabled || g.UvsrStockWidgetRendering)
+    {
+        transition.Amount = transition.TargetOpen ? 1.0f : 0.0f;
+        return;
+    }
+    if (transition.LastAdvancedFrame != g.FrameCount)
+    {
+        transition.FrameStartAmount = transition.Amount;
+        transition.LastAdvancedFrame = g.FrameCount;
+    }
+    const float step = ImMin(g.IO.DeltaTime, 1.0f / 30.0f) / 0.18f;
+    transition.Amount = transition.TargetOpen
+        ? ImMin(1.0f, transition.FrameStartAmount + step)
+        : ImMax(0.0f, transition.FrameStartAmount - step);
+    if (!transition.TargetOpen && transition.Amount <= 0.0f &&
+        transition.ZeroFrame < 0)
+        transition.ZeroFrame = g.FrameCount;
+}
+
+static void ApplyUvsrColorPickerPopupTransition(
+    ImGuiWindow* popup_window,
+    float amount)
+{
+    if (popup_window == NULL)
+        return;
+    const float eased = amount * amount * (3.0f - 2.0f * amount);
+    const float scale = ImLerp(0.86f, 1.0f, eased);
+    const ImVec2 pivot(
+        popup_window->Pos.x,
+        popup_window->Pos.y + popup_window->Size.y);
+    ImDrawList* draw_list = popup_window->DrawList;
+    for (ImDrawVert& vertex : draw_list->VtxBuffer)
+    {
+        vertex.pos = pivot + (vertex.pos - pivot) * scale;
+        const ImU32 alpha =
+            (vertex.col >> IM_COL32_A_SHIFT) & 0xFFu;
+        const ImU32 faded_alpha = (ImU32)ImClamp(
+            IM_ROUND((float)alpha * eased), 0.0f, 255.0f);
+        vertex.col = (vertex.col & ~IM_COL32_A_MASK) |
+            (faded_alpha << IM_COL32_A_SHIFT);
+    }
+    for (ImDrawCmd& command : draw_list->CmdBuffer)
+    {
+        ImVec2 clip_min(command.ClipRect.x, command.ClipRect.y);
+        ImVec2 clip_max(command.ClipRect.z, command.ClipRect.w);
+        clip_min = pivot + (clip_min - pivot) * scale;
+        clip_max = pivot + (clip_max - pivot) * scale;
+        command.ClipRect = ImVec4(
+            clip_min.x, clip_min.y, clip_max.x, clip_max.y);
+    }
+}
