+static void DrawUvsrColorPickerCarvedOutline(
+    ImDrawList* draw_list,
+    const ImRect& bounds,
+    float requested_rounding)
+{
+    if (draw_list == NULL ||
+        bounds.GetWidth() <= 1.0f ||
+        bounds.GetHeight() <= 1.0f)
+    {
+        return;
+    }
+
+    constexpr float outline_inset = 0.5f;
+    const ImRect outline_bounds(
+        bounds.Min + ImVec2(outline_inset, outline_inset),
+        bounds.Max - ImVec2(outline_inset, outline_inset));
+    const float rounding = ResolveUvsrColorPickerRoundedRectRadius(
+        outline_bounds,
+        ImMax(0.0f, requested_rounding - outline_inset));
+    const int outline_start = draw_list->VtxBuffer.Size;
+    draw_list->AddRect(
+        outline_bounds.Min,
+        outline_bounds.Max,
+        IM_COL32_WHITE,
+        rounding,
+        ImDrawFlags_RoundCornersAll,
+        1.0f);
+    const int outline_end = draw_list->VtxBuffer.Size;
+    const float gradient_extent = ImMax(outline_bounds.GetHeight(), 1.0f);
+    for (int vertex_index = outline_start;
+        vertex_index < outline_end;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = draw_list->VtxBuffer[vertex_index];
+        const float coverage =
+            float((vertex.col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT) /
+            255.0f;
+        vertex.col = ImGui::GetUvsrCarvedFrameOutlineColor(
+            (vertex.pos.y - outline_bounds.Min.y) / gradient_extent,
+            coverage);
+    }
+}
