+void ImGui::ClosePopupToLevel(int remaining, bool restore_focus_to_window_under_popup)
+{
+    ImGuiContext& g = *GImGui;
+    IM_ASSERT(remaining >= 0 && remaining < g.OpenPopupStack.Size);
+    ImGuiUvsrColorPickerPopupTransition& transition =
+        g.UvsrColorPickerPopupTransition;
+    if (!g.UvsrColorPickerPopupCloseBypass &&
+        g.UvsrUiMotionEnabled &&
+        !g.UvsrStockWidgetRendering &&
+        transition.PopupId != 0 &&
+        g.OpenPopupStack[remaining].PopupId == transition.PopupId &&
+        remaining + 1 == g.OpenPopupStack.Size)
+    {
+        if (transition.ReopenFrame != g.FrameCount)
+        {
+            transition.TargetOpen = false;
+            transition.RestoreFocus |= restore_focus_to_window_under_popup;
+            transition.ZeroFrame = -1;
+            if (g.ActiveIdWindow == g.OpenPopupStack[remaining].Window)
+                ClearActiveID();
+        }
+        return;
+    }
+    ClosePopupToLevelImmediately(remaining, restore_focus_to_window_under_popup);
+}
