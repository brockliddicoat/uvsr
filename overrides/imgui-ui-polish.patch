+void ImGui::BeginUvsrTreeArrowCapture()
+{
+    ImGuiContext& g = *GImGui;
+    g.UvsrTreeArrowCapture = ImGuiUvsrTreeArrowCapture{};
+    g.UvsrTreeArrowCapture.Armed = true;
+    g.UvsrTreeArrowCapture.Frame = g.FrameCount;
+}
+
+void ImGui::EndUvsrTreeArrowCapture(float open_amount, bool upside_down)
+{
+    ImGuiContext& g = *GImGui;
+    const ImGuiUvsrTreeArrowCapture capture = g.UvsrTreeArrowCapture;
+    g.UvsrTreeArrowCapture = ImGuiUvsrTreeArrowCapture{};
+    if (capture.Frame != g.FrameCount ||
+        capture.DrawList == NULL ||
+        capture.VertexEnd <= capture.VertexStart)
+    {
+        return;
+    }
+
+    float source_angle = 0.0f;
+    if (capture.SourceDirection == ImGuiDir_Down)
+        source_angle = IM_PI * 0.5f;
+    else if (capture.SourceDirection == ImGuiDir_Up)
+        source_angle = -IM_PI * 0.5f;
+    else if (capture.SourceDirection == ImGuiDir_Left)
+        source_angle = IM_PI;
+    const float target_angle =
+        ImSaturate(open_amount) *
+        (upside_down ? -IM_PI * 0.5f : IM_PI * 0.5f);
+    const float rotation = target_angle - source_angle;
+    const float cosine = ImCos(rotation);
+    const float sine = ImSin(rotation);
+    const int vertex_end = ImMin(
+        capture.VertexEnd,
+        capture.DrawList->VtxBuffer.Size);
+    for (int vertex_index = ImMax(0, capture.VertexStart);
+        vertex_index < vertex_end;
+        ++vertex_index)
+    {
+        ImDrawVert& vertex = capture.DrawList->VtxBuffer[vertex_index];
+        const ImVec2 offset = vertex.pos - capture.Center;
+        vertex.pos = capture.Center + ImVec2(
+            offset.x * cosine - offset.y * sine,
+            offset.x * sine + offset.y * cosine);
+    }
+}
