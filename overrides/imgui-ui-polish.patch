+struct UvsrRoundedTriangleSelector
+{
+    ImVec2 SharpVertices[3];
+    ImVec2 Center;
+    ImVector<ImVec2> Contour;
+    float EndpointSnapDistance = 1.0f;
+};
+
+static float UvsrTriangleCross(const ImVec2& first, const ImVec2& second)
+{
+    return first.x * second.y - first.y * second.x;
+}
+
+static float GetUvsrRayPolygonBoundaryDistance(
+    const ImVec2& center,
+    const ImVec2& direction,
+    const ImVec2* points,
+    int point_count)
+{
+    const float direction_length_squared = ImLengthSqr(direction);
+    if (direction_length_squared <= FLT_EPSILON || point_count < 3)
+        return 0.0f;
+
+    const ImVec2 unit_direction = direction /
+        ImSqrt(direction_length_squared);
+    float boundary_distance = FLT_MAX;
+    for (int point_index = 0; point_index < point_count; ++point_index)
+    {
+        const ImVec2 first = points[point_index];
+        const ImVec2 second = points[(point_index + 1) % point_count];
+        const ImVec2 edge = second - first;
+        const float denominator = UvsrTriangleCross(unit_direction, edge);
+        if (ImAbs(denominator) <= FLT_EPSILON)
+            continue;
+
+        const ImVec2 delta = first - center;
+        const float distance = UvsrTriangleCross(delta, edge) / denominator;
+        const float edge_amount =
+            UvsrTriangleCross(delta, unit_direction) / denominator;
+        if (distance >= 0.0f &&
+            edge_amount >= -0.0001f &&
+            edge_amount <= 1.0001f)
+        {
+            boundary_distance = ImMin(boundary_distance, distance);
+        }
+    }
+    return boundary_distance < FLT_MAX ? boundary_distance : 0.0f;
+}
+
+static void BuildUvsrRoundedTriangleSelector(
+    UvsrRoundedTriangleSelector& selector,
+    ImDrawList* draw_list,
+    const ImVec2& hue_vertex,
+    const ImVec2& black_vertex,
+    const ImVec2& white_vertex,
+    float rounding,
+    float endpoint_snap_distance)
+{
+    selector.SharpVertices[0] = hue_vertex;
+    selector.SharpVertices[1] = black_vertex;
+    selector.SharpVertices[2] = white_vertex;
+    selector.Center =
+        (hue_vertex + black_vertex + white_vertex) / 3.0f;
+    selector.EndpointSnapDistance = ImMax(1.0f, endpoint_snap_distance);
+
+    float minimum_edge_length = FLT_MAX;
+    for (int vertex_index = 0; vertex_index < 3; ++vertex_index)
+    {
+        minimum_edge_length = ImMin(
+            minimum_edge_length,
+            ImSqrt(ImLengthSqr(
+                selector.SharpVertices[(vertex_index + 1) % 3] -
+                selector.SharpVertices[vertex_index])));
+    }
+    const float tangent_distance = ImClamp(
+        ImMax(rounding, 0.0f) * 1.75f,
+        0.0f,
+        minimum_edge_length * 0.20f);
+    if (tangent_distance <= FLT_EPSILON)
+    {
+        for (const ImVec2& vertex : selector.SharpVertices)
+            selector.Contour.push_back(vertex);
+        return;
+    }
+
+    int corner_sections = ImClamp(
+        draw_list->_CalcCircleAutoSegmentCount(ImMax(rounding, 1.0f)) / 3,
+        4,
+        24);
+    if ((corner_sections & 1) != 0)
+        ++corner_sections;
+    for (int vertex_index = 0; vertex_index < 3; ++vertex_index)
+    {
+        const ImVec2 vertex = selector.SharpVertices[vertex_index];
+        const ImVec2 previous =
+            selector.SharpVertices[(vertex_index + 2) % 3];
+        const ImVec2 next =
+            selector.SharpVertices[(vertex_index + 1) % 3];
+        const float previous_length = ImMax(
+            ImSqrt(ImLengthSqr(previous - vertex)),
+            FLT_EPSILON);
+        const float next_length = ImMax(
+            ImSqrt(ImLengthSqr(next - vertex)),
+            FLT_EPSILON);
+        const ImVec2 entry = vertex +
+            (previous - vertex) * (tangent_distance / previous_length);
+        const ImVec2 exit = vertex +
+            (next - vertex) * (tangent_distance / next_length);
+        for (int section = 0; section <= corner_sections; ++section)
+        {
+            const float amount =
+                (float)section / (float)corner_sections;
+            const float inverse_amount = 1.0f - amount;
+            selector.Contour.push_back(
+                entry * (inverse_amount * inverse_amount) +
+                vertex * (2.0f * inverse_amount * amount) +
+                exit * (amount * amount));
+        }
+    }
+}
+
+static ImVec2 MapUvsrSharpPointToRoundedTriangle(
+    const UvsrRoundedTriangleSelector& selector,
+    const ImVec2& sharp_position)
+{
+    const ImVec2 direction = sharp_position - selector.Center;
+    if (ImLengthSqr(direction) <= FLT_EPSILON)
+        return selector.Center;
+
+    const float sharp_boundary = GetUvsrRayPolygonBoundaryDistance(
+        selector.Center,
+        direction,
+        selector.SharpVertices,
+        IM_ARRAYSIZE(selector.SharpVertices));
+    const float rounded_boundary = GetUvsrRayPolygonBoundaryDistance(
+        selector.Center,
+        direction,
+        selector.Contour.Data,
+        selector.Contour.Size);
+    if (sharp_boundary <= FLT_EPSILON || rounded_boundary <= FLT_EPSILON)
+        return sharp_position;
+    return selector.Center +
+        direction * (rounded_boundary / sharp_boundary);
+}
+
+static ImVec2 MapUvsrSvToRoundedTriangle(
+    const UvsrRoundedTriangleSelector& selector,
+    float saturation,
+    float value)
+{
+    saturation = ImSaturate(saturation);
+    value = ImSaturate(value);
+    const ImVec2 sharp_position = ImLerp(
+        ImLerp(
+            selector.SharpVertices[2],
+            selector.SharpVertices[0],
+            saturation),
+        selector.SharpVertices[1],
+        1.0f - value);
+    return MapUvsrSharpPointToRoundedTriangle(selector, sharp_position);
+}
+
+static bool MapUvsrRoundedTriangleToSv(
+    const UvsrRoundedTriangleSelector& selector,
+    const ImVec2& position,
+    bool clamp_to_selector,
+    float* saturation,
+    float* value)
+{
+    const ImVec2 endpoint_positions[3] = {
+        MapUvsrSharpPointToRoundedTriangle(
+            selector,
+            selector.SharpVertices[0]),
+        MapUvsrSharpPointToRoundedTriangle(
+            selector,
+            selector.SharpVertices[1]),
+        MapUvsrSharpPointToRoundedTriangle(
+            selector,
+            selector.SharpVertices[2])
+    };
+    const float snap_distance_squared =
+        selector.EndpointSnapDistance * selector.EndpointSnapDistance;
+    if (ImLengthSqr(position - endpoint_positions[0]) <=
+        snap_distance_squared)
+    {
+        *saturation = 1.0f;
+        *value = 1.0f;
+        return true;
+    }
+    if (ImLengthSqr(position - endpoint_positions[1]) <=
+        snap_distance_squared)
+    {
+        *saturation = 0.0f;
+        *value = 0.0f;
+        return true;
+    }
+    if (ImLengthSqr(position - endpoint_positions[2]) <=
+        snap_distance_squared)
+    {
+        *saturation = 0.0f;
+        *value = 1.0f;
+        return true;
+    }
+
+    const ImVec2 direction = position - selector.Center;
+    const float position_distance = ImSqrt(ImLengthSqr(direction));
+    ImVec2 sharp_position = selector.Center;
+    if (position_distance > FLT_EPSILON)
+    {
+        const float rounded_boundary = GetUvsrRayPolygonBoundaryDistance(
+            selector.Center,
+            direction,
+            selector.Contour.Data,
+            selector.Contour.Size);
+        if (rounded_boundary <= FLT_EPSILON ||
+            (!clamp_to_selector &&
+                position_distance > rounded_boundary +
+                    selector.EndpointSnapDistance))
+        {
+            return false;
+        }
+        const float sharp_boundary = GetUvsrRayPolygonBoundaryDistance(
+            selector.Center,
+            direction,
+            selector.SharpVertices,
+            IM_ARRAYSIZE(selector.SharpVertices));
+        const float clamped_distance =
+            ImMin(position_distance, rounded_boundary);
+        sharp_position = selector.Center +
+            direction *
+                (clamped_distance / position_distance) *
+                (sharp_boundary / ImMax(rounded_boundary, FLT_EPSILON));
+    }
+
+    float hue_weight = 0.0f;
+    float black_weight = 0.0f;
+    float white_weight = 0.0f;
+    ImTriangleBarycentricCoords(
+        selector.SharpVertices[0],
+        selector.SharpVertices[1],
+        selector.SharpVertices[2],
+        sharp_position,
+        hue_weight,
+        black_weight,
+        white_weight);
+    hue_weight = ImMax(hue_weight, 0.0f);
+    black_weight = ImMax(black_weight, 0.0f);
+    white_weight = ImMax(white_weight, 0.0f);
+    const float weight_sum = ImMax(
+        hue_weight + black_weight + white_weight,
+        FLT_EPSILON);
+    hue_weight /= weight_sum;
+    black_weight /= weight_sum;
+    white_weight /= weight_sum;
+    *value = ImSaturate(1.0f - black_weight);
+    *saturation = *value > FLT_EPSILON
+        ? ImSaturate(hue_weight / *value)
+        : 0.0f;
+    return true;
+}
+
+static ImVec2 TransformUvsrRoundedTrianglePoint(
+    const ImVec2& local_position,
+    const ImVec2& origin,
+    float cosine,
+    float sine)
+{
+    return origin + ImVec2(
+        local_position.x * cosine - local_position.y * sine,
+        local_position.x * sine + local_position.y * cosine);
+}
+
+static void AddUvsrRoundedTriangleSelector(
+    ImDrawList* draw_list,
+    const UvsrRoundedTriangleSelector& selector,
+    const ImVec2& origin,
+    float cosine,
+    float sine,
+    float hue,
+    float alpha,
+    ImU32 border_color)
+{
+    float maximum_edge_length = 0.0f;
+    for (int vertex_index = 0; vertex_index < 3; ++vertex_index)
+    {
+        maximum_edge_length = ImMax(
+            maximum_edge_length,
+            ImSqrt(ImLengthSqr(
+                selector.SharpVertices[(vertex_index + 1) % 3] -
+                selector.SharpVertices[vertex_index])));
+    }
+    const float maximum_mesh_step = ImMax(
+        1.5f,
+        draw_list->_FringeScale * 1.5f);
+    const int sections = ImClamp(
+        (int)ImCeil(maximum_edge_length / maximum_mesh_step),
+        24,
+        192);
+    const int vertex_count = (sections + 1) * (sections + 2) / 2;
+    const int index_count = sections * sections * 3;
+    draw_list->PrimReserve(index_count, vertex_count);
+    const ImDrawIdx base_vertex = (ImDrawIdx)draw_list->_VtxCurrentIdx;
+    const ImVec2 white_pixel = draw_list->_Data->TexUvWhitePixel;
+    for (int hue_index = 0; hue_index <= sections; ++hue_index)
+    {
+        const float hue_weight =
+            (float)hue_index / (float)sections;
+        for (int black_index = 0;
+            black_index <= sections - hue_index;
+            ++black_index)
+        {
+            const float black_weight =
+                (float)black_index / (float)sections;
+            const float white_weight =
+                1.0f - hue_weight - black_weight;
+            const float value = hue_weight + white_weight;
+            const float saturation = value > FLT_EPSILON
+                ? hue_weight / value
+                : 0.0f;
+            const ImVec2 sharp_position =
+                selector.SharpVertices[0] * hue_weight +
+                selector.SharpVertices[1] * black_weight +
+                selector.SharpVertices[2] * white_weight;
+            const ImVec2 rounded_position =
+                MapUvsrSharpPointToRoundedTriangle(
+                    selector,
+                    sharp_position);
+            draw_list->PrimWriteVtx(
+                TransformUvsrRoundedTrianglePoint(
+                    rounded_position,
+                    origin,
+                    cosine,
+                    sine),
+                white_pixel,
+                GetUvsrSvSelectorColor(
+                    hue,
+                    saturation,
+                    value,
+                    alpha));
+        }
+    }
+    const auto row_start =
+        [sections](int hue_index)
+        {
+            return hue_index * (sections + 1) -
+                hue_index * (hue_index - 1) / 2;
+        };
+    for (int hue_index = 0; hue_index < sections; ++hue_index)
+    {
+        for (int black_index = 0;
+            black_index < sections - hue_index;
+            ++black_index)
+        {
+            const ImDrawIdx first = (ImDrawIdx)(
+                base_vertex + row_start(hue_index) + black_index);
+            const ImDrawIdx next_hue = (ImDrawIdx)(
+                base_vertex + row_start(hue_index + 1) + black_index);
+            const ImDrawIdx next_black = (ImDrawIdx)(first + 1);
+            draw_list->PrimWriteIdx(first);
+            draw_list->PrimWriteIdx(next_hue);
+            draw_list->PrimWriteIdx(next_black);
+            if (black_index + 1 < sections - hue_index)
+            {
+                const ImDrawIdx diagonal = (ImDrawIdx)(next_hue + 1);
+                draw_list->PrimWriteIdx(next_hue);
+                draw_list->PrimWriteIdx(diagonal);
+                draw_list->PrimWriteIdx(next_black);
+            }
+        }
+    }
+
+    ImVector<ImVec2> outline;
+    outline.reserve(selector.Contour.Size);
+    for (const ImVec2& point : selector.Contour)
+    {
+        outline.push_back(TransformUvsrRoundedTrianglePoint(
+            point,
+            origin,
+            cosine,
+            sine));
+    }
+    draw_list->AddPolyline(
+        outline.Data,
+        outline.Size,
+        border_color,
+        ImDrawFlags_Closed,
+        1.5f);
+}
