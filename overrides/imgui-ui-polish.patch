+static void AddUvsrRoundedCheckerboard(
+    ImDrawList* draw_list,
+    const ImRect& bounds,
+    float rounding,
+    float alpha)
+{
+    const float width = bounds.GetWidth();
+    const float height = bounds.GetHeight();
+    if (width <= 0.0f || height <= 0.0f)
+        return;
+
+    rounding = ImClamp(rounding, 0.0f, ImMin(width, height) * 0.5f);
+    const int column_count = 2;
+    const int row_count = ImMax(
+        1,
+        (int)ImFloor(height / ImMax(width * 0.5f, 1.0f) + 0.5f));
+    const float fringe = (draw_list->Flags & ImDrawListFlags_AntiAliasedFill)
+        ? ImMax(draw_list->_FringeScale, 0.5f)
+        : 0.0f;
+    const ImVec4 colors[2] = {
+        ImVec4(0.80f, 0.80f, 0.80f, alpha),
+        ImVec4(0.50f, 0.50f, 0.50f, alpha)
+    };
+    const ImVec2 white_pixel = draw_list->_Data->TexUvWhitePixel;
+    for (int row = 0; row < row_count; ++row)
+    {
+        for (int column = 0; column < column_count; ++column)
+        {
+            const float cell_min_x = ImLerp(
+                bounds.Min.x,
+                bounds.Max.x,
+                (float)column / (float)column_count);
+            const float cell_max_x = ImLerp(
+                bounds.Min.x,
+                bounds.Max.x,
+                (float)(column + 1) / (float)column_count);
+            const float cell_min_y = ImLerp(
+                bounds.Min.y,
+                bounds.Max.y,
+                (float)row / (float)row_count);
+            const float cell_max_y = ImLerp(
+                bounds.Min.y,
+                bounds.Max.y,
+                (float)(row + 1) / (float)row_count);
+            const float mesh_min_x = cell_min_x -
+                (column == 0 ? fringe : 0.0f);
+            const float mesh_max_x = cell_max_x +
+                (column + 1 == column_count ? fringe : 0.0f);
+            const float mesh_min_y = cell_min_y -
+                (row == 0 ? fringe : 0.0f);
+            const float mesh_max_y = cell_max_y +
+                (row + 1 == row_count ? fringe : 0.0f);
+            ImVector<float> x_coordinates;
+            ImVector<float> y_coordinates;
+            AddUvsrSortedGradientCoordinate(x_coordinates, mesh_min_x);
+            AddUvsrSortedGradientCoordinate(x_coordinates, mesh_max_x);
+            AddUvsrSortedGradientCoordinate(y_coordinates, mesh_min_y);
+            AddUvsrSortedGradientCoordinate(y_coordinates, mesh_max_y);
+
+            const float maximum_mesh_step = ImMax(fringe, 1.0f);
+            const int x_sections = ImMax(
+                1,
+                (int)ImCeil(
+                    (cell_max_x - cell_min_x) / maximum_mesh_step));
+            const int y_sections = ImMax(
+                1,
+                (int)ImCeil(
+                    (cell_max_y - cell_min_y) / maximum_mesh_step));
+            for (int section = 0; section <= x_sections; ++section)
+            {
+                AddUvsrSortedGradientCoordinate(
+                    x_coordinates,
+                    ImLerp(
+                        cell_min_x,
+                        cell_max_x,
+                        (float)section / (float)x_sections));
+            }
+            for (int section = 0; section <= y_sections; ++section)
+            {
+                AddUvsrSortedGradientCoordinate(
+                    y_coordinates,
+                    ImLerp(
+                        cell_min_y,
+                        cell_max_y,
+                        (float)section / (float)y_sections));
+            }
+            if (fringe > 0.0f)
+            {
+                if (column == 0)
+                {
+                    AddUvsrSortedGradientCoordinate(
+                        x_coordinates,
+                        bounds.Min.x - fringe * 0.5f);
+                    AddUvsrSortedGradientCoordinate(
+                        x_coordinates,
+                        bounds.Min.x + fringe * 0.5f);
+                }
+                if (column + 1 == column_count)
+                {
+                    AddUvsrSortedGradientCoordinate(
+                        x_coordinates,
+                        bounds.Max.x - fringe * 0.5f);
+                    AddUvsrSortedGradientCoordinate(
+                        x_coordinates,
+                        bounds.Max.x + fringe * 0.5f);
+                }
+                if (row == 0)
+                {
+                    AddUvsrSortedGradientCoordinate(
+                        y_coordinates,
+                        bounds.Min.y - fringe * 0.5f);
+                    AddUvsrSortedGradientCoordinate(
+                        y_coordinates,
+                        bounds.Min.y + fringe * 0.5f);
+                }
+                if (row + 1 == row_count)
+                {
+                    AddUvsrSortedGradientCoordinate(
+                        y_coordinates,
+                        bounds.Max.y - fringe * 0.5f);
+                    AddUvsrSortedGradientCoordinate(
+                        y_coordinates,
+                        bounds.Max.y + fringe * 0.5f);
+                }
+            }
+            if (rounding > 0.0f)
+            {
+                const int arc_sections = ImClamp(
+                    draw_list->_CalcCircleAutoSegmentCount(rounding) / 4,
+                    2,
+                    8);
+                for (int section = 0; section <= arc_sections; ++section)
+                {
+                    const float angle =
+                        (float)section / (float)arc_sections * IM_PI * 0.5f;
+                    const float offset = rounding * (1.0f - ImCos(angle));
+                    const float left_x = bounds.Min.x + offset;
+                    const float right_x = bounds.Max.x - offset;
+                    const float top_y = bounds.Min.y + offset;
+                    const float bottom_y = bounds.Max.y - offset;
+                    if (left_x >= mesh_min_x && left_x <= mesh_max_x)
+                        AddUvsrSortedGradientCoordinate(x_coordinates, left_x);
+                    if (right_x >= mesh_min_x && right_x <= mesh_max_x)
+                        AddUvsrSortedGradientCoordinate(x_coordinates, right_x);
+                    if (top_y >= mesh_min_y && top_y <= mesh_max_y)
+                        AddUvsrSortedGradientCoordinate(y_coordinates, top_y);
+                    if (bottom_y >= mesh_min_y && bottom_y <= mesh_max_y)
+                        AddUvsrSortedGradientCoordinate(y_coordinates, bottom_y);
+                }
+            }
+
+            const int vertex_count =
+                x_coordinates.Size * y_coordinates.Size;
+            const int index_count =
+                (x_coordinates.Size - 1) *
+                (y_coordinates.Size - 1) * 6;
+            draw_list->PrimReserve(index_count, vertex_count);
+            const ImDrawIdx base_vertex =
+                (ImDrawIdx)draw_list->_VtxCurrentIdx;
+            for (int y_index = 0; y_index < y_coordinates.Size; ++y_index)
+            {
+                for (int x_index = 0; x_index < x_coordinates.Size; ++x_index)
+                {
+                    const ImVec2 position(
+                        x_coordinates[x_index],
+                        y_coordinates[y_index]);
+                    const float distance = GetUvsrRoundedRectDistance(
+                        bounds,
+                        rounding,
+                        position);
+                    const float coverage = fringe > 0.0f
+                        ? ImSaturate(0.5f - distance / fringe)
+                        : (distance <= 0.0f ? 1.0f : 0.0f);
+                    ImVec4 color = colors[(row + column) & 1];
+                    color.w *= coverage;
+                    draw_list->PrimWriteVtx(
+                        position,
+                        white_pixel,
+                        ImGui::ColorConvertFloat4ToU32(color));
+                }
+            }
+            for (int y_index = 0; y_index + 1 < y_coordinates.Size; ++y_index)
+            {
+                for (int x_index = 0; x_index + 1 < x_coordinates.Size; ++x_index)
+                {
+                    const ImDrawIdx top_left = (ImDrawIdx)(
+                        base_vertex +
+                        y_index * x_coordinates.Size +
+                        x_index);
+                    const ImDrawIdx top_right = (ImDrawIdx)(top_left + 1);
+                    const ImDrawIdx bottom_left = (ImDrawIdx)(
+                        top_left + x_coordinates.Size);
+                    const ImDrawIdx bottom_right =
+                        (ImDrawIdx)(bottom_left + 1);
+                    draw_list->PrimWriteIdx(top_left);
+                    draw_list->PrimWriteIdx(top_right);
+                    draw_list->PrimWriteIdx(bottom_right);
+                    draw_list->PrimWriteIdx(top_left);
+                    draw_list->PrimWriteIdx(bottom_right);
+                    draw_list->PrimWriteIdx(bottom_left);
+                }
+            }
+        }
+    }
+}
