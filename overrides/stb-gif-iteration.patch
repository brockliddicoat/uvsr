+static int stbi__out_gif_code(stbi__gif *g, stbi__uint16 code)
+{
+   int count = 0;
+   int cursor = code;
+
+   // the dictionary bounds this reverse sequence. collect it before writing
+   // pixels so a malformed link cannot publish a partial code expansion.
+   do {
+      if (cursor >= 8192 || count == 8192)
+         return stbi__err("invalid GIF dictionary", "Corrupt GIF");
+      g->prefix_sequence[count++] = g->codes[cursor].suffix;
+      cursor = g->codes[cursor].prefix;
+   } while (cursor >= 0);
+
+   while (count > 0) {
+      stbi_uc *p, *c;
+      int idx;
+      if (g->cur_y >= g->max_y) return 1;
+      idx = g->cur_x + g->cur_y;
+      p = &g->out[idx];
+      g->history[idx / 4] = 1;
+
+      c = &g->color_table[g->prefix_sequence[--count] * 4];
+      if (c[3] > 128) { // don't render transparent pixels;
+         p[0] = c[2];
+         p[1] = c[1];
+         p[2] = c[0];
+         p[3] = c[3];
+      }
+      g->cur_x += 4;
+
+      if (g->cur_x >= g->max_x) {
+         g->cur_x = g->start_x;
+         g->cur_y += g->step;
+
+         while (g->cur_y >= g->max_y && g->parse > 0) {
+            g->step = (1 << g->parse) * g->line_size;
+            g->cur_y = g->start_y + (g->step >> 1);
+            --g->parse;
+         }
+      }
+   }
+   return 1;
 }
 
