UVSR_DENOISING_ENUM(Method, method, DenoisingMethodChoice, DenoisingMethodChoice::Raw, "method", "raw|bilateral|svgf", "raw", DenoisingMethodValues, "Method", "Raw preserves the signal. Bilateral filters one frame. SVGF combines validated history and spatial filtering.")
UVSR_DENOISING_ENUM(Guidance, guidance, BilateralGuidance, BilateralGuidance::DepthAndNormal, "bilateral.guidance", "signal|depth-and-normal", "depth-and-normal", BilateralGuidanceValues, "Guidance", "Signal uses differences in the noisy signal. Depth and Normal uses separate surface guides, also called joint or cross bilateral filtering.")
UVSR_DENOISING_BOOL(Gaussian, gaussian, true, "bilateral.gaussian", "Gaussian Weights", "Weight nearby pixels more strongly with a Gaussian spatial kernel. Off uses equal spatial weights inside the radius.")
UVSR_DENOISING_UINT(Radius, radius, 3u, 1u, 8u, "bilateral.radius", "Radius", "Set the bilateral radius in pixels at the denoising resolution.")
UVSR_DENOISING_FLOAT(RangeSigma, rangeSigma, 0.5f, 0.001f, 10.f, "bilateral.range-sigma", "Signal Sigma", "Set the signal standard deviation in linear units. Values below the noise amplitude preserve noise as well as edges.")
UVSR_DENOISING_ENUM(Resolution, resolution, DenoisingResolution, DenoisingResolution::Full, "resolution", "quarter|half|full", "full", DenoisingResolutionValues, "Resolution", "Set the maximum filter resolution, limited by the sampling resolution. Resolve to the display with surface guidance.")
UVSR_DENOISING_BOOL(Temporal, temporal, true, "temporal.enabled", "Temporal Accumulation", "Reproject previous radiance and moments, rejecting history from a different surface.")
UVSR_DENOISING_UINT(History, historyLength, 32u, 1u, 255u, "temporal.history", "History Length", "Limit the effective history length in frames.")
UVSR_DENOISING_FLOAT(Alpha, alpha, 0.05f, 0.001f, 1.f, "temporal.alpha", "Radiance Alpha", "Set the minimum weight of the current frame. Larger values react faster and retain more noise.")
UVSR_DENOISING_FLOAT(MomentsAlpha, momentsAlpha, 0.2f, 0.001f, 1.f, "temporal.moments-alpha", "Moments Alpha", "Set the minimum current-frame weight for the first and second luminance moments.")
UVSR_DENOISING_FLOAT(Disocclusion, disocclusionThreshold, 0.01f, 0.0001f, 0.1f, "temporal.depth-threshold", "Depth Rejection", "Reject reprojected history when its relative linear-depth error exceeds this threshold.")
UVSR_DENOISING_FLOAT(NormalRejection, normalRejection, 0.9f, 0.f, 1.f, "temporal.normal-threshold", "Normal Rejection", "Require this dot product between current and previous surface normals.")
UVSR_DENOISING_BOOL(Variance, variance, true, "variance.enabled", "Variance Estimation", "Use temporal luminance moments to guide the spatial filter. Off uses a constant variance of one.")
UVSR_DENOISING_BOOL(Prefilter, prefilter, true, "variance.prefilter", "Prefilter Short History", "Estimate radiance and variance spatially while temporal history is too short.")
UVSR_DENOISING_UINT(VarianceHistory, varianceHistory, 4u, 1u, 32u, "variance.minimum-history", "Minimum History", "Use the spatial variance estimate below this number of valid history frames.")
UVSR_DENOISING_UINT(VarianceRadius, varianceRadius, 3u, 1u, 4u, "variance.radius", "Prefilter Radius", "Set the short-history filter radius. Three gives the SVGF 7 by 7 neighborhood.")
UVSR_DENOISING_BOOL(Atrous, atrous, true, "atrous.enabled", "A-Trous Filter", "Apply a wavelet filter with doubling sample spacing at each iteration.")
UVSR_DENOISING_UINT(Iterations, iterations, 5u, 1u, 7u, "atrous.iterations", "Iterations", "Set the number of 5 by 5 filter iterations. Each iteration doubles the spacing.")
UVSR_DENOISING_UINT(Feedback, feedback, 1u, 0u, 7u, "atrous.feedback", "History Feedback", "Save this iteration for the next frame. Zero saves temporal accumulation before spatial filtering. Values above Iterations use the last iteration.")
UVSR_DENOISING_BOOL(VarianceBlur, varianceBlur, true, "atrous.variance-blur", "Blur Variance", "Smooth variance with a local 3 by 3 Gaussian before computing luminance weights.")
UVSR_DENOISING_FLOAT(ColorPhi, colorPhi, 4.f, 0.01f, 32.f, "atrous.color-sigma", "Luminance Sigma", "Scale the standard deviation used to preserve luminance edges.")
UVSR_DENOISING_FLOAT(DepthPhi, depthPhi, 1.f, 0.01f, 16.f, "spatial.depth-sigma", "Depth Sigma", "Set the distance allowed from the receiving surface plane, in pixel footprints. Coplanar slopes remain connected.")
UVSR_DENOISING_FLOAT(NormalPhi, normalPhi, 64.f, 1.f, 256.f, "spatial.normal-power", "Normal Power", "Increase this exponent to preserve sharper normal boundaries.")
UVSR_DENOISING_BOOL(Adaptive, adaptive, false, "adaptive.enabled", "A-SVGF", "Re-evaluate sparse previous samples at the same surface point with the same random seed to estimate lighting changes.")
UVSR_DENOISING_FLOAT(AdaptiveScale, adaptiveScale, 2.f, 0.01f, 16.f, "adaptive.scale", "Gradient Response", "Scale the reconstructed relative temporal gradient before it raises the current-frame weight.")
UVSR_DENOISING_UINT(GradientIterations, gradientIterations, 5u, 0u, 7u, "adaptive.iterations", "Gradient Iterations", "Reconstruct sparse temporal gradients with edge-aware A-Trous filtering before computing adaptive alpha.")
