#define UVSR_DENOISING_ID_INNER(scope, symbol) Denoising##scope##symbol
#define UVSR_DENOISING_ID(scope, symbol) UVSR_DENOISING_ID_INNER(scope, symbol)
#define UVSR_DENOISING_LABELS_Method .Label("svgf", "SVGF")
#define UVSR_DENOISING_ENUM(symbol, member, type, initial, key, tokens, tokenDefault, values, label, help) \
    UVSR_FIELD(UVSR_DENOISING_ID(UVSR_DENOISING_SCOPE, symbol), UVSR_DENOISING_PREFIX key, \
        Value(id, Section::Denoising, EnumerationDomain(tokens), LiteralTokenDefault(tokenDefault)) UVSR_DENOISING_LABELS_##symbol, \
        UIData, Denoising.UVSR_DENOISING_MEMBER.member, values)
#define UVSR_DENOISING_BOOL(symbol, member, initial, key, label, help) \
    UVSR_FIELD(UVSR_DENOISING_ID(UVSR_DENOISING_SCOPE, symbol), UVSR_DENOISING_PREFIX key, \
        Value(id, Section::Denoising, BooleanDomain("on|off"), LiteralBooleanDefault(initial)), UIData, Denoising.UVSR_DENOISING_MEMBER.member)
#define UVSR_DENOISING_UINT(symbol, member, initial, minimum, maximum, key, label, help) \
    UVSR_FIELD(UVSR_DENOISING_ID(UVSR_DENOISING_SCOPE, symbol), UVSR_DENOISING_PREFIX key, \
        Value(id, Section::Denoising, IntegerDomain(minimum, maximum, "integer"), LiteralIntegerDefault(initial)), UIData, Denoising.UVSR_DENOISING_MEMBER.member)
#define UVSR_DENOISING_FLOAT(symbol, member, initial, minimum, maximum, key, label, help) \
    UVSR_FIELD(UVSR_DENOISING_ID(UVSR_DENOISING_SCOPE, symbol), UVSR_DENOISING_PREFIX key, \
        Value(id, Section::Denoising, FloatDomain(minimum, maximum, "float"), LiteralFloatDefault(initial)), UIData, Denoising.UVSR_DENOISING_MEMBER.member)

