#include <windows.h>
1 VERSIONINFO
 FILEVERSION @FIXTURE_VERSION_COMMAS@
 PRODUCTVERSION @FIXTURE_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "UVSR Engine"
   VALUE "FileDescription", "UVSR Engine"
   VALUE "InternalName", "uvsr-engine"
   VALUE "OriginalFilename", "uvsr-engine.exe"
   VALUE "FileVersion", "@FIXTURE_VERSION@"
   VALUE "ProductVersion", "@FIXTURE_VERSION@+@FIXTURE_HASH@"
   VALUE "SettingsNumberHash", "@FIXTURE_HASH@"
   VALUE "SourceCommit", "1111111111111111111111111111111111111111"
   VALUE "SourceIdentity", "1111111111111111111111111111111111111111"
   VALUE "BuildConfiguration", "Release"
   VALUE "ProductionBuild", "true"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
