<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UVSR-Launcher</AssemblyName>
    <RootNamespace>UvsrInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <Version>1.1.14</Version>
    <FileVersion>1.1.14.0</FileVersion>
    <AssemblyVersion>1.1.14.0</AssemblyVersion>
    <Product>UVSR Launcher</Product>
    <Description>Installs, launches, updates, and removes UVSR on Windows 11.</Description>
    <Company>UVSR</Company>
    <Copyright>Copyright (c) 2026 UVSR contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UVSR.Installer.Tests" />
    <EmbeddedResource Include="$(NetCoreRoot)LICENSE.txt"
                      LogicalName="UVSR.Installer.Notices.DotNetLicense.txt" />
    <EmbeddedResource Include="$(NetCoreRoot)ThirdPartyNotices.txt"
                      LogicalName="UVSR.Installer.Notices.DotNetThirdParty.txt" />
    <EmbeddedResource Include="..\..\..\LICENSE.md"
                      LogicalName="UVSR.Installer.Notices.UvsrLicense.md" />
    <EmbeddedResource Include="..\..\..\assets\fonts\noto-sans\NotoSans-Regular.ttf"
                      LogicalName="UVSR.Installer.Fonts.NotoSans.Regular.ttf" />
    <EmbeddedResource Include="..\..\..\assets\fonts\noto-sans\NotoSans-Bold.ttf"
                      LogicalName="UVSR.Installer.Fonts.NotoSans.Bold.ttf" />
    <EmbeddedResource Include="..\..\..\assets\fonts\noto-sans\OFL.txt"
                      LogicalName="UVSR.Installer.Notices.NotoSansOfl.txt" />
    <EmbeddedResource Include="RendererBridges\uvsr-public-main-0c807484.patch"
                      LogicalName="UVSR.Installer.RendererBridges.uvsr-public-main-0c807484.patch" />
  </ItemGroup>
</Project>
