#include <windows.h>
#include "resource_ids.h"

1 RT_MANIFEST "@UVSR_MANIFEST_RESOURCE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @UVSR_LAUNCHER_VERSION_COMMAS@,0
 PRODUCTVERSION @UVSR_LAUNCHER_VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UVSR\0"
            VALUE "FileDescription", "UVSR Launcher\0"
            VALUE "FileVersion", "@UVSR_LAUNCHER_VERSION@.0\0"
            VALUE "InternalName", "uvsr-launcher\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 UVSR contributors\0"
            VALUE "OriginalFilename", "uvsr-launcher.exe\0"
            VALUE "ProductName", "UVSR Launcher\0"
            VALUE "ProductVersion", "@UVSR_LAUNCHER_PRODUCT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDR_UVSR_LICENSE RCDATA "@UVSR_LICENSE_RESOURCE@"
IDR_NOTO_LICENSE RCDATA "@UVSR_NOTO_LICENSE_RESOURCE@"
IDR_MINIZ_LICENSE RCDATA "@UVSR_MINIZ_LICENSE_RESOURCE@"
IDR_NOTO_REGULAR RCDATA "@UVSR_NOTO_REGULAR_RESOURCE@"
IDR_NOTO_BOLD RCDATA "@UVSR_NOTO_BOLD_RESOURCE@"
IDR_SHADER_INVENTORY RCDATA "@UVSR_SHADER_INVENTORY_RESOURCE@"
IDR_MEDIA_INVENTORY RCDATA "@UVSR_MEDIA_INVENTORY_RESOURCE@"
