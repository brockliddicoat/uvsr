#include <windows.h>
1 VERSIONINFO
 FILEVERSION @UVSR_LAUNCHER_FILE_VERSION@
 PRODUCTVERSION @UVSR_LAUNCHER_FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "UVSR"
   VALUE "FileDescription", "Installs, launches, updates, and removes UVSR on Windows 11."
   VALUE "FileVersion", "@UVSR_LAUNCHER_VERSION@.0"
   VALUE "InternalName", "uvsr-launcher"
   VALUE "LegalCopyright", "Copyright (c) 2026 UVSR contributors"
   VALUE "OriginalFilename", "uvsr-launcher.exe"
   VALUE "ProductName", "UVSR Launcher"
   VALUE "ProductVersion", "@UVSR_LAUNCHER_VERSION@+@UVSR_LAUNCHER_SOURCE_IDENTITY@"
   VALUE "SourceCommit", "@UVSR_LAUNCHER_SOURCE_COMMIT@"
   VALUE "SourceIdentity", "@UVSR_LAUNCHER_SOURCE_IDENTITY@"
   VALUE "ReleaseSequence", "@UVSR_LAUNCHER_SEQUENCE@"
   VALUE "ProductionBuild", "@UVSR_LAUNCHER_PRODUCTION_TEXT@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
101 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/../assets/fonts/noto-sans/NotoSans-Regular.ttf"
102 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/../assets/fonts/noto-sans/NotoSans-Bold.ttf"
103 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/../LICENSE.md"
104 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/../assets/fonts/noto-sans/OFL.txt"
105 RCDATA "@zlib_SOURCE_DIR@/LICENSE"
