; theta.tools.untyped_store. Explicit ordinary descriptor control, not a heap.
OpCapability Shader
OpCapability UntypedPointersKHR
OpExtension "SPV_KHR_untyped_pointers"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "computeMain" %output
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %Block Block
OpMemberDecorate %Block 0 Offset 0
OpDecorate %output DescriptorSet 0
OpDecorate %output Binding 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%u32 = OpTypeInt 32 0
%zero = OpConstant %u32 0
%value = OpConstant %u32 42
%Block = OpTypeStruct %u32
%untyped = OpTypeUntypedPointerKHR StorageBuffer
%output = OpUntypedVariableKHR %untyped StorageBuffer %Block
%main = OpFunction %void None %fn
%entry = OpLabel
%pointer = OpUntypedAccessChainKHR %untyped %Block %output %zero
OpStore %pointer %value
OpReturn
OpFunctionEnd
