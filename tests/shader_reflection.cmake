        reflect(agx_tonemapping_ps "UVSR_UNITY_EXPOSURE=${unity} UVSR_USE_LUT=${lut}")
        bindings(f32 "2d[ ]" t_SceneColor=t0)
        bindings("" "" c_ToneMapping=cb0)
        require("SV_Target[ ]+0[ ]+xyzw")
        if(unity)
            reject("t_AutoExposure")
        else()
            bindings(f32 "buf[ ]" t_AutoExposure=t1)
        endif()
        if(lut)
            bindings(f32 "3d[ ]" t_ColorLut=t2)
            bindings("" "" s_LutSampler=s0)
        else()
            reject("t_ColorLut|s_LutSampler")
        endif()
    endforeach()
