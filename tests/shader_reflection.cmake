reflect(path_tracing_cs "")
string(FIND "${dump}" "; Resource Bindings:" start)
string(FIND "${dump}" "target datalayout" end)
if(start LESS 0 OR end LESS_EQUAL start)
    message(FATAL_ERROR "Path tracing has no reflected resource table")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${dump}" ${start} ${length} table)
string(REGEX MATCHALL "(cbuffer|sampler|texture|UAV)[ ]+(NA|i32|f32|struct|byte|u32)" resources "${table}")
list(LENGTH resources resource_count)
if(NOT resource_count EQUAL 14)
    message(FATAL_ERROR "Path tracing must expose exactly 14 resources")
endif()
