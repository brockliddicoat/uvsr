foreach(required UVSR_DXC_EXECUTABLE UVSR_SOURCE_DIRECTORY UVSR_TEST_DIRECTORY
        UVSR_SHADER_CATALOG_DIRECTORY UVSR_GPU_CONTRACT_TEST)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${UVSR_TEST_DIRECTORY}")
file(GLOB catalogs "${UVSR_SHADER_CATALOG_DIRECTORY}/*.txt")
foreach(catalog IN LISTS catalogs)
    file(STRINGS "${catalog}" rows)
    foreach(row IN LISTS rows)
        if(NOT "${row}" MATCHES "^(.*)\t(.+)$")
            message(FATAL_ERROR "Malformed shader catalog ${catalog}")
        endif()
        set(key "${CMAKE_MATCH_1}")
        set(object "${CMAKE_MATCH_2}")
        get_filename_component(name "${object}" NAME)
        string(REGEX REPLACE "\\.[0-9a-f]+\\.dxil$" "" family "${name}")
        string(SHA256 id "${family}|${key}")
        if(DEFINED object_${id})
            message(FATAL_ERROR "Duplicate shader permutation ${family}: ${key}")
        endif()
        set(object_${id} "${object}")
    endforeach()
endforeach()

function(keep_layout name text)
    if("${text}" MATCHES "; Buffer Definitions:")
        set(path "${UVSR_TEST_DIRECTORY}/${name}.dump")
        file(WRITE "${path}" "${text}")
        set_property(GLOBAL APPEND PROPERTY UVSR_ABI_DUMPS "${path}")
    endif()
endfunction()
function(reflect family key)
    string(SHA256 id "${family}|${key}")
    if(NOT DEFINED object_${id})
        message(FATAL_ERROR "Missing required compiled permutation ${family}: ${key}")
    endif()
    execute_process(COMMAND "${UVSR_DXC_EXECUTABLE}" -dumpbin "${object_${id}}"
        OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
    keep_layout("${id}" "${text}")
    set(dump "${text}" PARENT_SCOPE)
    set(label "${family} [${key}]" PARENT_SCOPE)
endfunction()
function(require)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 0 ${last})
        set(pattern "${ARGV${index}}")
        if(NOT "${dump}" MATCHES "${pattern}")
            message(FATAL_ERROR "${label}: missing ${pattern}")
        endif()
    endforeach()
endfunction()
function(reject pattern)
    if("${dump}" MATCHES "${pattern}")
        message(FATAL_ERROR "${label}: unexpected ${pattern}")
    endif()
endfunction()
function(occurrences pattern expected)
    string(REGEX MATCHALL "${pattern}" matches "${dump}")
    list(LENGTH matches count)
    if(NOT count EQUAL expected)
        message(FATAL_ERROR "${label}: ${pattern} occurs ${count}, expected ${expected}")
    endif()
endfunction()
function(bindings type topology)
    foreach(binding IN LISTS ARGN)
        string(REPLACE "=" ";" pair "${binding}")
        list(GET pair 0 name)
        list(GET pair 1 slot)
        require("${name}[^\r\n]*${type}[^\r\n]*${topology}[^\r\n]*${slot}[ ]+1")
    endforeach()
endfunction()
function(members)
    foreach(item IN LISTS ARGN)
        string(REPLACE "=" ";" pair "${item}")
        list(GET pair 0 name)
        list(GET pair 1 offset)
        require("${name}(\\[[0-9]+\\])?;[^\r\n]*Offset:[ ]*${offset}([\r\n]|$)")
    endforeach()
endfunction()
function(size name bytes)
    require("${name};[^\r\n]*Size:[ ]*${bytes}([\r\n]|$)")
endfunction()
function(threads x y z)
    require("NumThreads=\\(${x},${y},${z}\\)")
endfunction()
function(ray_queries samples)
    foreach(operation rayQuery_TraceRayInline rayQuery_CommitNonOpaqueTriangleHit)
        occurrences("call[^\r\n]*@dx\\.op\\.${operation}" ${samples})
    endforeach()
    math(EXPR proceeds "${samples} * 2")
    occurrences("call[^\r\n]*@dx\\.op\\.rayQuery_Proceed" ${proceeds})
    occurrences("call[ \t]+i32[ \t]+@dx\\.op\\.rayQuery_StateScalar\\.i32\\(i32[ \t]+184," ${samples})
    require("RayQuery_CommittedStatus")
endfunction()
function(ray_resources constants samples)
    bindings(cbuffer "" "${constants}=cb0")
    bindings(sampler "" s_RayMaterialSampler=s0)
    bindings(ras "" t_WorldBvh=t0)
    bindings("" "" t_RayMaterialGeometries=t10 t_RayMaterials=t11 t_RayGeometryIndexMap=t12)
    require("t_RayMaterialBuffers[^\r\n]*t0,space1unbounded"
        "t_RayMaterialTextures[^\r\n]*t0,space2unbounded")
    threads(8 8 1)
    ray_queries(${samples})
endfunction()

# Compare actual C++ layouts with the compiled probe and production permutations.
foreach(kind cs ps)
    if(kind STREQUAL "cs")
        set(entry main)
    else()
        set(entry material_main)
    endif()
    set(probe "${UVSR_TEST_DIRECTORY}/gpu-${kind}.dxil")
    execute_process(COMMAND "${UVSR_DXC_EXECUTABLE}" -nologo -T "${kind}_6_5" -E "${entry}"
        -D TARGET_D3D12 -enable-16bit-types -O3 -WX -I "${UVSR_SOURCE_DIRECTORY}/src"
        -Fo "${probe}" "${UVSR_SOURCE_DIRECTORY}/tests/renderer_gpu_contract_probe.hlsl"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${UVSR_DXC_EXECUTABLE}" -dumpbin "${probe}"
        OUTPUT_VARIABLE probe_${kind} COMMAND_ERROR_IS_FATAL ANY)
    keep_layout("gpu-${kind}" "${probe_${kind}}")
endforeach()
