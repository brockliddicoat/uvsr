cmake_minimum_required(VERSION 3.24)
include([==[@CMAKE_CURRENT_SOURCE_DIR@/cmake/VerifyDirectDependencyState.cmake]==])

if (NOT "@UVSR_DIRECT_DEPENDENCY_VERIFICATION_SCOPE@" STREQUAL "inputs")
    message(FATAL_ERROR "Unknown dependency verification scope")
endif()

set(GIT_EXECUTABLE [==[@GIT_EXECUTABLE@]==])
uvsr_verify_dependency_git([==[@UVSR_NVRHI_SOURCE_DIR@]==] [==[@UVSR_NVRHI_EXPECTED_HEAD@]==])
uvsr_verify_dependency_git([==[@UVSR_DIRECTX_HEADERS_SOURCE_DIR@]==] [==[@UVSR_DIRECTX_HEADERS_EXPECTED_HEAD@]==])
uvsr_verify_dependency_git([==[@UVSR_DONUT_SOURCE_DIR@]==] [==[@UVSR_DONUT_EXPECTED_HEAD@]==])

uvsr_verify_dependency_tree([==[@dxc_SOURCE_DIR@]==]
    @UVSR_DXC_FILE_COUNT@ [==[@UVSR_DXC_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@uvsr_cgltf_SOURCE_DIR@]==]
    @UVSR_CGLTF_FILE_COUNT@ [==[@UVSR_CGLTF_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@uvsr_stb_SOURCE_DIR@]==]
    @UVSR_STB_FILE_COUNT@ [==[@UVSR_STB_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@uvsr_jsoncpp_SOURCE_DIR@]==]
    @UVSR_JSONCPP_FILE_COUNT@ [==[@UVSR_JSONCPP_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@uvsr_tinyexr_SOURCE_DIR@]==]
    @UVSR_TRANSITIONAL_TINYEXR_FILE_COUNT@ [==[@UVSR_TRANSITIONAL_TINYEXR_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@uvsr_glfw_SOURCE_DIR@]==]
    @UVSR_TRANSITIONAL_GLFW_FILE_COUNT@ [==[@UVSR_TRANSITIONAL_GLFW_TREE_DIGEST@]==])

uvsr_verify_dependency_records([==[@UVSR_AGILITY_NOTICE_RECORDS@]==] 3)
uvsr_verify_dependency_records([==[@UVSR_NVRHI_DIAGNOSTICS_STAGE_RECORDS@]==] 1)
uvsr_verify_dependency_records([==[@UVSR_TRANSITIONAL_JSONCPP_ALIAS_RECORDS@]==] 1)

uvsr_verify_dependency_tree([==[@UVSR_IMGUI_SOURCE_DIR@]==] 15 [==[@UVSR_IMGUI_SOURCE_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@UVSR_NVRHI_D3D12_OVERRIDE_DIR@]==] 16 [==[@UVSR_NVRHI_STAGE_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@UVSR_IMGUI_OVERRIDE_DIR@]==] 6 [==[@UVSR_IMGUI_STAGE_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@UVSR_DONUT_ENGINE_OVERRIDE_DIR@]==] 8 [==[@UVSR_TRANSITIONAL_DONUT_ENGINE_STAGE_TREE_DIGEST@]==])
uvsr_verify_dependency_tree([==[@UVSR_DONUT_APP_OVERRIDE_DIR@]==] 8 [==[@UVSR_TRANSITIONAL_DONUT_APP_STAGE_TREE_DIGEST@]==])
message(STATUS "Direct dependency input state is exact")
